        "\n",
        "print(\n",
        "    \"✅ Gemini client initialized.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Helpers\n",
        "# ============================================================\n",
        "\n",
        "def sha256_text(text):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        str(text).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def load_schema(schema_file):\n",
        "\n",
        "    with open(\n",
        "        schema_file,\n",
        "        \"r\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        return json.load(f)\n",
        "\n",
        "\n",
        "def schema_validation(\n",
        "    parsed_json,\n",
        "    schema\n",
        "):\n",
        "\n",
        "    if parsed_json is None:\n",
        "\n",
        "        return (\n",
        "            False,\n",
        "            [\"JSON parsing failed\"]\n",
        "        )\n",
        "\n",
        "\n",
        "    validator = (\n",
        "        Draft202012Validator(\n",
        "            schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    errors = sorted(\n",
        "        validator.iter_errors(\n",
        "            parsed_json\n",
        "        ),\n",
        "        key=lambda e: list(\n",
        "            e.absolute_path\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    error_messages = []\n",
        "\n",
        "    for err in errors:\n",
        "\n",
        "        path = (\n",
        "            \"$\"\n",
        "            if not err.absolute_path\n",
        "            else (\n",
        "                \"$.\"\n",
        "                + \".\".join(\n",
        "                    str(x)\n",
        "                    for x\n",
        "                    in err.absolute_path\n",
        "                )\n",
        "            )\n",
        "        )\n",
        "\n",
        "        error_messages.append(\n",
        "            f\"{path}: {err.message}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    return (\n",
        "        len(errors) == 0,\n",
        "        error_messages\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Identify transient API errors\n",
        "#\n",
        "# Only these may be retried.\n",
        "#\n",
        "# We do NOT retry:\n",
        "# - schema-invalid successful responses\n",
        "# - semantically poor responses\n",
        "# - JSON-invalid successful responses\n",
        "# - permanent request/schema errors\n",
        "# ============================================================\n",
        "\n",
        "TRANSIENT_CODES = {\n",
        "    408,\n",
        "    429,\n",
        "    500,\n",
        "    502,\n",
        "    503,\n",
        "    504,\n",
        "}\n",
        "\n",
        "\n",
        "def get_error_code(exc):\n",
        "\n",
        "    for attr in [\n",
        "        \"status_code\",\n",
        "        \"code\",\n",
        "    ]:\n",
        "\n",
        "        value = getattr(\n",
        "            exc,\n",
        "            attr,\n",
        "            None\n",
        "        )\n",
        "\n",
        "        try:\n",
        "\n",
        "            if callable(value):\n",
        "                value = value()\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            if value is not None:\n",
        "                return int(value)\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "    for code in TRANSIENT_CODES:\n",
        "\n",
        "        if str(code) in text:\n",
        "            return code\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def is_transient_error(exc):\n",
        "\n",
        "    code = get_error_code(\n",
        "        exc\n",
        "    )\n",
        "\n",
        "    if code in TRANSIENT_CODES:\n",
        "        return True\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "    transient_terms = [\n",
        "        \"timeout\",\n",
        "        \"timed out\",\n",
        "        \"temporarily unavailable\",\n",
        "        \"connection reset\",\n",
        "        \"connection aborted\",\n",
        "        \"service unavailable\",\n",
        "        \"rate limit\",\n",
        "        \"resource exhausted\",\n",
        "    ]\n",
        "\n",
        "\n",
        "    return any(\n",
        "        term in text\n",
        "        for term in transient_terms\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Existing completed experiment IDs\n",
        "#\n",
        "# Makes the cell safe to rerun after disconnect.\n",
        "# ============================================================\n",
        "\n",
        "existing_results = (\n",
