        "print(\"=\" * 105)\n",
        "\n",
        "display(path_fit_by_condition)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Create experimental-priority score\n",
        "#\n",
        "# NOTE:\n",
        "# This is NOT a clinical-risk score and NOT a scientific\n",
        "# outcome metric.\n",
        "#\n",
        "# It is only a practical ranking to choose fields for the\n",
        "# next controlled Study 2A experiment.\n",
        "#\n",
        "# Higher weight is given to:\n",
        "# - constrained unsupported inference\n",
        "# - constrained status/certainty error\n",
        "# - imperfect schema fit\n",
        "# ------------------------------------------------------------\n",
        "field_risk_rows = []\n",
        "\n",
        "\n",
        "for schema_path in sorted(\n",
        "    final_loc_df[\n",
        "        \"schema_path\"\n",
        "    ].dropna().unique()\n",
        "):\n",
        "\n",
        "    subset = final_loc_df[\n",
        "        final_loc_df[\n",
        "            \"schema_path\"\n",
        "        ]\n",
        "        == schema_path\n",
        "    ]\n",
        "\n",
        "    baseline_total = int(\n",
        "        (\n",
        "            subset[\"condition\"]\n",
        "            == \"baseline\"\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    constrained_total = int(\n",
        "        (\n",
        "            subset[\"condition\"]\n",
        "            == \"schema_constrained\"\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    constrained_unsupported = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"unsupported_inference\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    constrained_status = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"status_certainty_error\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    constrained_partial = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"partial_extraction\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "    schema_fit_issue_errors = int(\n",
        "        subset[\n",
        "            \"path_fit\"\n",
        "        ]\n",
        "        .isin(\n",
        "            [\n",
        "                \"approximate\",\n",
        "                \"composite\",\n",
        "                \"schema_gap\",\n",
        "            ]\n",
        "        )\n",
        "        .sum()\n",
        "    )\n",
        "\n",
        "    total_errors = (\n",
        "        baseline_total\n",
        "        + constrained_total\n",
        "    )\n",
        "\n",
        "\n",
        "    # -----------------------------------------\n",
        "    # Practical experiment-priority score only\n",
        "    # -----------------------------------------\n",
        "    experiment_priority_score = (\n",
        "        total_errors\n",
        "        + (2 * constrained_unsupported)\n",
        "        + (2 * constrained_status)\n",
        "        + constrained_partial\n",
        "        + schema_fit_issue_errors\n",
        "    )\n",
        "\n",
        "\n",
        "    field_risk_rows.append(\n",
        "        {\n",
        "            \"schema_path\":\n",
        "                schema_path,\n",
        "\n",
        "            \"baseline_errors\":\n",
        "                baseline_total,\n",
        "\n",
        "            \"schema_constrained_errors\":\n",
        "                constrained_total,\n",
        "\n",
        "            \"constrained_minus_baseline\":\n",
        "                constrained_total\n",
        "                - baseline_total,\n",
        "\n",
        "            \"total_errors\":\n",
        "                total_errors,\n",
        "\n",
        "            \"constrained_unsupported_inference\":\n",
        "                constrained_unsupported,\n",
        "\n",
        "            \"constrained_status_certainty\":\n",
        "                constrained_status,\n",
        "\n",
        "            \"constrained_partial_extraction\":\n",
        "                constrained_partial,\n",
        "\n",
        "            \"schema_fit_issue_errors\":\n",
        "                schema_fit_issue_errors,\n",
        "\n",
        "            \"experiment_priority_score\":\n",
        "                experiment_priority_score,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "field_risk_df = (\n",
        "    pd.DataFrame(\n",
        "        field_risk_rows\n",
        "    )\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"experiment_priority_score\",\n",
        "            \"schema_constrained_errors\",\n",
        "            \"total_errors\",\n",
        "        ],\n",
        "        ascending=[\n",
        "            False,\n",
        "            False,\n",
        "            False,\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"CONTROLLED-EXPERIMENT FIELD PRIORITIZATION\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(field_risk_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. Top 8 fields\n",
        "# ------------------------------------------------------------\n",
        "TOP_N = 8\n",
        "\n",
        "top_candidate_fields = (\n",
        "    field_risk_df\n",
        "    .head(TOP_N)\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"TOP 8 CANDIDATE FIELDS\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(top_candidate_fields)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. Pull the actual errors for those top fields\n",
        "# ------------------------------------------------------------\n",
        "top_field_names = (\n",
        "    top_candidate_fields[\n",
        "        \"schema_path\"\n",
        "    ].tolist()\n",
        ")\n",
        "\n",
        "top_field_error_examples = (\n",
        "    final_loc_df[\n",
        "        final_loc_df[\n",
        "            \"schema_path\"\n",
        "        ].isin(\n",
        "            top_field_names\n",
        "        )\n",
        "    ][\n",
        "        [\n",
        "            \"error_id\",\n",
        "            \"case_id\",\n",
        "            \"condition\",\n",
        "            \"error_category\",\n",
        "            \"schema_path\",\n",
        "            \"subfield\",\n",
        "            \"path_fit\",\n",
        "            \"study1_error_note\",\n",
        "        ]\n",
        "    ]\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"condition\",\n",
        "            \"error_id\",\n",
        "        ]\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"ERROR EXAMPLES FOR TOP CANDIDATE FIELDS\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(top_field_error_examples)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. Save results immediately\n",
        "# ------------------------------------------------------------\n",
        "FIELD_RISK_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_field_risk_analysis.csv\"\n",
        ")\n",
        "\n",
        "FIELD_CONDITION_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
