        "# 3. Basic generation integrity\n",
        "# ============================================================\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"generation_status\"\n",
        "    ]\n",
        "    .eq(\"completed\")\n",
        "    .all()\n",
        ")\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"json_valid\"\n",
        "    ]\n",
        "    .eq(True)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"scientific_schema_valid\"\n",
        "    ]\n",
        "    .eq(True)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "print(\"✅ 192/192 completed.\")\n",
