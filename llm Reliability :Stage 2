        "        field_condition_counts[col] = 0\n",
        "\n",
        "\n",
        "field_condition_counts[\n",
        "    \"difference_constrained_minus_baseline\"\n",
        "] = (\n",
        "    field_condition_counts[\n",
        "        \"schema_constrained\"\n",
        "    ]\n",
        "    -\n",
        "    field_condition_counts[\n",
        "        \"baseline\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "field_condition_counts[\n",
        "    \"total_errors\"\n",
        "] = (\n",
        "    field_condition_counts[\n",
        "        \"baseline\"\n",
        "    ]\n",
        "    +\n",
        "    field_condition_counts[\n",
        "        \"schema_constrained\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "field_condition_counts = (\n",
        "    field_condition_counts\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"total_errors\",\n",
        "            \"difference_constrained_minus_baseline\",\n",
        "        ],\n",
        "        ascending=[\n",
        "            False,\n",
        "            False,\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"BASELINE VS SCHEMA-CONSTRAINED FIELD ERRORS\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(field_condition_counts)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Category × field table\n",
        "# ------------------------------------------------------------\n",
        "field_category_matrix = (\n",
