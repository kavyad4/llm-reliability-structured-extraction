        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. Summary\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 100)\n",
        "print(\"CELL 7 COMPLETE\")\n",
        "print(\"=\" * 100)\n",
