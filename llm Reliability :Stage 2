        "\n",
        "# ============================================================\n",
        "# 2. Hash helpers\n",
        "# ============================================================\n",
        "\n",
        "def stable_hash_text(text):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        str(text).encode(\"utf-8\")\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def stable_hash_json(obj):\n",
        "\n",
        "    text = json.dumps(\n",
        "        obj,\n",
        "        sort_keys=True,\n",
        "        separators=(\",\", \":\"),\n",
        "        ensure_ascii=False,\n",
        "    )\n",
        "\n",
        "    return stable_hash_text(text)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Reload frozen Study 1 checkpoint\n",
        "# ============================================================\n",
        "\n",
        "CHECKPOINT_PATH = (\n",
        "    STUDY1_DIR\n",
        "    / \"heldout_experiment_checkpoint.json\"\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
        "    CHECKPOINT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    study1_checkpoint = json.load(f)\n",
        "\n",
        "\n",
        "STUDY2A_MODEL = (\n",
        "    study1_checkpoint[\n",
        "        \"heldout_model\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Frozen Study 1 model:\",\n",
        "    STUDY2A_MODEL\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    STUDY2A_MODEL\n",
        "    == \"gemini-3.5-flash\"\n",
        "), (\n",
        "    \"Study 1 checkpoint model changed unexpectedly.\"\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Study 2A will use the same frozen model \"\n",
        "    \"family as Study 1.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Reload Cell 12 frozen experiment\n",
        "# ============================================================\n",
        "\n",
        "FROZEN_EXPERIMENT_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_controlled_experiment_frozen.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "frozen_experiment_df = pd.read_csv(\n",
        "    FROZEN_EXPERIMENT_PATH\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    frozen_experiment_df\n",
        ") == 192\n",
        "\n",
        "\n",
        "assert (\n",
        "    frozen_experiment_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    frozen_experiment_df[\n",
        "        \"scenario_id\"\n",
        "    ].nunique()\n",
