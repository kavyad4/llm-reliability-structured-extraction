        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# Cell 3: Load + verify the 14 fully annotated Study 1 cases\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Source files\n",
        "# ------------------------------------------------------------\n",
        "CHECKPOINT_PATH = STUDY1_DIR / \"heldout_experiment_checkpoint.json\"\n",
        "SEMANTIC_RESULTS_PATH = STUDY1_DIR / \"heldout_semantic_results.json\"\n",
        "CATEGORY_PATH = STUDY1_DIR / \"recovered_semantic_categories_14_cases.csv\"\n",
        "REVIEW_PACKET_PATH = STUDY1_DIR / \"heldout_semantic_review_packet.json\"\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Load Study 1 artifacts READ ONLY\n",
        "# ------------------------------------------------------------\n",
        "with open(CHECKPOINT_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    checkpoint = json.load(f)\n",
        "\n",
        "with open(SEMANTIC_RESULTS_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    semantic_results = json.load(f)\n",
        "\n",
        "category_df = pd.read_csv(CATEGORY_PATH)\n",
        "\n",
        "with open(REVIEW_PACKET_PATH, \"r\", encoding=\"utf-8\") as f:\n",
        "    review_packet = json.load(f)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Define the fully annotated 14-case subset\n",
        "# ------------------------------------------------------------\n",
        "annotated_case_ids = list(semantic_results.keys())\n",
        "\n",
        "print(\"=\" * 90)\n",
        "print(\"STUDY 2A — 14-CASE SOURCE VERIFICATION\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "print(\"\\nCases in semantic results:\", len(annotated_case_ids))\n",
        "\n",
        "for i, case_id in enumerate(annotated_case_ids, start=1):\n",
        "    print(f\"{i:02d}. {case_id}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Verify expected case range D2N093–D2N106\n",
        "# ------------------------------------------------------------\n",
        "expected_numbers = list(range(93, 107))\n",
        "\n",
        "actual_numbers = []\n",
        "\n",
        "for case_id in annotated_case_ids:\n",
        "    try:\n",
        "        n = int(case_id.split(\"-\")[0].replace(\"D2N\", \"\"))\n",
        "        actual_numbers.append(n)\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "print(\"\\nExpected case numbers:\")\n",
        "print(expected_numbers)\n",
        "\n",
        "print(\"\\nRecovered case numbers:\")\n",
        "print(sorted(actual_numbers))\n",
        "\n",
        "assert sorted(actual_numbers) == expected_numbers, (\n",
        "    \"The semantic-results file does not contain exactly \"\n",
        "    \"D2N093 through D2N106.\"\n",
        ")\n",
        "\n",
        "print(\"\\n✅ Exact 14-case range verified.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Generation results from original checkpoint\n",
        "# ------------------------------------------------------------\n",
        "generation_results = checkpoint.get(\n",
        "    \"heldout_generation_results\",\n",
        "    {}\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nGeneration cases in main checkpoint:\",\n",
        "    len(generation_results)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Match semantic cases to generation checkpoint\n",
        "# ------------------------------------------------------------\n",
        "verification_rows = []\n",
        "\n",
        "for case_id in annotated_case_ids:\n",
        "\n",
        "    semantic_record = semantic_results.get(case_id)\n",
        "    generation_record = generation_results.get(case_id)\n",
        "\n",
        "    verification_rows.append(\n",
        "        {\n",
        "            \"case_id\": case_id,\n",
        "            \"semantic_annotation_found\":\n",
        "                semantic_record is not None,\n",
        "\n",
        "            \"generation_record_found\":\n",
        "                generation_record is not None,\n",
        "\n",
        "            \"semantic_record_type\":\n",
        "                type(semantic_record).__name__\n",
        "                if semantic_record is not None\n",
        "                else None,\n",
        "\n",
        "            \"generation_record_type\":\n",
        "                type(generation_record).__name__\n",
        "                if generation_record is not None\n",
        "                else None,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "verification_df = pd.DataFrame(verification_rows)\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 90)\n",
        "print(\"CASE MATCHING\")\n",
        "print(\"=\" * 90)\n",
        "\n",
        "display(verification_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Confirm category CSV contains same 14 cases\n",
        "# ------------------------------------------------------------\n",
        "category_case_ids = sorted(\n",
        "    category_df[\"case_id\"].dropna().unique().tolist()\n",
        ")\n",
        "\n",
        "print(\"\\nUnique cases in category CSV:\", len(category_case_ids))\n",
        "\n",
        "missing_from_category = sorted(\n",
        "    set(annotated_case_ids) -\n",
        "    set(category_case_ids)\n",
        ")\n",
        "\n",
        "extra_in_category = sorted(\n",
        "    set(category_case_ids) -\n",
        "    set(annotated_case_ids)\n",
        ")\n",
        "\n",
        "print(\"Missing from category CSV:\", missing_from_category)\n",
        "print(\"Extra in category CSV:\", extra_in_category)\n",
        "\n",
        "assert len(missing_from_category) == 0\n",
        "assert len(extra_in_category) == 0\n",
        "\n",
