        "#\n",
        "# NO adjudication changes.\n",
        "# NO Gemini calls.\n",
        "# NO frozen-gold changes.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — AUDIT PRIOR SEVERITY HIGH-CONFIDENCE DECISIONS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "INPUT_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_after_status_adjudication.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load current canonical review\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    INPUT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "\n",
        "SEVERITY_FIELD = \"symptoms[].severity\"\n",
        "\n",
        "\n",
        "severity_df = review_df[\n",
        "    review_df[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "    == SEVERITY_FIELD\n",
        "].copy()\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Total severity experiments:\",\n",
        "    len(severity_df)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Isolate prior automated HC-01 / HC-05 decisions\n",
        "# ============================================================\n",
        "\n",
        "audit_df = severity_df[\n",
        "    severity_df[\n",
        "        \"adjudication_rule_id\"\n",
        "    ].isin(\n",
        "        [\n",
        "            \"HC-01\",\n",
        "            \"HC-05\",\n",
        "        ]\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "audit_df = (\n",
        "    audit_df\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"scenario_number\",\n",
        "            \"schema_variant\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Prior severity HC-01/HC-05 decisions:\",\n",
        "    len(audit_df)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Display compact audit table\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"COMPACT AUDIT\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "display(\n",
        "    audit_df[\n",
        "        [\n",
        "            \"experiment_id\",\n",
        "            \"scenario_id\",\n",
        "            \"evidence_strength\",\n",
        "            \"schema_variant\",\n",
        "            \"expected_action\",\n",
        "            \"expected_value_json\",\n",
        "            \"actual_target_value_json\",\n",
        "            \"final_semantic_correct\",\n",
        "            \"final_error_category\",\n",
        "            \"adjudication_rule_id\",\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Print full source context for every audited case\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SOURCE-BY-SOURCE AUDIT\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "for _, row in audit_df.iterrows():\n",
