        "        row[\n",
        "            \"adjudication_status\"\n",
        "        ]\n",
        "        != \"pending_manual_review\"\n",
        "    ):\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    if (\n",
        "        row[\n",
        "            \"schema_variant\"\n",
        "        ]\n",
        "        != \"forced_required\"\n",
        "    ):\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    if (\n",
        "        row[\n",
        "            \"expected_action\"\n",
        "        ]\n",
        "        !=\n",
        "        \"no_semantically_valid_non_null_value\"\n",
