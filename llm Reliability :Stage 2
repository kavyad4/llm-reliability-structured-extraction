      "source": [
        "# ============================================================\n",
        "# STUDY 2A — CELL 26R\n",
        "# Repair over-broad HC-01 follow-up adjudications\n",
        "#\n",
        "# Five prior forced-required follow-up decisions are revisited:\n",
        "#\n",
        "#   EXP100 \"if needed\"      -> semantically correct\n",
        "#   EXP102 \"if necessary\"   -> semantically correct\n",
        "#\n",
        "#   EXP103 \"routine follow up\"\n",
        "#   EXP105 \"annual visit\"\n",
        "#   EXP106 \"regardless of the swelling\"\n",
        "#\n",
        "# remain semantic errors, but are FIELD MIS-MAPPING rather\n",
        "# than unsupported inference:\n",
        "# source text is real, but it was placed into the condition\n",
        "# field even though no conditional trigger exists.\n",
        "#\n",
        "# NO pending cases adjudicated here.\n",
        "# NO Gemini calls.\n",
        "# NO frozen-gold changes.\n",
        "# NO Study 1 changes.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — REPAIRING PRIOR FOLLOW-UP HC-01 DECISIONS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "INPUT_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_after_severity_adjudication.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load current canonical review\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    INPUT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "\n",
        "FOLLOWUP_FIELD = (\n",
        "    \"follow_up.condition\"\n",
        ")\n",
        "\n",
        "\n",
        "initial_pending = int(\n",
        "    (\n",
        "        review_df[\n",
        "            \"adjudication_status\"\n",
        "        ]\n",
        "        == \"pending_manual_review\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "assert initial_pending == 15\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Current pending cases:\",\n",
        "    initial_pending\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Define exact five repairs\n",
        "# ============================================================\n",
        "\n",
        "REPAIRS = {\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Source-faithful vague conditions\n",
        "    #\n",
        "    # These are not specific operational triggers, but the\n",
        "    # free-text output reproduces what the clinician actually\n",
        "    # said. Therefore they are semantically faithful rather\n",
        "    # than unsupported inventions.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP100\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN028\",\n",
        "\n",
        "        \"expected_actual\":\n",
        "            '\"if needed\"',\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"error_category\":\n",
        "            None,\n",
        "\n",
        "        \"note\":\n",
        "            (\n",
        "                \"Repaired after paired follow-up review. \"\n",
        "                \"'If needed' is vague and does not identify \"\n",
        "                \"a specific clinical trigger, but it is \"\n",
        "                \"directly stated in the source. Because the \"\n",
        "                \"simple condition field is free text, \"\n",
        "                \"preserving the source phrase is semantically \"\n",
        "                \"faithful rather than an unsupported inference.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"EXP102\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN030\",\n",
        "\n",
        "        \"expected_actual\":\n",
        "            '\"if necessary\"',\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"error_category\":\n",
        "            None,\n",
        "\n",
        "        \"note\":\n",
        "            (\n",
        "                \"Repaired after paired follow-up review. \"\n",
        "                \"'If necessary' is an underspecified condition \"\n",
        "                \"but is directly supported by the transcript. \"\n",
        "                \"The output preserves source uncertainty rather \"\n",
        "                \"than inventing a more specific trigger.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Source-supported text placed into wrong semantic field\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP103\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN031\",\n",
        "\n",
        "        \"expected_actual\":\n",
        "            '\"routine follow up\"',\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            False,\n",
        "\n",
        "        \"error_category\":\n",
        "            \"field_mis_mapping\",\n",
        "\n",
        "        \"note\":\n",
        "            (\n",
        "                \"Reclassified after paired follow-up review. \"\n",
        "                \"'Routine follow up' is source-supported, so \"\n",
        "                \"this is not an unsupported inference. \"\n",
        "                \"However, it describes the type of follow-up, \"\n",
        "                \"not a conditional trigger, and was therefore \"\n",
        "                \"mis-mapped into follow_up.condition.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"EXP105\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN033\",\n",
        "\n",
        "        \"expected_actual\":\n",
        "            '\"annual visit\"',\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            False,\n",
        "\n",
        "        \"error_category\":\n",
        "            \"field_mis_mapping\",\n",
        "\n",
        "        \"note\":\n",
        "            (\n",
        "                \"Reclassified after paired follow-up review. \"\n",
        "                \"'Annual visit' is source-supported but \"\n",
        "                \"describes routine visit timing/type rather \"\n",
        "                \"than a condition that triggers follow-up. \"\n",
        "                \"Its placement in follow_up.condition is a \"\n",
        "                \"field mis-mapping, not an unsupported fact.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"EXP106\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN034\",\n",
        "\n",
        "        \"expected_actual\":\n",
        "            '\"regardless of the swelling\"',\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            False,\n",
        "\n",
        "        \"error_category\":\n",
        "            \"field_mis_mapping\",\n",
        "\n",
        "        \"note\":\n",
        "            (\n",
        "                \"Reclassified after paired follow-up review. \"\n",
        "                \"The phrase 'regardless of the swelling' is \"\n",
        "                \"supported by the corrected source statement, \"\n",
        "                \"but its meaning is precisely that follow-up \"\n",
        "                \"is unconditional. Encoding it as the \"\n",
        "                \"follow_up.condition therefore mis-maps an \"\n",
        "                \"unconditional modifier into a conditional \"\n",
        "                \"trigger field.\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
