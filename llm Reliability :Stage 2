        "# ============================================================\n",
        "# STUDY 2A — CELL 22\n",
        "# Paired review packet: symptoms[].status\n",
        "#\n",
        "# NO adjudication changes.\n",
        "# NO Gemini calls.\n",
        "# NO frozen-gold changes.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — PAIRED SYMPTOM-STATUS REVIEW\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "INPUT_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_after_medication_adjudication.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load current canonical review\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    INPUT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "\n",
        "STATUS_FIELD = (\n",
        "    \"symptoms[].status\"\n",
        ")\n",
        "\n",
        "\n",
        "status_df = review_df[\n",
        "    review_df[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "    == STATUS_FIELD\n",
        "].copy()\n",
        "\n",
        "\n",
        "pending_status_df = status_df[\n",
        "    status_df[\n",
        "        \"adjudication_status\"\n",
        "    ]\n",
        "    == \"pending_manual_review\"\n",
        "].copy()\n",
        "\n",
        "\n",
        "assert len(\n",
        "    pending_status_df\n",
        ") == 18\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Pending symptom-status cases:\",\n",
        "    len(\n",
        "        pending_status_df\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Identify scenarios with pending status cases\n",
        "# ============================================================\n",
        "\n",
        "pending_scenarios = sorted(\n",
        "    pending_status_df[\n",
        "        \"scenario_id\"\n",
        "    ].unique()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Pending symptom-status scenarios:\",\n",
        "    len(\n",
        "        pending_scenarios\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Pull all four variants for each scenario\n",
        "# ============================================================\n",
        "\n",
        "paired_df = status_df[\n",
        "    status_df[\n",
        "        \"scenario_id\"\n",
        "    ].isin(\n",
        "        pending_scenarios\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "scenario_sizes = (\n",
        "    paired_df\n",
        "    .groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "    .size()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    scenario_sizes\n",
        "    == 4\n",
        ").all()\n",
        "\n",
        "\n",
        "VARIANT_ORDER = {\n",
        "    \"forced_required\": 1,\n",
        "    \"required_nullable\": 2,\n",
        "    \"optional\": 3,\n",
        "    \"semantically_richer\": 4,\n",
        "}\n",
        "\n",
        "\n",
        "paired_df[\n",
        "    \"_variant_order\"\n",
        "] = (\n",
        "    paired_df[\n",
        "        \"schema_variant\"\n",
        "    ].map(\n",
        "        VARIANT_ORDER\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "paired_df = (\n",
        "    paired_df\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"scenario_number\",\n",
        "            \"_variant_order\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Four paired variants recovered \"\n",
        "    \"for every pending status scenario.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Build + print scenario packet\n",
        "# ============================================================\n",
        "\n",
        "packet = []\n",
        "\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\",\n",
        "        sort=False,\n",
        "    )\n",
        "):\n",
        "\n",
        "    group = (\n",
        "        group\n",
        "        .sort_values(\n",
        "            \"_variant_order\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    first = group.iloc[0]\n",
        "\n",
        "\n",
        "    record = {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            scenario_id,\n",
        "\n",
        "        \"scenario_number\":\n",
        "            first[\n",
        "                \"scenario_number\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            first[\n",
        "                \"evidence_strength\"\n",
        "            ],\n",
        "\n",
        "        \"target_entity\":\n",
        "            first[\n",
        "                \"target_entity\"\n",
        "            ],\n",
        "\n",
        "        \"scenario_text\":\n",
        "            first[\n",
        "                \"scenario_text\"\n",
        "            ],\n",
        "\n",
        "        \"gold_reason\":\n",
        "            first[\n",
        "                \"gold_reason\"\n",
        "            ],\n",
        "\n",
        "        \"variants\":\n",
        "            [],\n",
        "    }\n",
        "\n",
        "\n",
        "    for _, row in group.iterrows():\n",
        "\n",
        "        record[\n",
        "            \"variants\"\n",
        "        ].append(\n",
        "            {\n",
        "                \"experiment_id\":\n",
        "                    row[\n",
        "                        \"experiment_id\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_action\":\n",
        "                    row[\n",
        "                        \"expected_action\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_value_json\":\n",
        "                    row[\n",
        "                        \"expected_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"actual_target_value_json\":\n",
        "                    row[\n",
        "                        \"actual_target_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"target_snapshot_json\":\n",
        "                    row[\n",
        "                        \"target_snapshot_json\"\n",
        "                    ],\n",
        "\n",
        "                \"mechanical_outcome\":\n",
        "                    row[\n",
        "                        \"mechanical_outcome\"\n",
        "                    ],\n",
        "\n",
        "                \"adjudication_status\":\n",
        "                    row[\n",
        "                        \"adjudication_status\"\n",
        "                    ],\n",
        "\n",
        "                \"final_semantic_correct\":\n",
        "                    row.get(\n",
        "                        \"final_semantic_correct\"\n",
        "                    ),\n",
        "\n",
        "                \"final_error_category\":\n",
        "                    row.get(\n",
        "                        \"final_error_category\"\n",
        "                    ),\n",
        "\n",
        "                \"final_mechanism\":\n",
        "                    row.get(\n",
        "                        \"final_mechanism\"\n",
        "                    ),\n",
        "            }\n",
        "        )\n",
        "\n",
        "\n",
        "    packet.append(\n",
        "        record\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Print full status review\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SYMPTOM-STATUS REVIEW BATCH\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "for record in packet:\n",
        "\n",
        "    print(\n",
        "        \"\\n\"\n",
        "        + \"#\" * 110\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"SCENARIO:\",\n",
        "        record[\n",
        "            \"scenario_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"EVIDENCE:\",\n",
        "        record[\n",
        "            \"evidence_strength\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"TARGET:\",\n",
        "        record[\n",
        "            \"target_entity\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nSOURCE:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        record[\n",
        "            \"scenario_text\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nFROZEN GOLD REASON:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        record[\n",
        "            \"gold_reason\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nPAIRED VARIANTS:\"\n",
        "    )\n",
        "\n",
        "\n",
        "    for variant in (\n",
        "        record[\n",
        "            \"variants\"\n",
        "        ]\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            \"\\n  ---\",\n",
        "            variant[\n",
        "                \"schema_variant\"\n",
        "            ],\n",
        "            \"---\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Experiment:\",\n",
        "            variant[\n",
        "                \"experiment_id\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Expected action:\",\n",
        "            variant[\n",
        "                \"expected_action\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Expected value:\",\n",
        "            variant[\n",
        "                \"expected_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Actual value:\",\n",
        "            variant[\n",
        "                \"actual_target_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Target snapshot:\",\n",
        "            variant[\n",
        "                \"target_snapshot_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Mechanical outcome:\",\n",
        "            variant[\n",
        "                \"mechanical_outcome\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Current status:\",\n",
        "            variant[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "        if (\n",
        "            variant[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "            != \"pending_manual_review\"\n",
        "        ):\n",
        "\n",
        "            print(\n",
        "                \"  Existing semantic correct:\",\n",
        "                variant[\n",
        "                    \"final_semantic_correct\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"  Existing error category:\",\n",
        "                variant[\n",
        "                    \"final_error_category\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Save packet\n",
        "# ============================================================\n",
        "\n",
        "OUTPUT_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_paired_review_symptom_status_current.json\"\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
        "    OUTPUT_PATH,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        packet,\n",
        "        f,\n",
        "        indent=2,\n",
        "        ensure_ascii=False,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Compact pending breakdown\n",
        "# ============================================================\n",
        "\n",
        "breakdown = (\n",
        "    pending_status_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"evidence_strength\",\n",
        "            \"schema_variant\",\n",
        "            \"mechanical_outcome\",\n",
