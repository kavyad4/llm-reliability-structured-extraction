        "\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"full_prompt\"\n",
        "] = (\n",
        "    generation_manifest_df[\n",
        "        \"scenario_text\"\n",
        "    ].apply(\n",
        "        build_prompt\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"full_prompt_sha256\"\n",
        "] = (\n",
        "    generation_manifest_df[\n",
