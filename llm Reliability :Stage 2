        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# Cell 12: Create + freeze controlled scenarios and gold semantics\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — CONTROLLED SCENARIO + GOLD SEMANTICS FREEZE\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Recovery-safe load of experiment design\n",
        "# ============================================================\n",
        "\n",
        "EXPERIMENT_DESIGN_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_controlled_experiment_design.csv\"\n",
        ")\n",
        "\n",
        "if \"experiment_design_df\" not in globals():\n",
        "\n",
        "    experiment_design_df = pd.read_csv(\n",
        "        EXPERIMENT_DESIGN_PATH\n",
        "    )\n",
        "\n",
        "assert len(experiment_design_df) == 192\n",
        "\n",
        "print(\"✅ 192-slot controlled experiment design loaded.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Helpers\n",
        "# ============================================================\n",
        "\n",
        "def stable_hash_text(text):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        text.encode(\"utf-8\")\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def stable_hash_json(obj):\n",
        "\n",
        "    text = json.dumps(\n",
        "        obj,\n",
        "        sort_keys=True,\n",
        "        separators=(\",\", \":\"),\n",
        "        ensure_ascii=False,\n",
        "    )\n",
        "\n",
        "    return stable_hash_text(text)\n",
        "\n",
        "\n",
        "scenario_records = []\n",
        "\n",
        "\n",
        "def add_scenario(\n",
        "    schema_path,\n",
        "    evidence_strength,\n",
        "    scenario_number,\n",
        "    target_entity,\n",
        "    scenario_text,\n",
        "    evidence_summary,\n",
        "    gold_base_value,\n",
        "    gold_richer_value,\n",
        "    gold_reason,\n",
        "):\n",
        "\n",
        "    scenario_records.append(\n",
        "        {\n",
        "            \"schema_path\":\n",
        "                schema_path,\n",
        "\n",
        "            \"evidence_strength\":\n",
        "                evidence_strength,\n",
        "\n",
        "            \"scenario_number\":\n",
        "                scenario_number,\n",
        "\n",
        "            \"target_entity\":\n",
        "                target_entity,\n",
        "\n",
        "            \"scenario_text\":\n",
        "                scenario_text,\n",
        "\n",
        "            \"evidence_summary\":\n",
        "                evidence_summary,\n",
        "\n",
        "            # Semantic value that the ORIGINAL/FROZEN\n",
        "            # representation should contain IF the evidence\n",
        "            # supports a unique value.\n",
        "            #\n",
        "            # None means:\n",
        "            # no unique semantically justified base value.\n",
        "            \"gold_base_value\":\n",
        "                gold_base_value,\n",
        "\n",
        "            # Expected semantic representation for the richer\n",
        "            # schema variant.\n",
        "            \"gold_richer_value\":\n",
        "                gold_richer_value,\n",
        "\n",
        "            \"gold_reason\":\n",
        "                gold_reason,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. FIELD 1 — medications[].action[]<item>\n",
        "# ============================================================\n",
        "\n",
        "FIELD = \"medications[].action[]<item>\"\n",
        "\n",
        "\n",
        "# -------------------------\n",
        "# EXPLICIT\n",
        "# -------------------------\n",
        "\n",
        "add_scenario(\n",
        "    FIELD,\n",
        "    \"explicit\",\n",
        "    1,\n",
        "    \"ibuprofen\",\n",
        "    (\n",
        "        \"Clinician: Stop ibuprofen starting today.\\n\"\n",
        "        \"Patient: Okay, I will stop it today.\"\n",
        "    ),\n",
        "    \"Clinician explicitly instructs the patient to stop ibuprofen.\",\n",
        "    [\"stop\"],\n",
        "    {\n",
        "        \"actions\": [\"stop\"],\n",
        "        \"evidence_status\": \"explicit_clinician_instruction\",\n",
        "    },\n",
        "    \"The medication action is directly stated by the clinician.\",\n",
        ")\n",
        "\n",
        "add_scenario(\n",
        "    FIELD,\n",
        "    \"explicit\",\n",
        "    2,\n",
        "    \"naproxen\",\n",
        "    (\n",
        "        \"Clinician: Start naproxen 250 mg twice daily \"\n",
        "        \"beginning tomorrow.\\n\"\n",
        "        \"Patient: Understood.\"\n",
