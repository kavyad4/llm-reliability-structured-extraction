        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"CELL 10 COMPLETE\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "print(\n",
        "    \"\\nSelected fields:\"\n",
