      "source": [
        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# CELL 19\n",
        "# High-confidence semantic adjudication pass\n",
        "#\n",
        "# Goal:\n",
        "# Reduce the 107-case manual queue using ONLY\n",
        "# pre-specified, high-confidence semantic rules.\n",
        "#\n",
        "# NO Gemini calls.\n",
        "# NO frozen-gold changes.\n",
        "# NO Study 1 changes.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import re\n",
        "import copy\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — HIGH-CONFIDENCE ADJUDICATION PASS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "DATA_DIR = (\n",
        "    STUDY2A_DIR / \"data\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "\n",
        "FULL_REVIEW_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_pre_adjudication_192.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load canonical Cell-18T evaluation\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    FULL_REVIEW_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    records = json.load(f)\n",
        "\n",
        "\n",
        "review_df = pd.DataFrame(\n",
        "    records\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    review_df\n",
        ") == 192\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "initial_pending = int(\n",
        "    (\n",
        "        review_df[\n",
        "            \"adjudication_status\"\n",
        "        ]\n",
        "        == \"pending_manual_review\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "assert initial_pending == 107\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Initial pending cases:\",\n",
        "    initial_pending\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Canonical 192-case evaluation loaded.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Helpers\n",
        "# ============================================================\n",
        "\n",
        "def parse_jsonish(value):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        (\n",
        "            dict,\n",
        "            list,\n",
        "            int,\n",
        "            float,\n",
        "            bool,\n",
        "        )\n",
        "    ):\n",
        "\n",
        "        return value\n",
        "\n",
        "\n",
        "    text = str(\n",
        "        value\n",
        "    ).strip()\n",
        "\n",
        "\n",
        "    if (\n",
        "        text == \"\"\n",
        "        or text.lower()\n",
        "        == \"null\"\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    try:\n",
        "\n",
        "        return json.loads(\n",
        "            text\n",
        "        )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        return value\n",
        "\n",
        "\n",
        "def normalize_text(value):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "\n",
        "    text = (\n",
        "        str(value)\n",
        "        .strip()\n",
        "        .lower()\n",
        "    )\n",
        "\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"\\s+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "\n",
        "    return text\n",
        "\n",
        "\n",
        "def has_substantive_content(\n",
        "    value\n",
        "):\n",
        "    \"\"\"\n",
        "    True only if the manipulated target contains\n",
        "    actual semantic content.\n",
        "\n",
        "    Examples considered NON-substantive:\n",
        "      None\n",
        "      \"\"\n",
        "      []\n",
        "      {}\n",
        "      dict whose values are all recursively non-substantive\n",
        "    \"\"\"\n",
        "\n",
        "    if value is None:\n",
        "        return False\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        str\n",
        "    ):\n",
        "\n",
        "        return (\n",
        "            value.strip()\n",
        "            != \"\"\n",
        "        )\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        return any(\n",
        "            has_substantive_content(\n",
        "                item\n",
        "            )\n",
        "            for item in value\n",
        "        )\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        dict\n",
        "    ):\n",
        "\n",
        "        return any(\n",
        "            has_substantive_content(\n",
        "                item\n",
        "            )\n",
        "            for item\n",
        "            in value.values()\n",
        "        )\n",
        "\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "def all_dict_values_nullish(\n",
        "    value\n",
        "):\n",
        "\n",
        "    if not isinstance(\n",
        "        value,\n",
        "        dict\n",
        "    ):\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "    if len(value) == 0:\n",
        "        return True\n",
        "\n",
        "\n",
        "    return not has_substantive_content(\n",
        "        value\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Follow-up condition semantic equivalence\n",
        "#\n",
        "# We use a deliberately narrow normalization.\n",
        "#\n",
        "# Accepted examples:\n",
        "#\n",
        "#   \"if fever develops\"\n",
        "#      ↔ \"fever\"\n",
        "#\n",
        "#   \"if the pain worsens\"\n",
        "#      ↔ \"pain worsens\"\n",
        "#\n",
        "# We do NOT use this rule for ambiguous or absent evidence.\n",
        "# ============================================================\n",
        "\n",
        "def normalize_followup_condition(\n",
        "    value\n",
        "):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "\n",
        "    if not isinstance(\n",
        "        value,\n",
        "        str\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    text = (\n",
        "        value\n",
        "        .strip()\n",
        "        .lower()\n",
        "    )\n",
        "\n",
        "\n",
        "    # punctuation\n",
        "    text = re.sub(\n",
        "        r\"[^a-z0-9\\s]\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"\\s+\",\n",
        "        \" \",\n",
        "        text\n",
        "    ).strip()\n",
        "\n",
        "\n",
        "    # Remove conditional prefix\n",
        "    if text.startswith(\n",
        "        \"if \"\n",
        "    ):\n",
        "\n",
        "        text = text[3:]\n",
        "\n",
        "\n",
        "    # Remove leading article\n",
        "    if text.startswith(\n",
        "        \"the \"\n",
        "    ):\n",
        "\n",
        "        text = text[4:]\n",
        "\n",
        "\n",
        "    # Specific semantic simplifications already accepted\n",
        "    # in the smoke-test adjudication.\n",
        "    replacements = {\n",
        "\n",
        "        \"fever develops\":\n",
        "            \"fever\",\n",
        "\n",
        "        \"develop a fever\":\n",
        "            \"fever\",\n",
        "\n",
        "        \"develop fever\":\n",
        "            \"fever\",\n",
        "\n",
        "        \"the pain worsens\":\n",
        "            \"pain worsens\",\n",
        "\n",
        "        \"pain gets worse\":\n",
        "            \"pain worsens\",\n",
        "    }\n",
        "\n",
        "\n",
        "    text = replacements.get(\n",
        "        text,\n",
        "        text\n",
        "    )\n",
        "\n",
        "\n",
        "    return text\n",
        "\n",
        "\n",
        "def followup_equivalent(\n",
        "    expected,\n",
        "    actual,\n",
        "):\n",
        "\n",
        "    expected_norm = (\n",
        "        normalize_followup_condition(\n",
        "            expected\n",
        "        )\n",
        "    )\n",
        "\n",
        "    actual_norm = (\n",
        "        normalize_followup_condition(\n",
        "            actual\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    if (\n",
        "        expected_norm is None\n",
        "        or actual_norm is None\n",
        "    ):\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "    return (\n",
        "        expected_norm\n",
        "        == actual_norm\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Severity semantic equivalence\n",
        "#\n",
        "# Narrowly recognizes:\n",
        "#\n",
        "#   3/10\n",
        "#   3 out of 10\n",
        "#   about 3 out of 10\n",
        "#\n",
        "# and preserves severity descriptors:\n",
        "#\n",
        "#   severe\n",
        "#   moderate\n",
        "#   mild\n",
        "#\n",
        "# It does NOT adjudicate vague terms such as\n",
        "# \"bothersome\", \"variable\", etc.\n",
        "# ============================================================\n",
        "\n",
        "def severity_signature(\n",
        "    value\n",
        "):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "\n",
        "    if not isinstance(\n",
        "        value,\n",
        "        str\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    text = (\n",
        "        value\n",
        "        .lower()\n",
        "        .strip()\n",
        "    )\n",
        "\n",
        "\n",
        "    descriptor = None\n",
        "\n",
        "\n",
        "    for candidate in [\n",
        "        \"mild\",\n",
        "        \"moderate\",\n",
        "        \"severe\",\n",
        "    ]:\n",
        "\n",
        "        if re.search(\n",
        "            rf\"\\b{candidate}\\b\",\n",
        "            text\n",
        "        ):\n",
        "\n",
        "            descriptor = candidate\n",
        "            break\n",
        "\n",
        "\n",
        "    rating = None\n",
        "\n",
        "\n",
        "    # 8/10\n",
        "    match = re.search(\n",
        "        r\"\\b(\\d+(?:\\.\\d+)?)\\s*/\\s*10\\b\",\n",
        "        text\n",
        "    )\n",
        "\n",
        "\n",
        "    if match:\n",
        "\n",
        "        rating = float(\n",
        "            match.group(1)\n",
        "        )\n",
        "\n",
        "\n",
        "    # 8 out of 10\n",
        "    if rating is None:\n",
        "\n",
        "        match = re.search(\n",
        "            r\"\\b(\\d+(?:\\.\\d+)?)\\s+out\\s+of\\s+10\\b\",\n",
        "            text\n",
        "        )\n",
        "\n",
        "\n",
        "        if match:\n",
        "\n",
        "            rating = float(\n",
        "                match.group(1)\n",
        "            )\n",
        "\n",
        "\n",
        "    # Need some real comparable semantic signal\n",
        "    if (\n",
        "        descriptor is None\n",
        "        and rating is None\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    return (\n",
        "        descriptor,\n",
        "        rating,\n",
        "    )\n",
        "\n",
        "\n",
        "def severity_equivalent(\n",
        "    expected,\n",
        "    actual,\n",
        "):\n",
        "\n",
        "    expected_sig = (\n",
        "        severity_signature(\n",
        "            expected\n",
        "        )\n",
        "    )\n",
        "\n",
        "    actual_sig = (\n",
        "        severity_signature(\n",
        "            actual\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    if (\n",
        "        expected_sig is None\n",
        "        or actual_sig is None\n",
        "    ):\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "    expected_descriptor, expected_rating = (\n",
        "        expected_sig\n",
        "    )\n",
        "\n",
        "    actual_descriptor, actual_rating = (\n",
        "        actual_sig\n",
        "    )\n",
        "\n",
        "\n",
        "    # If gold specifies a descriptor,\n",
        "    # actual must preserve it.\n",
        "    if (\n",
        "        expected_descriptor\n",
        "        is not None\n",
        "        and\n",
        "        expected_descriptor\n",
        "        != actual_descriptor\n",
        "    ):\n",
        "\n",
        "        return False\n",
        "\n",
        "\n",
        "    # If gold specifies a numerical rating,\n",
        "    # actual must preserve it.\n",
        "    if (\n",
        "        expected_rating\n",
        "        is not None\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            actual_rating\n",
        "            is None\n",
        "        ):\n",
        "\n",
        "            return False\n",
        "\n",
        "\n",
        "        if abs(\n",
        "            expected_rating\n",
        "            - actual_rating\n",
        "        ) > 1e-9:\n",
        "\n",
        "            return False\n",
        "\n",
        "\n",
        "    return True\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Helper to finalize one row\n",
        "# ============================================================\n",
        "\n",
        "def finalize_case(\n",
        "    index,\n",
