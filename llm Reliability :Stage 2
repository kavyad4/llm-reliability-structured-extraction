        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    INPUT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
