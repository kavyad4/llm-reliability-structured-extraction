        "# ============================================================\n",
        "# 19. SHA-256 helper\n",
        "# ============================================================\n",
        "\n",
        "def sha256_file(path):\n",
        "\n",
        "    hasher = hashlib.sha256()\n",
        "\n",
        "    with open(\n",
        "        path,\n",
        "        \"rb\"\n",
        "    ) as f:\n",
        "\n",
        "        while True:\n",
        "\n",
        "            chunk = f.read(\n",
        "                1024 * 1024\n",
        "            )\n",
        "\n",
        "            if not chunk:\n",
        "                break\n",
        "\n",
        "            hasher.update(\n",
        "                chunk\n",
        "            )\n",
        "\n",
        "    return hasher.hexdigest()\n",
