        "# ============================================================\n",
        "# 12. Save checkpoint helper\n",
        "# ============================================================\n",
        "\n",
        "def save_checkpoint(\n",
        "    checkpoint_obj\n",
        "):\n",
        "\n",
        "    temp_path = (\n",
        "        STUDY2A_CHECKPOINT_DIR\n",
        "        / \"study2a_generation_checkpoint.tmp.json\"\n",
        "    )\n",
        "\n",
        "\n",
        "    with open(\n",
        "        temp_path,\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        json.dump(\n",
        "            checkpoint_obj,\n",
        "            f,\n",
        "            indent=2,\n",
        "            ensure_ascii=False,\n",
        "            default=str,\n",
        "        )\n",
        "\n",
        "\n",
        "    # Replace final checkpoint only after\n",
        "    # temporary file has been successfully written.\n",
        "    os.replace(\n",
        "        temp_path,\n",
        "        GENERATION_CHECKPOINT_PATH\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Run one experiment\n",
        "# ============================================================\n",
        "\n",
        "def run_one_experiment(\n",
        "    row\n",
        "):\n",
        "\n",
        "    experiment_id = (\n",
        "        row[\"experiment_id\"]\n",
        "    )\n",
        "\n",
        "    run_order = int(\n",
        "        row[\"run_order\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    schema_file = (\n",
        "        row[\"schema_file\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    schema = load_schema(\n",
        "        schema_file\n",
        "    )\n",
        "\n",
        "\n",
        "    # Verify schema hash BEFORE calling model\n",
        "    actual_schema_sha256 = (\n",
        "        sha256_text(\n",
        "            json.dumps(\n",
        "                schema,\n",
        "                sort_keys=True,\n",
        "                separators=(\",\", \":\"),\n",
        "                ensure_ascii=False,\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    expected_schema_sha256 = (\n",
        "        row[\"schema_sha256\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        actual_schema_sha256\n",
        "        == expected_schema_sha256\n",
        "    ), (\n",
        "        f\"Schema hash mismatch for \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    prompt = (\n",
        "        row[\"full_prompt\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        sha256_text(\n",
        "            prompt\n",
        "        )\n",
        "        == row[\n",
        "            \"full_prompt_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"Prompt hash mismatch for \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Call Gemini\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    max_attempts = 3\n",
        "\n",
        "    final_exception = None\n",
        "\n",
        "\n",
        "    for attempt in range(\n",
        "        1,\n",
        "        max_attempts + 1\n",
        "    ):\n",
        "\n",
        "        try:\n",
        "\n",
        "            response = (\n",
        "                client.models.generate_content(\n",
        "                    model=STUDY2A_MODEL,\n",
        "\n",
        "                    contents=prompt,\n",
        "\n",
        "                    config=types.GenerateContentConfig(\n",
        "                        temperature=0.0,\n",
        "                        candidate_count=1,\n",
        "                        max_output_tokens=4096,\n",
        "\n",
        "                        response_mime_type=\n",
        "                            \"application/json\",\n",
        "\n",
        "                        response_schema=\n",
        "                            schema,\n",
        "                    ),\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "            raw_text = (\n",
        "                response.text\n",
        "                if response.text is not None\n",
        "                else \"\"\n",
        "            )\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Parse JSON\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            parsed_json = None\n",
        "            json_valid = False\n",
        "            json_error = None\n",
        "\n",
        "\n",
        "            try:\n",
        "\n",
        "                parsed_json = (\n",
        "                    json.loads(\n",
        "                        raw_text\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                json_valid = True\n",
        "\n",
        "            except Exception as exc:\n",
        "\n",
        "                json_error = str(\n",
        "                    exc\n",
        "                )\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Independent schema validation\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            if json_valid:\n",
        "\n",
        "                (\n",
        "                    schema_valid,\n",
        "                    schema_errors,\n",
        "                ) = schema_validation(\n",
        "                    parsed_json,\n",
        "                    schema\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                schema_valid = False\n",
        "\n",
        "                schema_errors = [\n",
        "                    (\n",
        "                        \"JSON parsing failed: \"\n",
        "                        f\"{json_error}\"\n",
        "                    )\n",
        "                ]\n",
        "\n",
        "\n",
        "            result = {\n",
        "\n",
        "                \"run_order\":\n",
        "                    run_order,\n",
        "\n",
        "                \"experiment_id\":\n",
        "                    experiment_id,\n",
        "\n",
        "                \"scenario_id\":\n",
        "                    row[\n",
        "                        \"scenario_id\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_path\":\n",
        "                    row[\n",
        "                        \"schema_path\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"evidence_strength\":\n",
        "                    row[\n",
        "                        \"evidence_strength\"\n",
        "                    ],\n",
        "\n",
        "                \"model\":\n",
        "                    STUDY2A_MODEL,\n",
        "\n",
        "                \"temperature\":\n",
        "                    0.0,\n",
        "\n",
        "                \"google_genai_version\":\n",
        "                    GOOGLE_GENAI_VERSION,\n",
        "\n",
        "                \"attempt_count\":\n",
        "                    attempt,\n",
        "\n",
        "                \"generation_status\":\n",
        "                    \"completed\",\n",
        "\n",
        "                \"scenario_sha256\":\n",
        "                    row[\n",
        "                        \"scenario_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"full_prompt_sha256\":\n",
        "                    row[\n",
        "                        \"full_prompt_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_sha256\":\n",
        "                    expected_schema_sha256,\n",
        "\n",
        "                \"raw_response\":\n",
        "                    raw_text,\n",
        "\n",
        "                \"raw_response_sha256\":\n",
        "                    sha256_text(\n",
        "                        raw_text\n",
        "                    ),\n",
        "\n",
        "                \"json_valid\":\n",
        "                    json_valid,\n",
        "\n",
        "                \"parsed_json\":\n",
        "                    parsed_json,\n",
        "\n",
        "                \"schema_valid\":\n",
        "                    schema_valid,\n",
        "\n",
        "                \"schema_error_count\":\n",
        "                    len(\n",
        "                        schema_errors\n",
        "                    ),\n",
        "\n",
        "                \"schema_errors\":\n",
        "                    schema_errors,\n",
        "\n",
        "                \"generation_error\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "            # IMPORTANT:\n",
        "            # Successful API response is NEVER retried,\n",
        "            # even if JSON/schema/semantics are poor.\n",
        "            return result\n",
        "\n",
        "\n",
        "        except Exception as exc:\n",
        "\n",
        "            final_exception = exc\n",
        "\n",
        "            transient = (\n",
        "                is_transient_error(\n",
        "                    exc\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "            print(\n",
        "                f\"  Attempt {attempt} error: \"\n",
        "                f\"{type(exc).__name__}: {exc}\"\n",
        "            )\n",
        "\n",
        "\n",
        "            # Permanent error: stop immediately\n",
        "            if not transient:\n",
        "\n",
        "                break\n",
        "\n",
        "\n",
        "            # Transient but attempts remain\n",
        "            if attempt < max_attempts:\n",
        "\n",
        "                time.sleep(\n",
        "                    2 ** (attempt - 1)\n",
        "                )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # API failure result\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"run_order\":\n",
        "            run_order,\n",
        "\n",
        "        \"experiment_id\":\n",
        "            experiment_id,\n",
        "\n",
        "        \"scenario_id\":\n",
        "            row[\n",
        "                \"scenario_id\"\n",
        "            ],\n",
        "\n",
        "        \"schema_path\":\n",
        "            row[\n",
        "                \"schema_path\"\n",
        "            ],\n",
        "\n",
        "        \"schema_variant\":\n",
        "            row[\n",
        "                \"schema_variant\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            row[\n",
        "                \"evidence_strength\"\n",
        "            ],\n",
        "\n",
        "        \"model\":\n",
        "            STUDY2A_MODEL,\n",
        "\n",
        "        \"temperature\":\n",
        "            0.0,\n",
        "\n",
        "        \"google_genai_version\":\n",
        "            GOOGLE_GENAI_VERSION,\n",
        "\n",
        "        \"attempt_count\":\n",
        "            attempt,\n",
        "\n",
        "        \"generation_status\":\n",
        "            (\n",
        "                \"transport_failure\"\n",
        "                if is_transient_error(\n",
        "                    final_exception\n",
        "                )\n",
        "                else\n",
        "                \"permanent_api_failure\"\n",
        "            ),\n",
        "\n",
        "        \"scenario_sha256\":\n",
        "            row[\n",
        "                \"scenario_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"full_prompt_sha256\":\n",
        "            row[\n",
        "                \"full_prompt_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"schema_sha256\":\n",
        "            row[\n",
        "                \"schema_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"raw_response\":\n",
        "            None,\n",
        "\n",
        "        \"raw_response_sha256\":\n",
        "            None,\n",
        "\n",
        "        \"json_valid\":\n",
        "            None,\n",
        "\n",
        "        \"parsed_json\":\n",
        "            None,\n",
        "\n",
        "        \"schema_valid\":\n",
        "            None,\n",
        "\n",
        "        \"schema_error_count\":\n",
        "            None,\n",
