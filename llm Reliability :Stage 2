        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"EVIDENCE:\",\n",
        "        row[\n",
        "            \"evidence_strength\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"RULE:\",\n",
