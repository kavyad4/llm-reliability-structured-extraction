        "print(\"=\" * 105)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Recovery-safe loading of frozen Study 1 schema\n",
        "# ============================================================\n",
        "\n",
        "if \"clinical_schema\" not in globals():\n",
        "\n",
        "    CHECKPOINT_PATH = (\n",
        "        STUDY1_DIR\n",
        "        / \"heldout_experiment_checkpoint.json\"\n",
        "    )\n",
        "\n",
        "    with open(\n",
        "        CHECKPOINT_PATH,\n",
        "        \"r\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "        checkpoint = json.load(f)\n",
        "\n",
        "    clinical_schema = checkpoint[\n",
        "        \"clinical_schema_v2\"\n",
        "    ]\n",
        "\n",
        "\n",
        "assert isinstance(\n",
        "    clinical_schema,\n",
        "    dict\n",
        ")\n",
        "\n",
        "# CRITICAL:\n",
        "# Never modify this object.\n",
        "FROZEN_SCHEMA = copy.deepcopy(\n",
        "    clinical_schema\n",
        ")\n",
        "\n",
        "print(\"✅ Frozen Study 1 schema loaded READ ONLY.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Hash helper\n",
        "# ============================================================\n",
        "\n",
        "def canonical_json(obj):\n",
        "    return json.dumps(\n",
        "        obj,\n",
        "        sort_keys=True,\n",
        "        separators=(\",\", \":\"),\n",
        "        ensure_ascii=False,\n",
        "    )\n",
        "\n",
        "\n",
        "def sha256_json(obj):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        canonical_json(obj).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "FROZEN_SCHEMA_SHA256 = sha256_json(\n",
        "    FROZEN_SCHEMA\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Frozen schema SHA256:\",\n",
        "    FROZEN_SCHEMA_SHA256\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Exact locations of our four experimental fields\n",
        "#\n",
        "# parent_getter returns the OBJECT containing the property.\n",
        "# ============================================================\n",
        "\n",
        "def medication_item_parent(schema):\n",
        "\n",
        "    return (\n",
        "        schema[\"properties\"]\n",
        "        [\"medications\"]\n",
        "        [\"items\"]\n",
        "    )\n",
        "\n",
        "\n",
        "def symptom_item_parent(schema):\n",
        "\n",
        "    return (\n",
        "        schema[\"properties\"]\n",
        "        [\"symptoms\"]\n",
        "        [\"items\"]\n",
        "    )\n",
        "\n",
        "\n",
        "def followup_parent(schema):\n",
        "\n",
        "    return (\n",
        "        schema[\"properties\"]\n",
        "        [\"follow_up\"]\n",
        "    )\n",
        "\n",
        "\n",
        "TARGET_SPECS = {\n",
        "\n",
        "    \"medications[].action[]<item>\": {\n",
        "\n",
        "        \"property_name\":\n",
        "            \"action\",\n",
        "\n",
        "        \"parent_getter\":\n",
        "            medication_item_parent,\n",
        "\n",
        "        \"property_json_path\":\n",
        "            \"$.properties.medications.items.\"\n",
        "            \"properties.action\",\n",
        "\n",
        "        \"required_json_path\":\n",
        "            \"$.properties.medications.items.required\",\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].status\": {\n",
        "\n",
        "        \"property_name\":\n",
        "            \"status\",\n",
        "\n",
        "        \"parent_getter\":\n",
        "            symptom_item_parent,\n",
        "\n",
        "        \"property_json_path\":\n",
        "            \"$.properties.symptoms.items.\"\n",
        "            \"properties.status\",\n",
        "\n",
        "        \"required_json_path\":\n",
        "            \"$.properties.symptoms.items.required\",\n",
        "    },\n",
        "\n",
        "\n",
        "    \"follow_up.condition\": {\n",
        "\n",
        "        \"property_name\":\n",
        "            \"condition\",\n",
        "\n",
        "        \"parent_getter\":\n",
        "            followup_parent,\n",
        "\n",
        "        \"property_json_path\":\n",
        "            \"$.properties.follow_up.\"\n",
        "            \"properties.condition\",\n",
        "\n",
        "        \"required_json_path\":\n",
        "            \"$.properties.follow_up.required\",\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].severity\": {\n",
        "\n",
        "        \"property_name\":\n",
        "            \"severity\",\n",
        "\n",
        "        \"parent_getter\":\n",
        "            symptom_item_parent,\n",
        "\n",
        "        \"property_json_path\":\n",
        "            \"$.properties.symptoms.items.\"\n",
        "            \"properties.severity\",\n",
        "\n",
        "        \"required_json_path\":\n",
        "            \"$.properties.symptoms.items.required\",\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "assert set(TARGET_SPECS) == set(\n",
        "    SELECTED_FIELDS\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ All four selected fields mapped \"\n",
        "    \"to their frozen-schema locations.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Required-field helpers\n",
        "# ============================================================\n",
        "\n",
        "def make_required(parent, property_name):\n",
        "\n",
        "    required = list(\n",
        "        parent.get(\n",
        "            \"required\",\n",
        "            []\n",
        "        )\n",
        "    )\n",
        "\n",
        "    if property_name not in required:\n",
        "        required.append(\n",
        "            property_name\n",
        "        )\n",
        "\n",
        "    parent[\"required\"] = required\n",
        "\n",
        "\n",
        "def make_optional(parent, property_name):\n",
        "\n",
        "    required = list(\n",
        "        parent.get(\n",
        "            \"required\",\n",
        "            []\n",
        "        )\n",
        "    )\n",
        "\n",
        "    parent[\"required\"] = [\n",
        "        x\n",
        "        for x in required\n",
        "        if x != property_name\n",
        "    ]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Nullability helpers\n",
        "# ============================================================\n",
        "\n",
        "def remove_null(schema_node):\n",
        "    \"\"\"\n",
        "    Remove null as an allowed value/type.\n",
        "    \"\"\"\n",
        "\n",
        "    node = copy.deepcopy(\n",
        "        schema_node\n",
        "    )\n",
        "\n",
        "    node_type = node.get(\"type\")\n",
        "\n",
        "    if isinstance(node_type, list):\n",
        "\n",
        "        node[\"type\"] = [\n",
        "            t\n",
        "            for t in node_type\n",
        "            if t != \"null\"\n",
        "        ]\n",
        "\n",
        "        if len(node[\"type\"]) == 1:\n",
        "            node[\"type\"] = node[\"type\"][0]\n",
        "\n",
        "    elif node_type == \"null\":\n",
        "\n",
        "        raise ValueError(\n",
        "            \"Cannot make null-only field non-null.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        node.get(\"enum\"),\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        node[\"enum\"] = [\n",
        "            x\n",
        "            for x in node[\"enum\"]\n",
        "            if x is not None\n",
        "        ]\n",
        "\n",
        "\n",
        "    return node\n",
        "\n",
        "\n",
        "def allow_null(schema_node):\n",
        "    \"\"\"\n",
        "    Allow explicit JSON null while preserving\n",
        "    the original non-null representation.\n",
        "    \"\"\"\n",
        "\n",
        "    node = copy.deepcopy(\n",
        "        schema_node\n",
        "    )\n",
        "\n",
        "    node_type = node.get(\"type\")\n",
        "\n",
        "    if isinstance(node_type, str):\n",
        "\n",
        "        if node_type != \"null\":\n",
        "\n",
        "            node[\"type\"] = [\n",
        "                node_type,\n",
        "                \"null\",\n",
        "            ]\n",
        "\n",
        "    elif isinstance(node_type, list):\n",
        "\n",
        "        if \"null\" not in node_type:\n",
        "\n",
        "            node[\"type\"] = (\n",
        "                list(node_type)\n",
        "                + [\"null\"]\n",
        "            )\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        node.get(\"enum\"),\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        if None not in node[\"enum\"]:\n",
        "\n",
        "            node[\"enum\"] = (\n",
        "                list(node[\"enum\"])\n",
        "                + [None]\n",
        "            )\n",
        "\n",
        "\n",
        "    return node\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Semantically richer representations\n",
        "#\n",
        "# IMPORTANT:\n",
        "# These keep the target PROPERTY required,\n",
        "# but permit null when evidence is insufficient.\n",
        "#\n",
        "# This helps isolate:\n",
        "#\n",
        "# schema expressivity\n",
        "#\n",
        "# from:\n",
        "#\n",
        "# field requiredness.\n",
        "# ============================================================\n",
        "\n",
        "def richer_medication_action():\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"type\": [\n",
        "            \"object\",\n",
        "            \"null\",\n",
        "        ],\n",
        "\n",
        "        \"additionalProperties\":\n",
        "            False,\n",
        "\n",
        "        \"required\": [\n",
        "            \"actions\",\n",
        "            \"evidence_status\",\n",
        "        ],\n",
        "\n",
        "        \"properties\": {\n",
        "\n",
        "            \"actions\": {\n",
        "\n",
        "                \"type\":\n",
        "                    \"array\",\n",
        "\n",
        "                \"items\": {\n",
        "\n",
        "                    \"type\":\n",
        "                        \"string\",\n",
        "\n",
        "                    \"enum\": [\n",
        "                        \"start\",\n",
        "                        \"continue\",\n",
        "                        \"increase\",\n",
        "                        \"decrease\",\n",
        "                        \"stop\",\n",
        "                    ],\n",
        "                },\n",
        "            },\n",
        "\n",
        "\n",
        "            \"evidence_status\": {\n",
        "\n",
        "                \"type\":\n",
        "                    \"string\",\n",
        "\n",
        "                \"enum\": [\n",
        "                    \"explicit_clinician_instruction\",\n",
