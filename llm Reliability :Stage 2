        "\n",
        "api_key = None\n",
        "key_source = None\n",
        "\n",
        "\n",
        "for env_name in [\n",
        "    \"GEMINI_API_KEY\",\n",
        "    \"GOOGLE_API_KEY\",\n",
        "]:\n",
        "\n",
        "    value = os.environ.get(\n",
        "        env_name\n",
        "    )\n",
        "\n",
        "    if value:\n",
        "\n",
        "        api_key = value\n",
        "        key_source = (\n",
        "            f\"environment:{env_name}\"\n",
        "        )\n",
        "        break\n",
        "\n",
        "\n",
        "if api_key is None:\n",
        "\n",
        "    try:\n",
        "\n",
        "        from google.colab import userdata\n",
        "\n",
        "        for secret_name in [\n",
        "            \"GEMINI_API_KEY\",\n",
        "            \"GOOGLE_API_KEY\",\n",
        "        ]:\n",
        "\n",
        "            try:\n",
        "\n",
        "                value = userdata.get(\n",
        "                    secret_name\n",
        "                )\n",
        "\n",
        "                if value:\n",
        "\n",
        "                    api_key = value\n",
        "\n",
        "                    key_source = (\n",
        "                        f\"colab_secret:{secret_name}\"\n",
        "                    )\n",
        "\n",
        "                    break\n",
        "\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "\n",
        "if api_key is None:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"No Gemini API key found. \"\n",
        "        \"Add GEMINI_API_KEY to Colab Secrets.\"\n",
        "    )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Credential found:\",\n",
        "    key_source\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Client\n",
        "# ============================================================\n",
        "\n",
        "client = genai.Client(\n",
        "    api_key=api_key\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Gemini client initialized.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Hash helpers\n",
        "# ============================================================\n",
        "\n",
        "def canonical_json(obj):\n",
        "\n",
        "    return json.dumps(\n",
        "        obj,\n",
        "        sort_keys=True,\n",
        "        separators=(\",\", \":\"),\n",
        "        ensure_ascii=False,\n",
        "    )\n",
        "\n",
        "\n",
        "def sha256_text(text):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        str(text).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def sha256_json(obj):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        canonical_json(\n",
        "            obj\n",
        "        ).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Schema loader\n",
        "# ============================================================\n",
        "\n",
        "def load_json_file(path):\n",
        "\n",
        "    with open(\n",
        "        path,\n",
        "        \"r\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        return json.load(f)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Independent SCIENTIFIC-schema validation\n",
        "#\n",
        "# Gemini sees the API-adapted schema.\n",
        "#\n",
        "# We independently evaluate the output against the original\n",
        "# scientific schema.\n",
        "# ============================================================\n",
        "\n",
        "def validate_scientific_schema(\n",
        "    parsed_json,\n",
        "    scientific_schema,\n",
        "):\n",
        "\n",
        "    if parsed_json is None:\n",
        "\n",
        "        return (\n",
        "            False,\n",
        "            [\"JSON parsing failed\"]\n",
        "        )\n",
        "\n",
        "\n",
        "    validator = (\n",
        "        Draft202012Validator(\n",
        "            scientific_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    errors = sorted(\n",
        "        validator.iter_errors(\n",
        "            parsed_json\n",
        "        ),\n",
        "        key=lambda e: list(\n",
        "            e.absolute_path\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    messages = []\n",
        "\n",
        "\n",
        "    for err in errors:\n",
        "\n",
        "        if len(\n",
        "            err.absolute_path\n",
        "        ) == 0:\n",
        "\n",
        "            location = \"$\"\n",
        "\n",
        "        else:\n",
        "\n",
        "            location = (\n",
        "                \"$.\"\n",
        "                + \".\".join(\n",
        "                    str(x)\n",
        "                    for x\n",
        "                    in err.absolute_path\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "        messages.append(\n",
        "            f\"{location}: {err.message}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    return (\n",
        "        len(errors) == 0,\n",
        "        messages,\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Transient failure helper\n",
        "# ============================================================\n",
        "\n",
        "TRANSIENT_CODES = {\n",
        "    408,\n",
        "    429,\n",
        "    500,\n",
        "    502,\n",
        "    503,\n",
        "    504,\n",
        "}\n",
        "\n",
        "\n",
        "def get_error_code(exc):\n",
        "\n",
        "    for attr in [\n",
        "        \"status_code\",\n",
        "        \"code\",\n",
        "    ]:\n",
        "\n",
        "        value = getattr(\n",
        "            exc,\n",
        "            attr,\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            if callable(value):\n",
        "                value = value()\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            if value is not None:\n",
        "                return int(value)\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "\n",
        "    for code in TRANSIENT_CODES:\n",
        "\n",
        "        if str(code) in text:\n",
        "            return code\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def is_transient_error(exc):\n",
        "\n",
        "    if exc is None:\n",
        "        return False\n",
        "\n",
        "\n",
        "    code = get_error_code(\n",
        "        exc\n",
        "    )\n",
        "\n",
        "\n",
        "    if code in TRANSIENT_CODES:\n",
        "        return True\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "\n",
        "    transient_terms = [\n",
        "        \"timeout\",\n",
        "        \"timed out\",\n",
        "        \"temporarily unavailable\",\n",
        "        \"connection reset\",\n",
        "        \"connection aborted\",\n",
        "        \"service unavailable\",\n",
        "        \"rate limit\",\n",
        "        \"resource exhausted\",\n",
        "    ]\n",
        "\n",
        "\n",
        "    return any(\n",
        "        term in text\n",
        "        for term in transient_terms\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Atomic checkpoint save\n",
        "# ============================================================\n",
        "\n",
        "def save_checkpoint(\n",
        "    checkpoint_obj\n",
        "):\n",
        "\n",
        "    temp_path = (\n",
        "        STUDY2A_CHECKPOINT_DIR\n",
        "        / \"study2a_generation_checkpoint_v1_1.tmp.json\"\n",
        "    )\n",
        "\n",
        "\n",
        "    with open(\n",
        "        temp_path,\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        json.dump(\n",
        "            checkpoint_obj,\n",
        "            f,\n",
        "            indent=2,\n",
        "            ensure_ascii=False,\n",
        "            default=str,\n",
        "        )\n",
        "\n",
        "\n",
        "    os.replace(\n",
        "        temp_path,\n",
        "        CHECKPOINT_PATH\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Select ONLY frozen run orders 1–8\n",
        "# ============================================================\n",
        "\n",
        "smoke_df = (\n",
        "    manifest_df[\n",
        "        manifest_df[\n",
        "            \"run_order\"\n",
        "        ].between(\n",
        "            1,\n",
        "            8\n",
        "        )\n",
        "    ]\n",
        "    .sort_values(\n",
        "        \"run_order\"\n",
        "    )\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "assert len(smoke_df) == 8\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"FROZEN RUN ORDERS 1–8\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "display(\n",
        "    smoke_df[\n",
        "        [\n",
        "            \"run_order\",\n",
        "            \"experiment_id\",\n",
        "            \"scenario_id\",\n",
        "            \"schema_path\",\n",
        "            \"schema_variant\",\n",
        "            \"evidence_strength\",\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Existing v1.1 results\n",
        "#\n",
        "# This allows safe rerun after runtime disconnect.\n",
        "# ============================================================\n",
        "\n",
        "existing_results = (\n",
        "    checkpoint.get(\n",
        "        \"results\",\n",
        "        []\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "finished_ids = {\n",
        "\n",
        "    row[\"experiment_id\"]\n",
        "\n",
        "    for row in existing_results\n",
        "\n",
        "    if row.get(\n",
        "        \"generation_status\"\n",
        "    )\n",
        "    in {\n",
        "        \"completed\",\n",
        "        \"permanent_api_failure\",\n",
        "    }\n",
        "}\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nExisting v1.1 results:\",\n",
        "    len(existing_results)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Run ONE experiment\n",
        "# ============================================================\n",
        "\n",
        "def run_one_experiment(\n",
        "    row\n",
        "):\n",
        "\n",
        "    experiment_id = (\n",
        "        row[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    run_order = int(\n",
        "        row[\n",
        "            \"run_order\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Load ORIGINAL scientific schema\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    scientific_schema = (\n",
        "        load_json_file(\n",
        "            row[\n",
        "                \"scientific_schema_file\"\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    actual_scientific_hash = (\n",
        "        sha256_json(\n",
        "            scientific_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        actual_scientific_hash\n",
        "        == row[\n",
        "            \"scientific_schema_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"Scientific schema hash mismatch: \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Load Gemini API-facing schema\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    api_schema = (\n",
        "        load_json_file(\n",
        "            row[\n",
        "                \"api_schema_file\"\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    actual_api_hash = (\n",
        "        sha256_json(\n",
        "            api_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        actual_api_hash\n",
        "        == row[\n",
        "            \"api_schema_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"API schema hash mismatch: \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Verify prompt has not changed\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    prompt = (\n",
        "        row[\n",
        "            \"full_prompt\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        sha256_text(\n",
        "            prompt\n",
        "        )\n",
        "        == row[\n",
        "            \"full_prompt_sha256\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Generate\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    max_attempts = 3\n",
        "\n",
        "    final_exception = None\n",
        "    last_attempt = 0\n",
        "\n",
        "\n",
        "    for attempt in range(\n",
        "        1,\n",
        "        max_attempts + 1\n",
        "    ):\n",
        "\n",
        "        last_attempt = attempt\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            response = (\n",
        "                client.models.generate_content(\n",
        "\n",
        "                    model=MODEL,\n",
        "\n",
        "                    contents=prompt,\n",
        "\n",
        "                    config=types.GenerateContentConfig(\n",
        "\n",
        "                        temperature=0.0,\n",
        "\n",
        "                        candidate_count=1,\n",
        "\n",
        "                        max_output_tokens=4096,\n",
        "\n",
        "                        response_mime_type=\n",
        "                            \"application/json\",\n",
        "\n",
        "                        # ====================================\n",
        "                        # CRITICAL v1.1 FIX\n",
        "                        # ====================================\n",
        "                        response_json_schema=\n",
        "                            api_schema,\n",
        "                    ),\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "            raw_text = (\n",
        "                response.text\n",
        "                if response.text\n",
        "                is not None\n",
        "                else \"\"\n",
        "            )\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # JSON parse\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            parsed_json = None\n",
        "\n",
        "            json_valid = False\n",
        "\n",
        "            json_error = None\n",
        "\n",
        "\n",
        "            try:\n",
        "\n",
        "                parsed_json = (\n",
        "                    json.loads(\n",
        "                        raw_text\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                json_valid = True\n",
        "\n",
        "            except Exception as exc:\n",
        "\n",
        "                json_error = (\n",
        "                    f\"{type(exc).__name__}: \"\n",
        "                    f\"{exc}\"\n",
        "                )\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Scientific-schema validation\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            if json_valid:\n",
        "\n",
        "                (\n",
        "                    scientific_schema_valid,\n",
        "                    scientific_schema_errors,\n",
        "                ) = (\n",
        "                    validate_scientific_schema(\n",
        "                        parsed_json,\n",
        "                        scientific_schema,\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                scientific_schema_valid = False\n",
        "\n",
        "                scientific_schema_errors = [\n",
        "                    json_error\n",
        "                ]\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Successful API response\n",
        "            #\n",
        "            # NEVER retry based on bad semantics,\n",
        "            # bad JSON, or schema invalidity.\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"run_order\":\n",
        "                    run_order,\n",
        "\n",
        "                \"experiment_id\":\n",
        "                    experiment_id,\n",
        "\n",
        "                \"scenario_id\":\n",
        "                    row[\n",
        "                        \"scenario_id\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_path\":\n",
        "                    row[\n",
        "                        \"schema_path\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"evidence_strength\":\n",
        "                    row[\n",
        "                        \"evidence_strength\"\n",
        "                    ],\n",
        "\n",
        "                \"model\":\n",
        "                    MODEL,\n",
        "\n",
        "                \"temperature\":\n",
        "                    0.0,\n",
        "\n",
        "                \"google_genai_version\":\n",
        "                    GOOGLE_GENAI_VERSION,\n",
        "\n",
        "                \"protocol_version\":\n",
        "                    protocol[\n",
        "                        \"protocol_version\"\n",
        "                    ],\n",
        "\n",
        "                \"generation_protocol_sha256\":\n",
        "                    PROTOCOL_SHA256,\n",
        "\n",
        "                \"attempt_count\":\n",
        "                    attempt,\n",
        "\n",
        "                \"generation_status\":\n",
        "                    \"completed\",\n",
        "\n",
        "                \"scenario_sha256\":\n",
        "                    row[\n",
        "                        \"scenario_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"full_prompt_sha256\":\n",
        "                    row[\n",
        "                        \"full_prompt_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"scientific_schema_sha256\":\n",
        "                    row[\n",
        "                        \"scientific_schema_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"api_schema_sha256\":\n",
        "                    row[\n",
        "                        \"api_schema_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_transport\":\n",
        "                    \"response_json_schema\",\n",
        "\n",
        "                \"raw_response\":\n",
        "                    raw_text,\n",
        "\n",
        "                \"raw_response_sha256\":\n",
        "                    sha256_text(\n",
        "                        raw_text\n",
        "                    ),\n",
        "\n",
        "                \"json_valid\":\n",
        "                    json_valid,\n",
        "\n",
        "                \"parsed_json\":\n",
        "                    parsed_json,\n",
        "\n",
        "                \"scientific_schema_valid\":\n",
        "                    scientific_schema_valid,\n",
        "\n",
        "                \"scientific_schema_error_count\":\n",
        "                    len(\n",
        "                        scientific_schema_errors\n",
        "                    ),\n",
        "\n",
        "                \"scientific_schema_errors\":\n",
        "                    scientific_schema_errors,\n",
        "\n",
        "                \"generation_error\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        except Exception as exc:\n",
        "\n",
        "            final_exception = exc\n",
        "\n",
        "\n",
        "            print(\n",
        "                f\"  Attempt {attempt}: \"\n",
        "                f\"{type(exc).__name__}: \"\n",
        "                f\"{exc}\"\n",
        "            )\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Permanent failure:\n",
        "            # do not retry.\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            if not is_transient_error(\n",
        "                exc\n",
        "            ):\n",
        "\n",
        "                break\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Transient failure:\n",
        "            # retry only if attempts remain.\n",
        "            # -----------------------------------------------\n",
        "\n",
        "            if attempt < max_attempts:\n",
        "\n",
        "                time.sleep(\n",
        "                    2 ** (\n",
        "                        attempt - 1\n",
        "                    )\n",
        "                )\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # API failure record\n",
        "    # ========================================================\n",
        "\n",
        "    status = (\n",
        "        \"transport_failure\"\n",
        "        if is_transient_error(\n",
        "            final_exception\n",
        "        )\n",
        "        else\n",
        "        \"permanent_api_failure\"\n",
        "    )\n",
        "\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"run_order\":\n",
        "            run_order,\n",
        "\n",
        "        \"experiment_id\":\n",
        "            experiment_id,\n",
        "\n",
        "        \"scenario_id\":\n",
        "            row[\n",
        "                \"scenario_id\"\n",
        "            ],\n",
        "\n",
        "        \"schema_path\":\n",
        "            row[\n",
        "                \"schema_path\"\n",
        "            ],\n",
        "\n",
        "        \"schema_variant\":\n",
        "            row[\n",
        "                \"schema_variant\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            row[\n",
        "                \"evidence_strength\"\n",
        "            ],\n",
        "\n",
        "        \"model\":\n",
        "            MODEL,\n",
        "\n",
        "        \"temperature\":\n",
