        "# ------------------------------------------------------------\n",
        "STUDY1_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Research\"\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Study 2A gets its own completely separate folder\n",
        "# ------------------------------------------------------------\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "STUDY2A_DATA_DIR = STUDY2A_DIR / \"data\"\n",
        "STUDY2A_CHECKPOINT_DIR = STUDY2A_DIR / \"checkpoints\"\n",
        "STUDY2A_RESULTS_DIR = STUDY2A_DIR / \"results\"\n",
        "STUDY2A_FIGURES_DIR = STUDY2A_DIR / \"figures\"\n",
        "STUDY2A_LOGS_DIR = STUDY2A_DIR / \"logs\"\n",
        "\n",
        "# Create ONLY Study 2A directories\n",
        "for folder in [\n",
        "    STUDY2A_DIR,\n",
        "    STUDY2A_DATA_DIR,\n",
        "    STUDY2A_CHECKPOINT_DIR,\n",
        "    STUDY2A_RESULTS_DIR,\n",
        "    STUDY2A_FIGURES_DIR,\n",
        "    STUDY2A_LOGS_DIR,\n",
        "]:\n",
        "    folder.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Safety check: Study 1 must already exist\n",
        "# ------------------------------------------------------------\n",
        "if not STUDY1_DIR.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Study 1 folder was not found:\\n{STUDY1_DIR}\"\n",
        "    )\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Record Study 1 file metadata.\n",
        "#\n",
        "# This is useful later for confirming that Study 2A did not\n",
        "# accidentally overwrite Study 1 files.\n",
        "# ------------------------------------------------------------\n",
        "study1_snapshot = []\n",
