        "\n",
        "\n",
        "print(\n",
        "    \"✅ Frozen 192-slot experiment loaded.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Reload frozen-input manifest from Cell 12\n",
        "# ============================================================\n",
        "\n",
        "INPUT_MANIFEST_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_controlled_input_manifest.json\"\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
