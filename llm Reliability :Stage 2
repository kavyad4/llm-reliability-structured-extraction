        "        \"adjudication_rule_id\"\n",
        "    ] = None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. RULE HC-01\n",
        "#\n",
        "# Forced-required schema + frozen gold says:\n",
        "#\n",
        "#   no semantically valid non-null value\n",
        "#\n",
        "# but model produced substantive content.\n",
        "#\n",
        "# This is the cleanest controlled test of\n",
        "# schema commitment pressure.\n",
        "# ============================================================\n",
        "\n",
        "hc01_count = 0\n",
        "\n",
        "\n",
        "for index, row in (\n",
        "    review_df.iterrows()\n",
        "):\n",
        "\n",
