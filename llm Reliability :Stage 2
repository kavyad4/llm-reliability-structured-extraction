        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# Cell 6: Flatten frozen clinical schema into field catalog\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 95)\n",
        "print(\"STUDY 2A — FROZEN SCHEMA FIELD CATALOG\")\n",
        "print(\"=\" * 95)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Load frozen schema from Study 1 checkpoint\n",
        "# ------------------------------------------------------------\n",
        "clinical_schema = checkpoint.get(\n",
        "    \"clinical_schema_v2\"\n",
        ")\n",
        "\n",
        "if not isinstance(clinical_schema, dict):\n",
        "    raise ValueError(\n",
        "        \"clinical_schema_v2 was not found in the Study 1 checkpoint.\"\n",
        "    )\n",
        "\n",
        "print(\"\\n✅ Frozen Study 1 schema loaded.\")\n",
        "print(\n",
        "    \"Top-level schema keys:\",\n",
        "    list(clinical_schema.keys())\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Recursive schema flattener\n",
        "#\n",
        "# Output examples:\n",
        "#\n",
        "# patient.age\n",
        "# patient.sex\n",
        "#\n",
        "# symptoms[]\n",
        "# symptoms[].name\n",
        "# symptoms[].status\n",
        "# symptoms[].body_site\n",
        "# symptoms[].severity\n",
        "# symptoms[].duration\n",
        "#\n",
        "# medications[].name\n",
        "# medications[].status\n",
        "# medications[].action[]\n",
        "#\n",
        "# follow_up.value\n",
        "# follow_up.unit\n",
        "# follow_up.condition\n",
        "# ------------------------------------------------------------\n",
        "schema_rows = []\n",
        "\n",
        "\n",
        "def add_schema_row(\n",
        "    path,\n",
        "    schema_node,\n",
        "    required,\n",
        "    parent_path,\n",
        "    node_kind\n",
        "):\n",
        "\n",
        "    if not path:\n",
        "        return\n",
        "\n",
        "    schema_type = schema_node.get(\"type\")\n",
        "\n",
        "    enum_values = schema_node.get(\"enum\")\n",
        "\n",
        "    description = schema_node.get(\n",
        "        \"description\"\n",
        "    )\n",
        "\n",
        "    nullable = False\n",
        "\n",
        "    if isinstance(schema_type, list):\n",
        "        nullable = \"null\" in schema_type\n",
        "\n",
        "    if schema_node.get(\"nullable\") is True:\n",
        "        nullable = True\n",
        "\n",
        "    schema_rows.append(\n",
        "        {\n",
        "            \"schema_path\": path,\n",
        "            \"parent_path\": parent_path,\n",
        "            \"node_kind\": node_kind,\n",
        "            \"schema_type\": (\n",
        "                json.dumps(schema_type)\n",
        "                if isinstance(schema_type, list)\n",
        "                else schema_type\n",
        "            ),\n",
        "            \"required\": bool(required),\n",
        "            \"nullable\": bool(nullable),\n",
        "            \"enum_values\": (\n",
        "                json.dumps(\n",
        "                    enum_values,\n",
        "                    ensure_ascii=False\n",
        "                )\n",
        "                if enum_values is not None\n",
        "                else None\n",
        "            ),\n",
        "            \"description\": description,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "def flatten_schema(\n",
        "    schema_node,\n",
        "    path=\"\",\n",
        "    required=False,\n",
        "    parent_path=None,\n",
        "):\n",
        "    \"\"\"\n",
        "    Recursively flatten JSON Schema into canonical paths.\n",
        "    \"\"\"\n",
        "\n",
        "    if not isinstance(schema_node, dict):\n",
        "        return\n",
        "\n",
        "    schema_type = schema_node.get(\"type\")\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # OBJECT\n",
        "    # --------------------------------------------------------\n",
        "    if (\n",
        "        schema_type == \"object\"\n",
        "        or \"properties\" in schema_node\n",
        "    ):\n",
        "\n",
        "        if path:\n",
        "            add_schema_row(\n",
        "                path=path,\n",
        "                schema_node=schema_node,\n",
        "                required=required,\n",
        "                parent_path=parent_path,\n",
        "                node_kind=\"object\",\n",
        "            )\n",
        "\n",
        "        required_children = set(\n",
        "            schema_node.get(\n",
        "                \"required\",\n",
        "                []\n",
        "            )\n",
        "        )\n",
        "\n",
        "        properties = schema_node.get(\n",
        "            \"properties\",\n",
        "            {}\n",
        "        )\n",
        "\n",
        "        for child_name, child_schema in properties.items():\n",
        "\n",
        "            child_path = (\n",
        "                f\"{path}.{child_name}\"\n",
        "                if path\n",
        "                else child_name\n",
        "            )\n",
        "\n",
        "            flatten_schema(\n",
        "                child_schema,\n",
        "                path=child_path,\n",
        "                required=(\n",
        "                    child_name\n",
        "                    in required_children\n",
        "                ),\n",
        "                parent_path=path or \"<root>\",\n",
        "            )\n",
        "\n",
        "        return\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # ARRAY\n",
        "    # --------------------------------------------------------\n",
        "    if (\n",
        "        schema_type == \"array\"\n",
        "        or \"items\" in schema_node\n",
        "    ):\n",
        "\n",
        "        array_path = f\"{path}[]\"\n",
        "\n",
        "        add_schema_row(\n",
        "            path=array_path,\n",
        "            schema_node=schema_node,\n",
        "            required=required,\n",
        "            parent_path=parent_path,\n",
        "            node_kind=\"array\",\n",
        "        )\n",
        "\n",
        "        item_schema = schema_node.get(\n",
        "            \"items\",\n",
        "            {}\n",
        "        )\n",
        "\n",
        "        if isinstance(item_schema, dict):\n",
        "\n",
        "            item_type = item_schema.get(\n",
        "                \"type\"\n",
        "            )\n",
        "\n",
        "            # Array of objects\n",
        "            if (\n",
        "                item_type == \"object\"\n",
        "                or \"properties\" in item_schema\n",
        "            ):\n",
        "\n",
        "                required_children = set(\n",
        "                    item_schema.get(\n",
        "                        \"required\",\n",
        "                        []\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                properties = item_schema.get(\n",
        "                    \"properties\",\n",
        "                    {}\n",
        "                )\n",
        "\n",
        "                for child_name, child_schema in properties.items():\n",
        "\n",
        "                    child_path = (\n",
        "                        f\"{array_path}.{child_name}\"\n",
        "                    )\n",
        "\n",
        "                    flatten_schema(\n",
        "                        child_schema,\n",
        "                        path=child_path,\n",
        "                        required=(\n",
        "                            child_name\n",
        "                            in required_children\n",
        "                        ),\n",
        "                        parent_path=array_path,\n",
        "                    )\n",
        "\n",
        "            # Array of primitive values\n",
        "            else:\n",
        "\n",
        "                item_path = (\n",
        "                    f\"{array_path}<item>\"\n",
        "                )\n",
        "\n",
        "                add_schema_row(\n",
        "                    path=item_path,\n",
        "                    schema_node=item_schema,\n",
        "                    required=True,\n",
        "                    parent_path=array_path,\n",
        "                    node_kind=\"array_item\",\n",
        "                )\n",
        "\n",
        "        return\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # PRIMITIVE FIELD\n",
        "    # --------------------------------------------------------\n",
        "    add_schema_row(\n",
        "        path=path,\n",
        "        schema_node=schema_node,\n",
        "        required=required,\n",
        "        parent_path=parent_path,\n",
        "        node_kind=\"field\",\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Flatten complete schema\n",
        "# ------------------------------------------------------------\n",
        "flatten_schema(\n",
        "    clinical_schema\n",
        ")\n",
        "\n",
        "schema_catalog_df = pd.DataFrame(\n",
        "    schema_rows\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Remove accidental duplicates\n",
        "# ------------------------------------------------------------\n",
        "schema_catalog_df = (\n",
        "    schema_catalog_df\n",
        "    .drop_duplicates(\n",
        "        subset=[\"schema_path\"]\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Add convenience columns\n",
        "# ------------------------------------------------------------\n",
        "def get_top_level(path):\n",
        "    if not isinstance(path, str):\n",
        "        return None\n",
        "\n",
        "    return (\n",
        "        path\n",
        "        .replace(\"[]\", \"\")\n",
        "        .split(\".\")[0]\n",
        "    )\n",
        "\n",
        "\n",
        "def get_field_name(path):\n",
        "    if not isinstance(path, str):\n",
        "        return None\n",
        "\n",
        "    cleaned = (\n",
        "        path\n",
        "        .replace(\"[]<item>\", \"\")\n",
        "        .replace(\"[]\", \"\")\n",
        "    )\n",
        "\n",
        "    return cleaned.split(\".\")[-1]\n",
        "\n",
        "\n",
        "schema_catalog_df.insert(\n",
        "    0,\n",
        "    \"top_level_section\",\n",
        "    schema_catalog_df[\n",
        "        \"schema_path\"\n",
        "    ].apply(get_top_level)\n",
        ")\n",
        "\n",
        "schema_catalog_df.insert(\n",
        "    1,\n",
        "    \"field_name\",\n",
        "    schema_catalog_df[\n",
        "        \"schema_path\"\n",
        "    ].apply(get_field_name)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Sort cleanly\n",
        "# ------------------------------------------------------------\n",
        "schema_catalog_df = (\n",
        "    schema_catalog_df\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"top_level_section\",\n",
        "            \"schema_path\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Display catalog\n",
        "# ------------------------------------------------------------\n",
        "print(\n",
        "    \"\\nTotal canonical schema paths:\",\n",
        "    len(schema_catalog_df)\n",
        ")\n",
        "\n",
        "print(\"\\n\")\n",
        "display(schema_catalog_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Print compact path list\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 95)\n",
        "print(\"CANONICAL FIELD PATHS\")\n",
        "print(\"=\" * 95)\n",
        "\n",
        "for path in schema_catalog_df[\n",
        "    \"schema_path\"\n",
        "]:\n",
        "    print(\"•\", path)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Save to Study 2A only\n",
        "# ------------------------------------------------------------\n",
        "SCHEMA_CATALOG_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_frozen_schema_field_catalog.csv\"\n",
        ")\n",
        "\n",
        "schema_catalog_df.to_csv(\n",
        "    SCHEMA_CATALOG_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "SCHEMA_CATALOG_JSON_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_frozen_schema_field_catalog.json\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    SCHEMA_CATALOG_JSON_PATH,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        schema_catalog_df\n",
        "        .where(\n",
        "            pd.notnull(\n",
        "                schema_catalog_df\n",
        "            ),\n",
        "            None\n",
