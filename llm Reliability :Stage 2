        "source_lookup = {}\n",
        "\n",
        "for row in review_packet:\n",
        "\n",
        "    if not isinstance(row, dict):\n",
        "        continue\n",
        "\n",
        "    case_id = row.get(\"case_id\")\n",
        "\n",
        "    if not case_id:\n",
        "        continue\n",
        "\n",
        "    source_lookup[case_id] = {\n",
        "        \"transcript\":\n",
        "            row.get(\"transcript\"),\n",
        "\n",
        "        \"reference_note\":\n",
        "            row.get(\"reference_note\"),\n",
        "    }\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Build one row PER semantic error\n",
        "# ------------------------------------------------------------\n",
        "localization_rows = []\n",
        "\n",
        "global_error_number = 0\n",
        "\n",
        "for case_id in annotated_case_ids:\n",
        "\n",
        "    semantic_record = semantic_results[\n",
        "        case_id\n",
        "    ]\n",
        "\n",
        "    for condition in [\n",
        "        \"baseline\",\n",
        "        \"schema_constrained\",\n",
        "    ]:\n",
        "\n",
        "        notes = extract_error_notes(\n",
        "            semantic_record,\n",
        "            condition\n",
        "        )\n",
        "\n",
        "        expected_total = get_expected_error_total(\n",
        "            semantic_record,\n",
        "            condition\n",
        "        )\n",
        "\n",
        "        # Safety:\n",
        "        # We expect exactly one annotation note per error.\n",
        "        if len(notes) != expected_total:\n",
        "\n",
        "            print(\n",
        "                f\"⚠️ NOTE COUNT MISMATCH: \"\n",
        "                f\"{case_id} / {condition}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"   semantic total:\",\n",
        "                expected_total\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"   annotation notes:\",\n",
        "                len(notes)\n",
        "            )\n",
        "\n",
        "        model_output = get_generation_output(\n",
        "            case_id,\n",
        "            condition\n",
        "        )\n",
        "\n",
        "        model_hash = get_generation_hash(\n",
        "            case_id,\n",
        "            condition\n",
        "        )\n",
        "\n",
        "        recovered_source = source_lookup.get(\n",
        "            case_id,\n",
        "            {}\n",
        "        )\n",
        "\n",
        "        transcript = recovered_source.get(\n",
        "            \"transcript\"\n",
        "        )\n",
        "\n",
        "        reference_note = recovered_source.get(\n",
        "            \"reference_note\"\n",
        "        )\n",
        "\n",
        "        for within_condition_index, note in enumerate(\n",
        "            notes,\n",
        "            start=1\n",
        "        ):\n",
        "\n",
        "            global_error_number += 1\n",
        "\n",
        "            error_id = (\n",
        "                f\"E{global_error_number:03d}\"\n",
        "            )\n",
        "\n",
        "            localization_rows.append(\n",
        "                {\n",
        "                    # -------------------------------------\n",
        "                    # Identity\n",
        "                    # -------------------------------------\n",
        "                    \"error_id\":\n",
        "                        error_id,\n",
        "\n",
        "                    \"case_id\":\n",
        "                        case_id,\n",
        "\n",
        "                    \"condition\":\n",
        "                        condition,\n",
        "\n",
        "                    \"error_index_within_condition\":\n",
        "                        within_condition_index,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # ORIGINAL Study 1 annotation\n",
        "                    # -------------------------------------\n",
        "                    \"study1_error_note\":\n",
        "                        note,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Study 2A localization fields\n",
        "                    #\n",
        "                    # Intentionally blank until adjudicated.\n",
        "                    # -------------------------------------\n",
        "                    \"error_category\":\n",
        "                        None,\n",
        "\n",
        "                    \"schema_path\":\n",
        "                        None,\n",
        "\n",
        "                    \"field\":\n",
        "                        None,\n",
        "\n",
        "                    \"subfield\":\n",
        "                        None,\n",
        "\n",
        "                    \"entity_or_concept\":\n",
        "                        None,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Evidence localization\n",
        "                    # -------------------------------------\n",
        "                    \"evidence_strength\":\n",
        "                        None,\n",
        "\n",
        "                    \"transcript_evidence\":\n",
        "                        None,\n",
        "\n",
        "                    \"evidence_location_notes\":\n",
        "                        None,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Actual model behavior\n",
        "                    # -------------------------------------\n",
        "                    \"model_output_fragment\":\n",
        "                        None,\n",
        "\n",
        "                    # Keep complete original output so we\n",
        "                    # can inspect it without changing Study 1\n",
        "                    \"full_model_output\":\n",
        "                        json.dumps(\n",
        "                            model_output,\n",
        "                            ensure_ascii=False,\n",
        "                            sort_keys=True,\n",
        "                            default=str,\n",
        "                        )\n",
        "                        if model_output is not None\n",
        "                        else None,\n",
        "\n",
        "                    \"output_sha256\":\n",
        "                        model_hash,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Mechanism analysis\n",
        "                    # -------------------------------------\n",
        "                    \"suspected_mechanism\":\n",
        "                        None,\n",
        "\n",
        "                    \"mechanism_rationale\":\n",
        "                        None,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Mechanism vocabulary\n",
        "                    # We will later restrict mechanism to:\n",
        "                    #\n",
        "                    # schema_commitment_pressure\n",
        "                    # insufficient_schema_expressivity\n",
        "                    # weak_or_ambiguous_source_evidence\n",
        "                    # ordinary_extraction_failure\n",
        "                    # -------------------------------------\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Source availability\n",
        "                    # -------------------------------------\n",
        "                    \"full_transcript_available\":\n",
        "                        bool(transcript),\n",
        "\n",
        "                    \"full_reference_note_available\":\n",
        "                        bool(reference_note),\n",
        "\n",
        "                    \"recovered_transcript\":\n",
        "                        transcript,\n",
        "\n",
        "                    \"recovered_reference_note\":\n",
        "                        reference_note,\n",
        "\n",
        "                    # -------------------------------------\n",
        "                    # Adjudication control\n",
        "                    # -------------------------------------\n",
        "                    \"localization_status\":\n",
        "                        \"pending\",\n",
        "\n",
        "                    \"reviewer_notes\":\n",
        "                        None,\n",
        "                }\n",
        "            )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Create dataframe\n",
        "# ------------------------------------------------------------\n",
        "localization_df = pd.DataFrame(\n",
        "    localization_rows\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Validate total number of semantic errors\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\nRows created:\", len(localization_df))\n",
        "\n",
        "baseline_rows = int(\n",
        "    (\n",
        "        localization_df[\"condition\"]\n",
        "        == \"baseline\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "constrained_rows = int(\n",
        "    (\n",
        "        localization_df[\"condition\"]\n",
        "        == \"schema_constrained\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "print(\"Baseline rows:\", baseline_rows)\n",
        "print(\n",
        "    \"Schema-constrained rows:\",\n",
        "    constrained_rows\n",
        ")\n",
        "\n",
        "\n",
        "assert baseline_rows == 39, (\n",
        "    f\"Expected 39 baseline errors, \"\n",
        "    f\"found {baseline_rows}\"\n",
        ")\n",
        "\n",
        "assert constrained_rows == 40, (\n",
        "    f\"Expected 40 constrained errors, \"\n",
        "    f\"found {constrained_rows}\"\n",
        ")\n",
        "\n",
        "assert len(localization_df) == 79, (\n",
        "    f\"Expected 79 total semantic-error rows, \"\n",
        "    f\"found {len(localization_df)}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\n✅ 39 baseline errors verified.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ 40 schema-constrained errors verified.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ 79 total localization rows verified.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Check note uniqueness / missing text\n",
        "# ------------------------------------------------------------\n",
        "missing_notes = int(\n",
        "    localization_df[\n",
        "        \"study1_error_note\"\n",
        "    ].isna().sum()\n",
        ")\n",
        "\n",
        "empty_notes = int(\n",
        "    (\n",
        "        localization_df[\n",
        "            \"study1_error_note\"\n",
        "        ].astype(str).str.strip() == \"\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nMissing annotation notes:\",\n",
        "    missing_notes\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Empty annotation notes:\",\n",
        "    empty_notes\n",
        ")\n",
        "\n",
        "assert missing_notes == 0\n",
        "assert empty_notes == 0\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Transcript coverage\n",
        "# ------------------------------------------------------------\n",
        "transcript_cases = (\n",
        "    localization_df.loc[\n",
        "        localization_df[\n",
        "            \"full_transcript_available\"\n",
        "        ],\n",
        "        \"case_id\"\n",
        "    ]\n",
        "    .drop_duplicates()\n",
        "    .tolist()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nCases with full recovered transcripts:\"\n",
        ")\n",
        "\n",
        "for case_id in transcript_cases:\n",
        "    print(\" •\", case_id)\n",
        "\n",
        "print(\n",
        "    \"\\nNumber of cases with transcript:\",\n",
        "    len(transcript_cases)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. SAVE ONLY TO STUDY 2A\n",
        "# ------------------------------------------------------------\n",
        "LOCALIZATION_MASTER_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_error_localization_master.csv\"\n",
        ")\n",
        "\n",
        "localization_df.to_csv(\n",
        "    LOCALIZATION_MASTER_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "# Also save a JSON version so long strings and nested material\n",
        "# are preserved cleanly.\n",
        "LOCALIZATION_JSON_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_error_localization_master.json\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    LOCALIZATION_JSON_PATH,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        localization_rows,\n",
        "        f,\n",
        "        indent=2,\n",
        "        ensure_ascii=False,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. Create a lightweight review version\n",
        "#\n",
        "# Exclude the full transcript and entire model output so the\n",
        "# dataframe is easy to inspect manually.\n",
