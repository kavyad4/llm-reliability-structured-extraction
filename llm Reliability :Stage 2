        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Attach exact schema file + schema hash\n",
        "# ============================================================\n",
        "\n",
        "schema_files = []\n",
        "schema_hashes = []\n",
        "frozen_schema_hashes = []\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    generation_manifest_df\n",
        "    .iterrows()\n",
        "):\n",
        "\n",
        "    key = (\n",
        "        row[\"schema_path\"],\n",
        "        row[\"schema_variant\"],\n",
        "    )\n",
        "\n",
        "\n",
        "    if key not in schema_variant_lookup:\n",
        "\n",
        "        raise KeyError(\n",
