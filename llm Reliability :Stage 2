        "].copy()\n",
        "\n",
        "\n",
        "unsupported_field_analysis = (\n",
        "    unsupported_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"condition\",\n",
        "        ]\n",
        "    )\n",
