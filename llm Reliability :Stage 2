        "        ascending=False\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"OVERALL ERROR FREQUENCY BY FIELD\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(overall_field_counts)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Baseline vs constrained field counts\n",
        "# ------------------------------------------------------------\n",
        "field_condition_counts = (\n",
        "    final_loc_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"condition\",\n",
        "        ]\n",
        "    )\n",
        "    .size()\n",
        "    .unstack(fill_value=0)\n",
        "    .reset_index()\n",
