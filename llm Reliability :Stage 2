        "        \"file\",\n",
        "        \"path\",\n",
        "        \"key\",\n",
        "        \"value_type\",\n",
        "        \"preview\",\n",
        "    ]\n",
        "\n",
        "    search_df = search_df[cols]\n",
        "\n",
        "    display(search_df)\n",
        "\n",
        "\n",
