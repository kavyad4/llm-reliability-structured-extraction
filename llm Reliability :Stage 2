        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "with open(\n",
        "    SMOKE_FINAL_JSON_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    smoke_final_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "assert len(smoke_final_df) == 8\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"expected_action\"\n",
        "    ].notna()\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"expected_action\"\n",
        "    ]\n",
        "    .eq(\"null\")\n",
        "    .sum()\n",
        "    == 6\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Canonical linkage loaded:\",\n",
        "    len(review_df),\n",
        "    \"/192\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    '✅ Literal \"null\" expected_action labels preserved:',\n",
        "    int(\n",
        "        review_df[\n",
        "            \"expected_action\"\n",
        "        ]\n",
        "        .eq(\"null\")\n",
        "        .sum()\n",
        "    )\n",
        ")\n",
