        "        schema_variant_lookup[\n",
        "            key\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    schema_files.append(\n",
        "        info[\"schema_file\"]\n",
        "    )\n",
        "\n",
        "    schema_hashes.append(\n",
        "        info[\n",
        "            \"variant_schema_sha256\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    frozen_schema_hashes.append(\n",
        "        info[\n",
        "            \"frozen_schema_sha256\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"schema_file\"\n",
        "] = schema_files\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"schema_sha256\"\n",
        "] = schema_hashes\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"frozen_schema_sha256\"\n",
        "] = frozen_schema_hashes\n",
        "\n",
        "\n",
        "assert (\n",
        "    generation_manifest_df[\n",
        "        \"schema_sha256\"\n",
        "    ].notna().all()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Attach frozen model/prompt/config metadata\n",
        "# ============================================================\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"model\"\n",
        "] = STUDY2A_MODEL\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"temperature\"\n",
        "] = GENERATION_CONFIG[\n",
        "    \"temperature\"\n",
        "]\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"candidate_count\"\n",
        "] = GENERATION_CONFIG[\n",
        "    \"candidate_count\"\n",
        "]\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"max_output_tokens\"\n",
        "] = GENERATION_CONFIG[\n",
        "    \"max_output_tokens\"\n",
        "]\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"prompt_template_sha256\"\n",
        "] = PROMPT_TEMPLATE_SHA256\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"generation_config_sha256\"\n",
        "] = GENERATION_CONFIG_SHA256\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"generation_status\"\n",
        "] = \"not_run\"\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"attempt_count\"\n",
        "] = 0\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"raw_response\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"raw_response_sha256\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"parsed_json\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"json_valid\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"schema_valid\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"schema_error_count\"\n",
        "] = None\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"generation_error\"\n",
        "] = None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Verify scenario text remains identical across variants\n",
        "# ============================================================\n",
        "\n",
        "fairness_check = (\n",
        "    generation_manifest_df\n",
        "    .groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "    .agg(\n",
        "        rows=(\n",
        "            \"experiment_id\",\n",
