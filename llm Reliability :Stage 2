        "        smoke_results_df[\n",
        "            \"schema_valid\"\n",
        "        ]\n",
        "        == True\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\nCompleted API responses:\")\n",
