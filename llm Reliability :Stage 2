        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\n⚠️ These are interim counts only.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. Remaining pending breakdown\n",
        "# ============================================================\n",
        "\n",
        "pending_df = (\n",
