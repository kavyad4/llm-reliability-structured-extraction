        "\n",
        "# ============================================================\n",
        "# 8. Normalize boolean\n",
        "# ============================================================\n",
        "\n",
        "def as_bool(value):\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        bool\n",
        "    ):\n",
        "        return value\n",
        "\n",
        "    return (\n",
        "        str(value)\n",
        "        .strip()\n",
        "        .lower()\n",
        "        == \"true\"\n",
        "    )\n",
