        "\n",
        "        \"enum\": [\n",
        "            \"present\",\n",
        "            \"denied\",\n",
        "            \"improving\",\n",
        "            \"resolved\",\n",
        "            \"historical\",\n",
        "            \"uncertain\",\n",
        "            None,\n",
        "        ],\n",
        "    }\n",
        "\n",
        "\n",
        "def richer_followup_condition():\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"type\": [\n",
        "            \"object\",\n",
        "            \"null\",\n",
        "        ],\n",
        "\n",
        "        \"additionalProperties\":\n",
        "            False,\n",
        "\n",
        "        \"required\": [\n",
        "            \"trigger_type\",\n",
        "            \"trigger_text\",\n",
        "        ],\n",
        "\n",
        "        \"properties\": {\n",
        "\n",
        "            \"trigger_type\": {\n",
        "\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "\n",
        "                \"enum\": [\n",
        "                    \"routine\",\n",
        "                    \"if_worsening\",\n",
        "                    \"if_no_improvement\",\n",
        "                    \"if_test_result\",\n",
        "                    \"if_treatment_failure\",\n",
        "                    \"other\",\n",
        "                    \"uncertain\",\n",
        "                    None,\n",
        "                ],\n",
        "            },\n",
        "\n",
        "\n",
        "            \"trigger_text\": {\n",
        "\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "        },\n",
        "    }\n",
        "\n",
        "\n",
        "def richer_symptom_severity():\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"type\": [\n",
        "            \"object\",\n",
        "            \"null\",\n",
        "        ],\n",
        "\n",
        "        \"additionalProperties\":\n",
        "            False,\n",
        "\n",
        "        \"required\": [\n",
        "            \"intensity\",\n",
        "            \"trigger\",\n",
        "            \"distribution\",\n",
        "            \"functional_impact\",\n",
        "            \"context\",\n",
        "        ],\n",
        "\n",
        "        \"properties\": {\n",
        "\n",
        "            \"intensity\": {\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "\n",
        "            \"trigger\": {\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "\n",
        "            \"distribution\": {\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "\n",
        "            \"functional_impact\": {\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "\n",
        "            \"context\": {\n",
        "                \"type\": [\n",
        "                    \"string\",\n",
        "                    \"null\",\n",
        "                ],\n",
        "            },\n",
        "        },\n",
        "    }\n",
        "\n",
        "\n",
        "RICHER_BUILDERS = {\n",
        "\n",
        "    \"medications[].action[]<item>\":\n",
        "        richer_medication_action,\n",
        "\n",
        "    \"symptoms[].status\":\n",
        "        richer_symptom_status,\n",
        "\n",
        "    \"follow_up.condition\":\n",
        "        richer_followup_condition,\n",
        "\n",
        "    \"symptoms[].severity\":\n",
        "        richer_symptom_severity,\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Build one full-schema experimental variant\n",
        "# ============================================================\n",
        "\n",
        "def build_schema_variant(\n",
        "    frozen_schema,\n",
        "    schema_path,\n",
        "    variant_name,\n",
        "):\n",
        "\n",
        "    schema = copy.deepcopy(\n",
        "        frozen_schema\n",
        "    )\n",
        "\n",
        "    spec = TARGET_SPECS[\n",
        "        schema_path\n",
        "    ]\n",
        "\n",
        "    parent = spec[\n",
        "        \"parent_getter\"\n",
        "    ](schema)\n",
        "\n",
        "    property_name = spec[\n",
        "        \"property_name\"\n",
        "    ]\n",
        "\n",
        "    original_property_schema = (\n",
        "        copy.deepcopy(\n",
        "            parent[\n",
        "                \"properties\"\n",
        "            ][\n",
        "                property_name\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # A. FORCED REQUIRED\n",
        "    #\n",
        "    # Required + no null escape.\n",
        "    # Arrays also require >= 1 item.\n",
        "    # --------------------------------------------------------\n",
        "    if variant_name == \"forced_required\":\n",
        "\n",
        "        make_required(\n",
        "            parent,\n",
        "            property_name\n",
        "        )\n",
        "\n",
        "        new_property = remove_null(\n",
        "            original_property_schema\n",
        "        )\n",
        "\n",
        "        if (\n",
        "            new_property.get(\"type\")\n",
        "            == \"array\"\n",
        "        ):\n",
        "            new_property[\"minItems\"] = 1\n",
        "\n",
        "        parent[\n",
        "            \"properties\"\n",
        "        ][\n",
        "            property_name\n",
        "        ] = new_property\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # B. REQUIRED NULLABLE\n",
        "    #\n",
        "    # Property must exist, but explicit null is permitted.\n",
        "    # --------------------------------------------------------\n",
        "    elif variant_name == \"required_nullable\":\n",
        "\n",
        "        make_required(\n",
        "            parent,\n",
        "            property_name\n",
        "        )\n",
        "\n",
        "        new_property = allow_null(\n",
        "            original_property_schema\n",
        "        )\n",
        "\n",
        "        # Do not force array completion when null is allowed.\n",
        "        new_property.pop(\n",
        "            \"minItems\",\n",
        "            None\n",
        "        )\n",
        "\n",
        "        parent[\n",
        "            \"properties\"\n",
        "        ][\n",
        "            property_name\n",
        "        ] = new_property\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # C. OPTIONAL\n",
        "    #\n",
        "    # Same nullable representation as required_nullable,\n",
        "    # but field itself may be omitted.\n",
        "    #\n",
        "    # This isolates the effect of requiredness.\n",
        "    # --------------------------------------------------------\n",
        "    elif variant_name == \"optional\":\n",
        "\n",
        "        make_optional(\n",
        "            parent,\n",
        "            property_name\n",
        "        )\n",
        "\n",
        "        new_property = allow_null(\n",
        "            original_property_schema\n",
        "        )\n",
        "\n",
        "        new_property.pop(\n",
        "            \"minItems\",\n",
        "            None\n",
        "        )\n",
        "\n",
        "        parent[\n",
        "            \"properties\"\n",
        "        ][\n",
        "            property_name\n",
        "        ] = new_property\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # D. SEMANTICALLY RICHER\n",
        "    #\n",
        "    # Keep property required, but replace its representation\n",
        "    # with a richer nullable structure.\n",
        "    # --------------------------------------------------------\n",
        "    elif variant_name == \"semantically_richer\":\n",
        "\n",
        "        make_required(\n",
        "            parent,\n",
        "            property_name\n",
        "        )\n",
        "\n",
        "        parent[\n",
        "            \"properties\"\n",
        "        ][\n",
        "            property_name\n",
        "        ] = (\n",
        "            RICHER_BUILDERS[\n",
        "                schema_path\n",
        "            ]()\n",
        "        )\n",
        "\n",
        "\n",
        "    else:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Unknown variant: {variant_name}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    return schema\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Recursive structural diff\n",
        "# ============================================================\n",
        "\n",
        "def json_diff_paths(\n",
        "    before,\n",
        "    after,\n",
        "    path=\"$\",\n",
        "):\n",
        "    \"\"\"\n",
        "    Return JSON paths where two structures differ.\n",
        "\n",
        "    Lists are treated as one value so changes to things\n",
        "    like `required` or `enum` are reported cleanly.\n",
        "    \"\"\"\n",
        "\n",
        "    diffs = []\n",
        "\n",
        "\n",
        "    if type(before) != type(after):\n",
        "\n",
        "        return [path]\n",
        "\n",
        "\n",
        "    if isinstance(before, dict):\n",
        "\n",
        "        all_keys = sorted(\n",
        "            set(before.keys())\n",
        "            | set(after.keys())\n",
        "        )\n",
        "\n",
        "        for key in all_keys:\n",
        "\n",
        "            child_path = (\n",
        "                f\"{path}.{key}\"\n",
        "            )\n",
        "\n",
        "            if key not in before:\n",
        "                diffs.append(\n",
        "                    child_path\n",
        "                )\n",
        "\n",
        "            elif key not in after:\n",
        "                diffs.append(\n",
        "                    child_path\n",
        "                )\n",
        "\n",
        "            else:\n",
        "                diffs.extend(\n",
        "                    json_diff_paths(\n",
        "                        before[key],\n",
        "                        after[key],\n",
        "                        child_path,\n",
        "                    )\n",
        "                )\n",
        "\n",
        "        return diffs\n",
        "\n",
        "\n",
        "    if isinstance(before, list):\n",
        "\n",
        "        if before != after:\n",
        "            diffs.append(path)\n",
        "\n",
        "        return diffs\n",
        "\n",
        "\n",
        "    if before != after:\n",
        "        diffs.append(path)\n",
        "\n",
        "\n",
        "    return diffs\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Build ALL 16 variants\n",
        "# ============================================================\n",
        "\n",
        "SCHEMA_VARIANT_DIR = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"schema_variants\"\n",
        ")\n",
        "\n",
        "SCHEMA_VARIANT_DIR.mkdir(\n",
        "    parents=True,\n",
        "    exist_ok=True\n",
        ")\n",
        "\n",
        "\n",
        "schema_variant_rows = []\n",
        "schema_variants = {}\n",
        "\n",
        "\n",
        "for schema_path in SELECTED_FIELDS:\n",
        "\n",
        "    schema_variants[\n",
        "        schema_path\n",
        "    ] = {}\n",
        "\n",
        "\n",
        "    for variant_name in [\n",
        "        \"forced_required\",\n",
        "        \"required_nullable\",\n",
        "        \"optional\",\n",
        "        \"semantically_richer\",\n",
        "    ]:\n",
        "\n",
        "        variant_schema = (\n",
        "            build_schema_variant(\n",
        "                FROZEN_SCHEMA,\n",
        "                schema_path,\n",
        "                variant_name,\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Hash\n",
        "        # ----------------------------------------------------\n",
        "        variant_hash = sha256_json(\n",
        "            variant_schema\n",
        "        )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Structural differences from frozen schema\n",
        "        # ----------------------------------------------------\n",
        "        diff_paths = json_diff_paths(\n",
        "            FROZEN_SCHEMA,\n",
        "            variant_schema\n",
        "        )\n",
        "\n",
        "\n",
        "        spec = TARGET_SPECS[\n",
        "            schema_path\n",
        "        ]\n",
        "\n",
        "        property_root = spec[\n",
        "            \"property_json_path\"\n",
        "        ]\n",
        "\n",
        "        required_root = spec[\n",
        "            \"required_json_path\"\n",
        "        ]\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # CRITICAL CONTROL CHECK\n",
        "        #\n",
        "        # Every change must occur either:\n",
        "        #\n",
        "        # 1. inside the intended target property\n",
        "        # OR\n",
        "        # 2. in the parent's required list.\n",
        "        # ----------------------------------------------------\n",
        "        unexpected_diffs = [\n",
        "\n",
        "            p\n",
        "            for p in diff_paths\n",
        "\n",
        "            if not (\n",
        "                p.startswith(\n",
        "                    property_root\n",
        "                )\n",
        "                or\n",
        "                p == required_root\n",
        "            )\n",
        "        ]\n",
        "\n",
        "\n",
        "        controlled_change = (\n",
        "            len(unexpected_diffs)\n",
        "            == 0\n",
        "        )\n",
        "\n",
        "\n",
        "        if not controlled_change:\n",
        "\n",
        "            raise AssertionError(\n",
        "                f\"\\nUnexpected schema changes!\\n\"\n",
        "                f\"Field: {schema_path}\\n\"\n",
        "                f\"Variant: {variant_name}\\n\"\n",
        "                f\"Unexpected paths: \"\n",
        "                f\"{unexpected_diffs}\"\n",
        "            )\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Store in memory\n",
        "        # ----------------------------------------------------\n",
        "        schema_variants[\n",
        "            schema_path\n",
        "        ][\n",
        "            variant_name\n",
        "        ] = variant_schema\n",
        "\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Safe filename\n",
        "        # ----------------------------------------------------\n",
        "        safe_field_name = (\n",
        "            schema_path\n",
        "            .replace(\"[]<item>\", \"_item\")\n",
        "            .replace(\"[]\", \"_array\")\n",
        "            .replace(\".\", \"__\")\n",
        "        )\n",
        "\n",
        "\n",
        "        variant_file = (\n",
        "            SCHEMA_VARIANT_DIR\n",
        "            / (\n",
        "                f\"{safe_field_name}\"\n",
        "                f\"__{variant_name}.json\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "        with open(\n",
        "            variant_file,\n",
        "            \"w\",\n",
        "            encoding=\"utf-8\"\n",
        "        ) as f:\n",
        "\n",
        "            json.dump(\n",
        "                variant_schema,\n",
        "                f,\n",
        "                indent=2,\n",
        "                ensure_ascii=False,\n",
        "            )\n",
        "\n",
        "\n",
        "        schema_variant_rows.append(\n",
        "            {\n",
        "                \"schema_path\":\n",
        "                    schema_path,\n",
        "\n",
        "                \"variant\":\n",
        "                    variant_name,\n",
        "\n",
        "                \"frozen_schema_sha256\":\n",
        "                    FROZEN_SCHEMA_SHA256,\n",
        "\n",
        "                \"variant_schema_sha256\":\n",
        "                    variant_hash,\n",
        "\n",
        "                \"changed_path_count\":\n",
        "                    len(diff_paths),\n",
        "\n",
        "                \"changed_paths\":\n",
        "                    \" | \".join(\n",
        "                        diff_paths\n",
        "                    ),\n",
        "\n",
        "                \"unexpected_change_count\":\n",
        "                    len(\n",
        "                        unexpected_diffs\n",
        "                    ),\n",
        "\n",
        "                \"controlled_change\":\n",
        "                    controlled_change,\n",
        "\n",
        "                \"schema_file\":\n",
        "                    str(\n",
        "                        variant_file\n",
        "                    ),\n",
        "            }\n",
        "        )\n",
        "\n",
        "\n",
        "schema_variant_summary_df = (\n",
        "    pd.DataFrame(\n",
        "        schema_variant_rows\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Validate 16 unique experimental schemas\n",
        "# ============================================================\n",
        "\n",
        "assert len(\n",
        "    schema_variant_summary_df\n",
        ") == 16\n",
        "\n",
        "\n",
        "assert (\n",
        "    schema_variant_summary_df[\n",
        "        \"controlled_change\"\n",
        "    ].all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    schema_variant_summary_df[\n",
        "        \"unexpected_change_count\"\n",
        "    ].sum()\n",
        "    == 0\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"SCHEMA VARIANT VALIDATION\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(\n",
        "    schema_variant_summary_df[\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"variant\",\n",
        "            \"changed_path_count\",\n",
        "            \"unexpected_change_count\",\n",
        "            \"controlled_change\",\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Inspect target properties after manipulation\n",
        "# ============================================================\n",
        "\n",
        "target_property_rows = []\n",
        "\n",
        "\n",
        "for schema_path in SELECTED_FIELDS:\n",
        "\n",
        "    for variant_name in [\n",
        "        \"forced_required\",\n",
        "        \"required_nullable\",\n",
        "        \"optional\",\n",
        "        \"semantically_richer\",\n",
        "    ]:\n",
        "\n",
        "        variant_schema = (\n",
        "            schema_variants[\n",
        "                schema_path\n",
        "            ][\n",
        "                variant_name\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        spec = TARGET_SPECS[\n",
        "            schema_path\n",
        "        ]\n",
        "\n",
        "        parent = spec[\n",
        "            \"parent_getter\"\n",
        "        ](\n",
        "            variant_schema\n",
        "        )\n",
        "\n",
        "        property_name = spec[\n",
        "            \"property_name\"\n",
        "        ]\n",
        "\n",
        "        property_schema = (\n",
        "            parent[\n",
        "                \"properties\"\n",
        "            ][\n",
        "                property_name\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        required_fields = (\n",
        "            parent.get(\n",
        "                \"required\",\n",
        "                []\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "        target_property_rows.append(\n",
        "            {\n",
        "                \"schema_path\":\n",
        "                    schema_path,\n",
        "\n",
        "                \"variant\":\n",
        "                    variant_name,\n",
        "\n",
        "                \"property_required\":\n",
        "                    property_name\n",
        "                    in required_fields,\n",
        "\n",
        "                \"target_schema\":\n",
        "                    json.dumps(\n",
        "                        property_schema,\n",
        "                        ensure_ascii=False,\n",
        "                        sort_keys=True,\n",
        "                    ),\n",
        "            }\n",
        "        )\n",
        "\n",
        "\n",
        "target_property_df = pd.DataFrame(\n",
        "    target_property_rows\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"TARGET PROPERTY CHECK\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(target_property_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Additional experimental assertions\n",
        "# ============================================================\n",
        "\n",
        "for schema_path in SELECTED_FIELDS:\n",
        "\n",
        "    subset = target_property_df[\n",
        "        target_property_df[\n",
        "            \"schema_path\"\n",
        "        ]\n",
        "        == schema_path\n",
        "    ].set_index(\n",
        "        \"variant\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # forced required\n",
        "    assert bool(\n",
        "        subset.loc[\n",
        "            \"forced_required\",\n",
        "            \"property_required\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # required nullable\n",
        "    assert bool(\n",
        "        subset.loc[\n",
        "            \"required_nullable\",\n",
        "            \"property_required\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # optional\n",
        "    assert not bool(\n",
        "        subset.loc[\n",
        "            \"optional\",\n",
        "            \"property_required\"\n",
        "        ]\n",
        "    )\n",
