        "    \"\"\"\n",
        "\n",
        "    if isinstance(value, str):\n",
        "        return norm_text(value)\n",
        "\n",
        "    if isinstance(value, list):\n",
        "        return [\n",
        "            normalize_value(x)\n",
        "            for x in value\n",
        "        ]\n",
        "\n",
        "    if isinstance(value, dict):\n",
        "        return {\n",
        "            key: normalize_value(value[key])\n",
        "            for key in sorted(value)\n",
        "        }\n",
        "\n",
        "    return value\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Find target symptom / medication entity\n",
        "# ============================================================\n",
        "\n",
        "def find_medication(\n",
        "    parsed,\n",
        "    target_entity,\n",
        "):\n",
        "\n",
        "    meds = parsed.get(\n",
        "        \"medications\",\n",
        "        []\n",
        "    )\n",
        "\n",
        "    if not isinstance(meds, list):\n",
        "        return None\n",
        "\n",
        "\n",
        "    # No named target in an absent-evidence scenario.\n",
        "    if missing(target_entity):\n",
        "\n",
        "        if len(meds) == 0:\n",
        "            return None\n",
        "\n",
        "        # Do not guess which unexpected medication\n",
        "        # should be treated as the target.\n",
        "        return {\n",
        "            \"_unexpected_entities\": meds\n",
        "        }\n",
        "\n",
        "\n",
        "    target_norm = norm_text(\n",
        "        target_entity\n",
        "    )\n",
        "\n",
        "\n",
        "    for med in meds:\n",
        "\n",
        "        name = norm_text(\n",
        "            med.get(\n",
        "                \"name\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if (\n",
        "            name\n",
        "            and target_norm\n",
        "            and (\n",
        "                name == target_norm\n",
        "                or name in target_norm\n",
        "                or target_norm in name\n",
        "            )\n",
        "        ):\n",
        "            return med\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def find_symptom(\n",
        "    parsed,\n",
        "    target_entity,\n",
        "):\n",
        "\n",
        "    symptoms = parsed.get(\n",
        "        \"symptoms\",\n",
        "        []\n",
        "    )\n",
        "\n",
        "    if not isinstance(\n",
        "        symptoms,\n",
        "        list\n",
        "    ):\n",
        "        return None\n",
        "\n",
        "\n",
        "    if missing(target_entity):\n",
        "\n",
        "        if len(symptoms) == 0:\n",
        "            return None\n",
        "\n",
        "        return {\n",
        "            \"_unexpected_entities\":\n",
        "                symptoms\n",
        "        }\n",
        "\n",
        "\n",
        "    target_tokens = set(\n",
        "        norm_text(\n",
        "            target_entity\n",
        "        ).split()\n",
        "    )\n",
        "\n",
        "\n",
        "    best = None\n",
        "    best_score = 0\n",
        "\n",
        "\n",
        "    for symptom in symptoms:\n",
        "\n",
        "        name = norm_text(\n",
        "            symptom.get(\n",
        "                \"name\"\n",
        "            )\n",
        "        ) or \"\"\n",
        "\n",
        "        body = norm_text(\n",
        "            symptom.get(\n",
        "                \"body_site\"\n",
        "            )\n",
        "        ) or \"\"\n",
        "\n",
        "        combined_tokens = set(\n",
        "            (\n",
        "                name\n",
        "                + \" \"\n",
        "                + body\n",
        "            ).split()\n",
        "        )\n",
        "\n",
        "\n",
        "        score = len(\n",
        "            target_tokens\n",
        "            & combined_tokens\n",
        "        )\n",
        "\n",
        "\n",
        "        if score > best_score:\n",
        "\n",
        "            best = symptom\n",
        "            best_score = score\n",
        "\n",
        "\n",
        "        # Strong match:\n",
        "        # all target tokens represented by\n",
        "        # symptom name + body site.\n",
        "        if (\n",
        "            len(target_tokens) > 0\n",
        "            and target_tokens.issubset(\n",
        "                combined_tokens\n",
        "            )\n",
        "        ):\n",
        "            return symptom\n",
        "\n",
        "\n",
        "    # Accept best partial match only when at least\n",
        "    # one meaningful token matched.\n",
        "    if best_score > 0:\n",
        "        return best\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Extract ONLY the manipulated target field\n",
        "# ============================================================\n",
        "\n",
        "def extract_target_value(\n",
        "    row\n",
        "):\n",
        "\n",
        "    parsed = row[\n",
        "        \"parsed_json\"\n",
        "    ]\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        parsed,\n",
        "        str\n",
        "    ):\n",
        "        parsed = json.loads(\n",
        "            parsed\n",
        "        )\n",
        "\n",
        "\n",
        "    schema_path = row[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "\n",
        "    target_entity = row[\n",
        "        \"target_entity\"\n",
        "    ]\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # MEDICATION ACTION\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        schema_path\n",
        "        == \"medications[].action[]<item>\"\n",
        "    ):\n",
        "\n",
        "        entity = find_medication(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if entity is None:\n",
        "\n",
        "            return {\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"entity_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        if (\n",
        "            \"_unexpected_entities\"\n",
        "            in entity\n",
        "        ):\n",
        "\n",
        "            return {\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"entity_snapshot\":\n",
        "                    entity,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"action\" in entity,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                entity.get(\n",
        "                    \"action\"\n",
        "                ),\n",
        "\n",
        "            \"entity_snapshot\":\n",
        "                entity,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # SYMPTOM STATUS\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        schema_path\n",
        "        == \"symptoms[].status\"\n",
        "    ):\n",
        "\n",
        "        entity = find_symptom(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if entity is None:\n",
        "\n",
        "            return {\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"entity_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"status\" in entity,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                entity.get(\n",
        "                    \"status\"\n",
        "                ),\n",
        "\n",
        "            \"entity_snapshot\":\n",
        "                entity,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # SYMPTOM SEVERITY\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        schema_path\n",
        "        == \"symptoms[].severity\"\n",
        "    ):\n",
        "\n",
        "        entity = find_symptom(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if entity is None:\n",
        "\n",
        "            return {\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"entity_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"severity\" in entity,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                entity.get(\n",
        "                    \"severity\"\n",
        "                ),\n",
        "\n",
        "            \"entity_snapshot\":\n",
        "                entity,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # FOLLOW-UP CONDITION\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        schema_path\n",
        "        == \"follow_up.condition\"\n",
        "    ):\n",
        "\n",
        "        follow_up = parsed.get(\n",
        "            \"follow_up\",\n",
        "            {}\n",
        "        )\n",
        "\n",
        "\n",
        "        if not isinstance(\n",
        "            follow_up,\n",
        "            dict\n",
        "        ):\n",
        "\n",
        "            return {\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"entity_snapshot\":\n",
        "                    follow_up,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"condition\"\n",
        "                in follow_up,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                follow_up.get(\n",
        "                    \"condition\"\n",
        "                ),\n",
        "\n",
        "            \"entity_snapshot\":\n",
        "                follow_up,\n",
        "        }\n",
        "\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"Unsupported target path: \"\n",
        "        f\"{schema_path}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Extract target value for each of the 8 outputs\n",
        "# ============================================================\n",
        "\n",
        "target_records = []\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    review_df.iterrows()\n",
        "):\n",
        "\n",
        "    extracted = (\n",
        "        extract_target_value(\n",
        "            row\n",
        "        )\n",
        "    )\n",
        "\n",
        "    target_records.append(\n",
        "        extracted\n",
        "    )\n",
        "\n",
        "\n",
        "target_df = pd.DataFrame(\n",
        "    target_records\n",
        ")\n",
        "\n",
        "\n",
        "review_df = pd.concat(\n",
        "    [\n",
        "        review_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "\n",
        "        target_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "    ],\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Mechanical comparison to FROZEN expectations\n",
        "#\n",
        "# This does NOT adjudicate nuanced semantic mismatches.\n",
        "# ============================================================\n",
        "\n",
        "evaluation_rows = []\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    review_df.iterrows()\n",
        "):\n",
        "\n",
        "    expected_action = (\n",
        "        row[\n",
        "            \"expected_action\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    expected_value = (\n",
        "        safe_json_load(\n",
        "            row[\n",
        "                \"expected_value_json\"\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "    actual_value = (\n",
        "        row[\n",
        "            \"actual_target_value\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    field_present = bool(\n",
        "        row[\n",
        "            \"target_field_present\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    conflict = str(\n",
        "        row[\n",
        "            \"schema_semantic_conflict\"\n",
        "        ]\n",
        "    ).lower() == \"true\"\n",
        "\n",
        "\n",
        "    expected_norm = (\n",
        "        normalize_value(\n",
        "            expected_value\n",
        "        )\n",
        "    )\n",
        "\n",
        "    actual_norm = (\n",
        "        normalize_value(\n",
        "            actual_value\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    exact_value_match = (\n",
        "        expected_norm\n",
        "        == actual_norm\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # CASE 1:\n",
        "    # Forced-required condition where frozen gold says\n",
        "    # there is NO semantically justified non-null value.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        conflict\n",
        "        and\n",
        "        expected_action\n",
        "        == \"no_semantically_valid_non_null_value\"\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            field_present\n",
        "            and\n",
        "            actual_value is not None\n",
        "        ):\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"forced_non_null_commitment_observed\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = (\n",
        "                \"schema_commitment_pressure_candidate\"\n",
        "            )\n",
        "\n",
        "            manual_review_required = True\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Frozen gold contains no justified non-null \"\n",
        "                \"value, but the forced-required schema produced \"\n",
        "                \"a non-null target value.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"unexpected_abstention_under_conflict\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = True\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Schema-semantic conflict exists, but the \"\n",
        "                \"output appears to abstain.\"\n",
        "            )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # CASE 2:\n",
        "    # Required-nullable should explicitly return null.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        == \"return_null\"\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            field_present\n",
        "            and\n",
        "            actual_value is None\n",
        "        ):\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = False\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Target field is present and null, matching \"\n",
        "                \"the frozen required-nullable expectation.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"does_not_match_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = True\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Frozen expectation was explicit null.\"\n",
        "            )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # CASE 3:\n",
        "    # Optional target should be omitted.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        == \"omit_target_field\"\n",
        "    ):\n",
        "\n",
        "        if not field_present:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = False\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Target field/entity is absent, matching \"\n",
        "                \"the frozen optional-field expectation.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"non_omission_requires_manual_review\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = True\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Optional field was populated even though \"\n",
        "                \"the frozen expectation was omission. \"\n",
        "                \"Manual review is required because the \"\n",
        "                \"populated text may still reflect source wording.\"\n",
        "            )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # CASE 4:\n",
        "    # Supported ordinary/richer value.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif expected_action in {\n",
        "        \"populate_supported_value\",\n",
        "        \"populate_richer_value\",\n",
        "    }:\n",
        "\n",
        "        if exact_value_match:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = False\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Extracted target exactly matches the \"\n",
        "                \"frozen expected semantic value after \"\n",
        "                \"superficial normalization.\"\n",
        "            )\n",
        "\n",
        "        else:\n",
        "\n",
        "            mechanical_outcome = (\n",
        "                \"non_exact_value_requires_manual_review\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "            manual_review_required = True\n",
        "\n",
        "            evaluation_note = (\n",
        "                \"Target value does not exactly equal the \"\n",
        "                \"frozen gold representation. No automatic \"\n",
        "                \"semantic-error label is assigned.\"\n",
        "            )\n",
        "\n",
        "\n",
        "    else:\n",
        "\n",
        "        mechanical_outcome = (\n",
        "            \"unhandled_expectation\"\n",
        "        )\n",
        "\n",
        "        mechanism_signal = None\n",
        "\n",
        "        manual_review_required = True\n",
        "\n",
        "        evaluation_note = (\n",
        "            \"Expectation type needs manual inspection.\"\n",
        "        )\n",
        "\n",
        "\n",
        "    evaluation_rows.append(\n",
        "        {\n",
        "            \"expected_value\":\n",
        "                expected_value,\n",
        "\n",
        "            \"actual_target_value_json\":\n",
        "                json.dumps(\n",
        "                    actual_value,\n",
        "                    ensure_ascii=False,\n",
        "                    sort_keys=True,\n",
        "                ),\n",
        "\n",
        "            \"exact_value_match\":\n",
        "                exact_value_match,\n",
        "\n",
        "            \"mechanical_outcome\":\n",
        "                mechanical_outcome,\n",
        "\n",
        "            \"mechanism_signal\":\n",
        "                mechanism_signal,\n",
        "\n",
        "            \"manual_review_required\":\n",
        "                manual_review_required,\n",
        "\n",
        "            \"evaluation_note\":\n",
        "                evaluation_note,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "evaluation_df = pd.DataFrame(\n",
        "    evaluation_rows\n",
        ")\n",
        "\n",
        "\n",
        "review_df = pd.concat(\n",
        "    [\n",
        "        review_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "        evaluation_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "    ],\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Add EMPTY manual-adjudication columns\n",
        "#\n",
        "# Do NOT fill these automatically.\n",
        "# ============================================================\n",
        "\n",
        "review_df[\n",
        "    \"final_semantic_correct\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_error_category\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_mechanism\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"manual_adjudication_note\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"adjudication_status\"\n",
        "] = review_df[\n",
