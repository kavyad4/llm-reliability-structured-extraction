        ")\n",
        "\n",
        "DATA_DIR = STUDY2A_DIR / \"data\"\n",
        "RESULTS_DIR = STUDY2A_DIR / \"results\"\n",
        "\n",
        "\n",
        "LINKAGE_JSON_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_generation_gold_linkage_192.json\"\n",
        ")\n",
        "\n",
        "SMOKE_FINAL_JSON_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_smoke_semantic_review_final_8.json\"\n",
        ")\n",
