        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# Cell 7: High-confidence error → field/category suggestions\n",
        "# ============================================================\n",
        "\n",
        "import re\n",
        "import json\n",
        "import pandas as pd\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"STUDY 2A — HIGH-CONFIDENCE ERROR LOCALIZATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Start from the master localization dataframe\n",
        "# ------------------------------------------------------------\n",
        "loc_df = localization_df.copy()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Add suggestion columns.\n",
        "#\n",
        "# IMPORTANT:\n",
        "# These are SUGGESTIONS only.\n",
        "# We are not overwriting final adjudication fields yet.\n",
        "# ------------------------------------------------------------\n",
        "for col in [\n",
        "    \"suggested_error_category\",\n",
        "    \"suggested_schema_path\",\n",
        "    \"suggested_field\",\n",
        "    \"suggested_entity_or_concept\",\n",
        "    \"suggestion_confidence\",\n",
        "    \"suggestion_reason\",\n",
        "]:\n",
        "    if col not in loc_df.columns:\n",
        "        loc_df[col] = None\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Helper functions\n",
        "# ------------------------------------------------------------\n",
        "def clean_text(x):\n",
        "    if x is None:\n",
        "        return \"\"\n",
        "    return str(x).strip()\n",
        "\n",
        "\n",
        "def contains_any(text, phrases):\n",
        "    text = text.lower()\n",
        "    return any(\n",
        "        phrase.lower() in text\n",
        "        for phrase in phrases\n",
        "    )\n",
        "\n",
        "\n",
        "def extract_quoted_or_named_entity(note):\n",
        "    \"\"\"\n",
        "    Lightweight entity guess.\n",
        "    Used only as a convenience suggestion.\n",
        "    \"\"\"\n",
        "    note = clean_text(note)\n",
        "\n",
        "    # Text before common patterns\n",
        "    patterns = [\n",
        "        r\"^(.+?) was assigned action=\",\n",
        "        r\"^(.+?) was assigned the action\",\n",
        "        r\"^(.+?) was labeled \",\n",
        "        r\"^(.+?) was represented \",\n",
        "        r\"^(.+?) was recorded \",\n",
        "        r\"^(.+?) was captured\",\n",
        "        r\"^(.+?) was extracted\",\n",
        "        r\"^(.+?) was omitted\",\n",
        "        r\"^The explicit denial of (.+?) was omitted\",\n",
        "    ]\n",
        "\n",
        "    for pattern in patterns:\n",
        "        m = re.search(\n",
        "            pattern,\n",
        "            note,\n",
        "            flags=re.IGNORECASE\n",
        "        )\n",
        "\n",
        "        if m:\n",
        "            entity = m.group(1).strip(\" .:'\\\"\")\n",
        "            if len(entity) <= 100:\n",
        "                return entity\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. High-confidence rule engine\n",
        "# ------------------------------------------------------------\n",
        "def suggest_localization(note):\n",
        "\n",
        "    note_original = clean_text(note)\n",
        "    n = note_original.lower()\n",
        "\n",
        "    result = {\n",
        "        \"suggested_error_category\": None,\n",
        "        \"suggested_schema_path\": None,\n",
        "        \"suggested_field\": None,\n",
        "        \"suggested_entity_or_concept\":\n",
        "            extract_quoted_or_named_entity(note_original),\n",
        "        \"suggestion_confidence\": None,\n",
        "        \"suggestion_reason\": None,\n",
        "    }\n",
        "\n",
        "    # ========================================================\n",
        "    # A. UNSUPPORTED INFERENCE — medication action\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"assigned action=\" in n\n",
        "        or \"assigned the action\" in n\n",
        "    ) and (\n",
        "        \"did not explicitly\" in n\n",
        "        or \"does not explicitly\" in n\n",
        "        or \"did not contain\" in n\n",
        "        or \"does not contain\" in n\n",
        "        or \"only establishes\" in n\n",
        "        or \"only identifies\" in n\n",
        "        or \"only confirms\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"unsupported_inference\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"medications[].action[]<item>\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"action\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Model supplied a medication action \"\n",
        "                \"that the source did not explicitly support.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # B. STATUS / CERTAINTY ERROR — resolved/current/etc.\n",
        "    # ========================================================\n",
        "    status_terms = [\n",
        "        \"labeled 'resolved'\",\n",
        "        'labeled \"resolved\"',\n",
        "        \"labelled 'resolved'\",\n",
        "        \"status 'denied'\",\n",
        "        \"status='denied'\",\n",
        "        \"status \\\"denied\\\"\",\n",
        "        \"labeled active\",\n",
        "        \"labelled active\",\n",
        "        \"represented as an established historical\",\n",
        "        \"given status 'denied'\",\n",
        "    ]\n",
        "\n",
        "    if contains_any(n, status_terms):\n",
        "\n",
        "        # Assessment certainty/status-type language\n",
        "        if (\n",
        "            \"coronary artery disease\" in n\n",
        "            or \"tachycardia\" in n\n",
        "        ):\n",
        "\n",
        "            result.update({\n",
        "                \"suggested_error_category\":\n",
        "                    \"status_certainty_error\",\n",
        "\n",
        "                \"suggested_schema_path\":\n",
        "                    \"assessment[].certainty\",\n",
        "\n",
        "                \"suggested_field\":\n",
        "                    \"certainty\",\n",
        "\n",
        "                \"suggestion_confidence\":\n",
        "                    \"high\",\n",
        "\n",
        "                \"suggestion_reason\":\n",
        "                    \"Annotation explicitly identifies \"\n",
        "                    \"incorrect diagnostic certainty/status.\"\n",
        "            })\n",
        "\n",
        "        # Medication status\n",
        "        elif \"labeled active\" in n:\n",
        "\n",
        "            result.update({\n",
        "                \"suggested_error_category\":\n",
        "                    \"status_certainty_error\",\n",
        "\n",
        "                \"suggested_schema_path\":\n",
        "                    \"medications[].status\",\n",
        "\n",
        "                \"suggested_field\":\n",
        "                    \"status\",\n",
        "\n",
        "                \"suggestion_confidence\":\n",
        "                    \"high\",\n",
        "\n",
        "                \"suggestion_reason\":\n",
        "                    \"Annotation explicitly identifies \"\n",
        "                    \"incorrect medication status.\"\n",
        "            })\n",
        "\n",
        "        # Symptom status\n",
        "        else:\n",
        "\n",
        "            result.update({\n",
        "                \"suggested_error_category\":\n",
        "                    \"status_certainty_error\",\n",
        "\n",
        "                \"suggested_schema_path\":\n",
        "                    \"symptoms[].status\",\n",
        "\n",
        "                \"suggested_field\":\n",
        "                    \"status\",\n",
        "\n",
        "                \"suggestion_confidence\":\n",
        "                    \"high\",\n",
        "\n",
        "                \"suggestion_reason\":\n",
        "                    \"Annotation explicitly identifies \"\n",
        "                    \"incorrect symptom status.\"\n",
        "            })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # C. Explicit symptom denial omitted\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"denial\" in n\n",
        "        and \"omitted\" in n\n",
        "    ) or (\n",
        "        \"denied symptom\" in n\n",
        "        and \"omitted\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"omission\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"symptoms[]\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"symptom record\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"An explicitly denied symptom was absent \"\n",
        "                \"from the extracted symptom list.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # D. Symptom duration missing\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"duration\" in n\n",
        "        and (\n",
        "            \"omitted\" in n\n",
        "            or \"not preserved\" in n\n",
        "        )\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"partial_extraction\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"symptoms[].duration\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"duration\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Symptom was extracted but its duration \"\n",
        "                \"was not preserved.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # E. Symptom trigger/distribution/severity detail missing\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"was extracted\" in n\n",
        "        or \"were captured\" in n\n",
        "        or \"was captured\" in n\n",
        "    ) and contains_any(\n",
        "        n,\n",
        "        [\n",
        "            \"distribution\",\n",
        "            \"trigger pattern\",\n",
        "            \"temporal context\",\n",
        "            \"condition that\",\n",
        "            \"specific condition\",\n",
        "        ]\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"partial_extraction\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"symptoms[].severity\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"symptom contextual detail\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"medium\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"The symptom itself was extracted but \"\n",
        "                \"clinically relevant contextual detail was lost.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # F. Medication present in medication_changes but absent\n",
        "    #    from top-level medication list\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"omitted from the top-level medications list\" in n\n",
        "        or \"omitted from the top level medications list\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"omission\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"medications[]\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"medication record\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Medication was supported but missing from \"\n",
        "                \"the top-level medication array.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # G. Follow-up condition mapping\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"follow-up condition\" in n\n",
        "        or \"follow up condition\" in n\n",
        "    ) and (\n",
        "        \"recorded as\" in n\n",
        "        or \"not preserved\" in n\n",
        "        or \"omitted\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                (\n",
        "                    \"field_mis_mapping\"\n",
        "                    if \"recorded as\" in n\n",
        "                    else \"partial_extraction\"\n",
        "                ),\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"follow_up.condition\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"condition\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Annotation directly refers to the \"\n",
        "                \"follow_up.condition field.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # H. Follow-up timing\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"follow-up timing\" in n\n",
        "        or \"follow up timing\" in n\n",
        "        or \"one-year follow-up timing\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"partial_extraction\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"follow_up.timing_text\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"timing_text\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Annotation explicitly refers to preservation \"\n",
        "                \"of follow-up timing.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # I. Follow-up mapped to wrong event/time\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"follow-up field was mapped\" in n\n",
        "        or \"follow up field was mapped\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"field_mis_mapping\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"follow_up\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"follow_up\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Annotation explicitly describes an incorrect \"\n",
        "                \"mapping into the follow-up structure.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # J. Treatment / plan decision omitted\n",
        "    # ========================================================\n",
        "    if contains_any(\n",
        "        n,\n",
        "        [\n",
        "            \"treatment decision was omitted\",\n",
        "            \"treatment option was omitted\",\n",
        "            \"management plan was not preserved\",\n",
        "            \"plan was omitted\",\n",
        "            \"conditional next-step plan was omitted\",\n",
        "            \"conditional next step plan was omitted\",\n",
        "            \"conditional plan to consider\",\n",
        "        ]\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"omission\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"plan.patient_instructions[]\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"plan instruction\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"medium\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"A supported treatment/management decision \"\n",
        "                \"was absent from the structured plan.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # K. Test timing/detail partial extraction\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"correctly extracted as ordered\" in n\n",
        "        and (\n",
        "            \"timing was omitted\" in n\n",
        "            or \"timing\" in n\n",
        "        )\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"partial_extraction\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"plan.tests_ordered[]<item>\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"test-order detail\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Test order was captured but an explicitly \"\n",
        "                \"supported detail was lost.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # L. Physical-exam unsupported inference\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"physical exam\" in n\n",
        "        and \"transcript does not explicitly provide\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"unsupported_inference\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"physical_exam[].finding\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"finding\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Physical-exam finding was generated without \"\n",
        "                \"explicit source support.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # M. Clinician instruction inferred from patient behavior\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"clinician instruction\" in n\n",
        "        or \"instructs the patient\" in n\n",
        "        or \"instruction\" in n\n",
        "    ) and (\n",
        "        \"patient's own behavior\" in n\n",
        "        or \"patient currently\" in n\n",
        "        or \"not explicitly given by the clinician\" in n\n",
        "        or \"did not specifically instruct\" in n\n",
        "        or \"originates from the patient's description\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"unsupported_inference\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"plan.patient_instructions[]<item>\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"patient instruction\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Patient behavior/history was converted into \"\n",
        "                \"a clinician instruction without support.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # N. Explicit certainty overstatement\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"overstates certainty\" in n\n",
        "        or \"overstated certainty\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"status_certainty_error\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                \"plan.patient_instructions[]<item>\",\n",
        "\n",
        "            \"suggested_field\":\n",
        "                \"instruction wording\",\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"high\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Annotation explicitly identifies an \"\n",
        "                \"overstatement of certainty.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # ========================================================\n",
        "    # O. Generic omissions\n",
        "    #\n",
        "    # Category is clear but exact schema field may not be.\n",
        "    # ========================================================\n",
        "    if (\n",
        "        \"omitted\" in n\n",
        "        or \"not preserved\" in n\n",
        "    ):\n",
        "\n",
        "        result.update({\n",
        "            \"suggested_error_category\":\n",
        "                \"omission\",\n",
        "\n",
        "            \"suggested_schema_path\":\n",
        "                None,\n",
        "\n",
        "            \"suggested_field\":\n",
        "                None,\n",
        "\n",
        "            \"suggestion_confidence\":\n",
        "                \"category_only\",\n",
        "\n",
        "            \"suggestion_reason\":\n",
        "                \"Study 1 note explicitly describes an omission, \"\n",
        "                \"but the exact schema field requires adjudication.\"\n",
        "        })\n",
        "\n",
        "        return result\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Otherwise leave pending\n",
        "    # --------------------------------------------------------\n",
        "    return result\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Apply rules\n",
        "# ------------------------------------------------------------\n",
        "for idx, row in loc_df.iterrows():\n",
        "\n",
        "    suggestion = suggest_localization(\n",
        "        row[\"study1_error_note\"]\n",
        "    )\n",
        "\n",
        "    for key, value in suggestion.items():\n",
        "        loc_df.at[idx, key] = value\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Validate suggested schema paths\n",
        "# ------------------------------------------------------------\n",
        "def path_is_valid(path):\n",
        "\n",
        "    if path is None:\n",
        "        return True\n",
        "\n",
        "    return path in VALID_SCHEMA_PATHS\n",
        "\n",
        "\n",
        "loc_df[\"suggested_path_valid\"] = (\n",
        "    loc_df[\"suggested_schema_path\"]\n",
        "    .apply(path_is_valid)\n",
        ")\n",
        "\n",
        "invalid_paths = loc_df.loc[\n",
        "    ~loc_df[\"suggested_path_valid\"],\n",
        "    [\n",
        "        \"error_id\",\n",
        "        \"study1_error_note\",\n",
        "        \"suggested_schema_path\",\n",
        "    ]\n",
        "]\n",
        "\n",
        "if len(invalid_paths) > 0:\n",
        "\n",
        "    print(\"\\n⚠️ INVALID PATH SUGGESTIONS:\")\n",
        "    display(invalid_paths)\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\n",
        "        \"\\n✅ Every non-null suggested schema path \"\n",
        "        \"exists in the frozen schema.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Suggestion coverage\n",
        "# ------------------------------------------------------------\n",
        "category_suggested = int(\n",
        "    loc_df[\n",
        "        \"suggested_error_category\"\n",
        "    ].notna().sum()\n",
        ")\n",
        "\n",
        "path_suggested = int(\n",
        "    loc_df[\n",
        "        \"suggested_schema_path\"\n",
        "    ].notna().sum()\n",
        ")\n",
        "\n",
        "high_confidence = int(\n",
        "    (\n",
        "        loc_df[\"suggestion_confidence\"]\n",
        "        == \"high\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "medium_confidence = int(\n",
        "    (\n",
        "        loc_df[\"suggestion_confidence\"]\n",
        "        == \"medium\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "category_only = int(\n",
        "    (\n",
        "        loc_df[\"suggestion_confidence\"]\n",
        "        == \"category_only\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "unclassified = int(\n",
        "    loc_df[\n",
        "        \"suggestion_confidence\"\n",
        "    ].isna().sum()\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 100)\n",
        "print(\"AUTOMATIC LOCALIZATION COVERAGE\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\n",
        "    \"Total semantic errors:\",\n",
        "    len(loc_df)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Category suggestion available:\",\n",
        "    category_suggested\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Exact schema-path suggestion available:\",\n",
        "    path_suggested\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"High-confidence suggestions:\",\n",
        "    high_confidence\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Medium-confidence suggestions:\",\n",
        "    medium_confidence\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Category-only suggestions:\",\n",
        "    category_only\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Still unclassified:\",\n",
        "    unclassified\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Display high-confidence suggestions\n",
        "# ------------------------------------------------------------\n",
        "high_conf_df = loc_df.loc[\n",
        "    loc_df[\"suggestion_confidence\"]\n",
        "    == \"high\",\n",
        "    [\n",
        "        \"error_id\",\n",
        "        \"case_id\",\n",
        "        \"condition\",\n",
        "        \"study1_error_note\",\n",
        "        \"suggested_error_category\",\n",
        "        \"suggested_schema_path\",\n",
        "        \"suggested_entity_or_concept\",\n",
        "        \"suggestion_reason\",\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 100)\n",
        "print(\"HIGH-CONFIDENCE LOCALIZATIONS\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "display(high_conf_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. Display items still needing manual localization\n",
        "# ------------------------------------------------------------\n",
        "manual_review_df = loc_df.loc[\n",
        "    loc_df[\"suggestion_confidence\"].isin(\n",
        "        [\"medium\", \"category_only\"]\n",
        "    )\n",
        "    |\n",
        "    loc_df[\n",
        "        \"suggestion_confidence\"\n",
        "    ].isna(),\n",
        "    [\n",
        "        \"error_id\",\n",
        "        \"case_id\",\n",
        "        \"condition\",\n",
        "        \"study1_error_note\",\n",
        "        \"suggested_error_category\",\n",
        "        \"suggested_schema_path\",\n",
        "        \"suggestion_confidence\",\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 100)\n",
        "print(\"ERRORS STILL REQUIRING MANUAL REVIEW\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "display(manual_review_df)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. DO NOT copy suggestions into final adjudication yet.\n",
        "#\n",
        "# We preserve:\n",
        "#\n",
        "# error_category      = final human-reviewed label\n",
