        ")\n",
        "\n",
        "TOP_FIELD_EXAMPLES_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_top_candidate_field_errors.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "field_risk_df.to_csv(\n",
        "    FIELD_RISK_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "field_condition_counts.to_csv(\n",
