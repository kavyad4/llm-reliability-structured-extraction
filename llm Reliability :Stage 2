        "    )\n",
        "\n",
        "    print(\n",
        "        \"SCENARIO:\",\n",
        "        record[\n",
        "            \"scenario_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"EVIDENCE:\",\n",
        "        record[\n",
