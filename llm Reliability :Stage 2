        "\n",
        "    if value:\n",
        "\n",
        "        api_key = value\n",
        "        key_source = (\n",
        "            f\"environment:{env_name}\"\n",
        "        )\n",
        "        break\n",
        "\n",
        "\n",
        "if api_key is None:\n",
        "\n",
        "    try:\n",
        "\n",
        "        from google.colab import userdata\n",
        "\n",
        "        for secret_name in [\n",
        "            \"GEMINI_API_KEY\",\n",
        "            \"GOOGLE_API_KEY\",\n",
        "        ]:\n",
        "\n",
