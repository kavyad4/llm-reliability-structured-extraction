        "print(\"✅ 192/192 scientific-schema-valid.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Helpers\n",
        "# ============================================================\n",
        "\n",
        "def parse_jsonish(value):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        (\n",
        "            dict,\n",
        "            list,\n",
        "            int,\n",
        "            float,\n",
        "            bool,\n",
        "        )\n",
        "    ):\n",
        "        return value\n",
        "\n",
        "\n",
        "    text = str(value).strip()\n",
        "\n",
        "\n",
        "    if text == \"\":\n",
        "        return None\n",
        "\n",
        "\n",
        "    try:\n",
        "\n",
        "        return json.loads(\n",
        "            text\n",
        "        )\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        return text\n",
        "\n",
        "\n",
        "def normalize_text(value):\n",
        "\n",
        "    if value is None:\n",
        "        return None\n",
        "\n",
        "\n",
        "    text = str(value).lower()\n",
        "\n",
        "\n",
        "    text = re.sub(\n",
        "        r\"[^a-z0-9]+\",\n",
        "        \" \",\n",
        "        text\n",
        "    )\n",
        "\n",
        "\n",
        "    return \" \".join(\n",
        "        text.split()\n",
        "    )\n",
        "\n",
        "\n",
        "def normalize_value(value):\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        str\n",
        "    ):\n",
        "\n",
        "        return normalize_text(\n",
        "            value\n",
        "        )\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        return [\n",
        "            normalize_value(\n",
        "                item\n",
        "            )\n",
        "            for item in value\n",
        "        ]\n",
        "\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        dict\n",
        "    ):\n",
        "\n",
        "        return {\n",
        "\n",
        "            key:\n",
        "                normalize_value(\n",
        "                    value[key]\n",
        "                )\n",
        "\n",
        "            for key\n",
        "            in sorted(\n",
        "                value.keys()\n",
        "            )\n",
        "        }\n",
        "\n",
        "\n",
        "    return value\n",
        "\n",
        "\n",
        "def json_display(value):\n",
        "\n",
        "    return json.dumps(\n",
        "        value,\n",
        "        ensure_ascii=False,\n",
        "        sort_keys=True,\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Entity matching\n",
        "# ============================================================\n",
        "\n",
        "def find_medication(\n",
        "    parsed,\n",
        "    target_entity\n",
        "):\n",
        "\n",
        "    medications = parsed.get(\n",
        "        \"medications\",\n",
        "        []\n",
        "    )\n",
        "\n",
        "\n",
        "    if not isinstance(\n",
        "        medications,\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    # Some intentionally absent medication scenarios\n",
        "    # have no target medication entity.\n",
        "    if target_entity is None:\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    target = normalize_text(\n",
        "        target_entity\n",
        "    )\n",
        "\n",
        "\n",
        "    for medication in medications:\n",
        "\n",
        "        name = normalize_text(\n",
        "            medication.get(\n",
        "                \"name\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "        if (\n",
        "            name\n",
        "            and target\n",
        "            and (\n",
        "                name == target\n",
        "                or name in target\n",
        "                or target in name\n",
        "            )\n",
        "        ):\n",
        "\n",
        "            return medication\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def find_symptom(\n",
        "    parsed,\n",
        "    target_entity\n",
        "):\n",
        "\n",
        "    symptoms = parsed.get(\n",
        "        \"symptoms\",\n",
        "        []\n",
        "    )\n",
        "\n",
        "\n",
        "    if not isinstance(\n",
        "        symptoms,\n",
        "        list\n",
        "    ):\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    if target_entity is None:\n",
        "\n",
        "        return None\n",
        "\n",
        "\n",
        "    target_text = normalize_text(\n",
        "        target_entity\n",
        "    )\n",
        "\n",
        "\n",
        "    target_tokens = set(\n",
        "        target_text.split()\n",
        "    )\n",
        "\n",
        "\n",
        "    best_entity = None\n",
        "    best_score = 0\n",
        "\n",
        "\n",
        "    for symptom in symptoms:\n",
        "\n",
        "        name = (\n",
        "            normalize_text(\n",
        "                symptom.get(\n",
        "                    \"name\"\n",
        "                )\n",
        "            )\n",
        "            or \"\"\n",
        "        )\n",
        "\n",
        "\n",
        "        body_site = (\n",
        "            normalize_text(\n",
        "                symptom.get(\n",
        "                    \"body_site\"\n",
        "                )\n",
        "            )\n",
        "            or \"\"\n",
        "        )\n",
        "\n",
        "\n",
        "        combined = (\n",
        "            name\n",
        "            + \" \"\n",
        "            + body_site\n",
        "        ).strip()\n",
        "\n",
        "\n",
        "        combined_tokens = set(\n",
        "            combined.split()\n",
        "        )\n",
        "\n",
        "\n",
        "        # Direct textual match\n",
        "        if (\n",
        "            target_text\n",
        "            and (\n",
        "                target_text == combined\n",
        "                or target_text in combined\n",
        "                or combined in target_text\n",
        "            )\n",
        "        ):\n",
        "\n",
        "            return symptom\n",
        "\n",
        "\n",
        "        score = len(\n",
        "            target_tokens\n",
        "            & combined_tokens\n",
        "        )\n",
        "\n",
        "\n",
        "        if score > best_score:\n",
        "\n",
        "            best_score = score\n",
        "            best_entity = symptom\n",
        "\n",
        "\n",
        "    # Require at least one matching token\n",
        "    if best_score > 0:\n",
        "\n",
        "        return best_entity\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Extract manipulated target ONLY\n",
        "# ============================================================\n",
        "\n",
        "def extract_target(row):\n",
        "\n",
        "    parsed = parse_jsonish(\n",
        "        row[\n",
        "            \"parsed_json\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    assert isinstance(\n",
        "        parsed,\n",
        "        dict\n",
        "    )\n",
        "\n",
        "\n",
        "    path = row[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "\n",
        "\n",
        "    target_entity = row[\n",
        "        \"target_entity\"\n",
        "    ]\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Medication action\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        path\n",
        "        == \"medications[].action[]<item>\"\n",
        "    ):\n",
        "\n",
        "        medication = find_medication(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if medication is None:\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"target_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"action\"\n",
        "                in medication,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                medication.get(\n",
        "                    \"action\"\n",
        "                ),\n",
        "\n",
        "            \"target_snapshot\":\n",
        "                medication,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Symptom status\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        path\n",
        "        == \"symptoms[].status\"\n",
        "    ):\n",
        "\n",
        "        symptom = find_symptom(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if symptom is None:\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"target_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"status\"\n",
        "                in symptom,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                symptom.get(\n",
        "                    \"status\"\n",
        "                ),\n",
        "\n",
        "            \"target_snapshot\":\n",
        "                symptom,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Symptom severity\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        path\n",
        "        == \"symptoms[].severity\"\n",
        "    ):\n",
        "\n",
        "        symptom = find_symptom(\n",
        "            parsed,\n",
        "            target_entity,\n",
        "        )\n",
        "\n",
        "\n",
        "        if symptom is None:\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"target_snapshot\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"severity\"\n",
        "                in symptom,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                symptom.get(\n",
        "                    \"severity\"\n",
        "                ),\n",
        "\n",
        "            \"target_snapshot\":\n",
        "                symptom,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Follow-up condition\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        path\n",
        "        == \"follow_up.condition\"\n",
        "    ):\n",
        "\n",
        "        follow_up = parsed.get(\n",
        "            \"follow_up\",\n",
        "            {}\n",
        "        )\n",
        "\n",
        "\n",
        "        if not isinstance(\n",
        "            follow_up,\n",
        "            dict\n",
        "        ):\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"target_entity_found\":\n",
        "                    False,\n",
        "\n",
        "                \"target_field_present\":\n",
        "                    False,\n",
        "\n",
        "                \"actual_target_value\":\n",
        "                    None,\n",
        "\n",
        "                \"target_snapshot\":\n",
        "                    follow_up,\n",
        "            }\n",
        "\n",
        "\n",
        "        return {\n",
        "\n",
        "            \"target_entity_found\":\n",
        "                True,\n",
        "\n",
        "            \"target_field_present\":\n",
        "                \"condition\"\n",
        "                in follow_up,\n",
        "\n",
        "            \"actual_target_value\":\n",
        "                follow_up.get(\n",
        "                    \"condition\"\n",
        "                ),\n",
        "\n",
        "            \"target_snapshot\":\n",
        "                follow_up,\n",
        "        }\n",
        "\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"Unsupported schema path: {path}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Extract targets for all 192\n",
        "# ============================================================\n",
        "\n",
        "target_records = []\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    review_df.iterrows()\n",
        "):\n",
        "\n",
        "    target_records.append(\n",
        "        extract_target(\n",
        "            row\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "target_df = pd.DataFrame(\n",
        "    target_records\n",
        ")\n",
        "\n",
        "\n",
        "review_df = pd.concat(\n",
        "\n",
        "    [\n",
        "        review_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "\n",
        "        target_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "    ],\n",
        "\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "\n",
        "review_df[\n",
        "    \"actual_target_value_json\"\n",
        "] = (\n",
        "    review_df[\n",
        "        \"actual_target_value\"\n",
        "    ]\n",
        "    .apply(\n",
        "        json_display\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "review_df[\n",
        "    \"target_snapshot_json\"\n",
        "] = (\n",
        "    review_df[\n",
        "        \"target_snapshot\"\n",
        "    ]\n",
        "    .apply(\n",
        "        json_display\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Manipulated target field extracted for 192/192 outputs.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Mechanical evaluation\n",
        "#\n",
        "# Conservative rule:\n",
        "# only clearly equivalent cases are auto-finalized.\n",
        "#\n",
        "# Anything potentially semantic remains for adjudication.\n",
        "# ============================================================\n",
        "\n",
        "mechanical_records = []\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    review_df.iterrows()\n",
        "):\n",
        "\n",
        "    expected_action = (\n",
        "        row[\n",
        "            \"expected_action\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    expected_value = parse_jsonish(\n",
        "        row[\n",
        "            \"expected_value_json\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    actual_value = (\n",
        "        row[\n",
        "            \"actual_target_value\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    entity_found = bool(\n",
        "        row[\n",
        "            \"target_entity_found\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    field_present = bool(\n",
        "        row[\n",
        "            \"target_field_present\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    conflict = bool(\n",
        "        row[\n",
        "            \"schema_semantic_conflict\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    exact_value_match = (\n",
        "\n",
        "        normalize_value(\n",
        "            expected_value\n",
        "        )\n",
        "\n",
        "        ==\n",
        "\n",
        "        normalize_value(\n",
        "            actual_value\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # A. Forced-required semantic conflict\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        conflict\n",
        "        and\n",
        "        expected_action\n",
        "        == \"no_semantically_valid_non_null_value\"\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            entity_found\n",
        "            and\n",
        "            field_present\n",
        "            and\n",
        "            actual_value is not None\n",
        "        ):\n",
        "\n",
        "            outcome = (\n",
        "                \"forced_non_null_commitment_observed\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = (\n",
        "                \"schema_commitment_pressure_candidate\"\n",
        "            )\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outcome = (\n",
        "                \"abstention_or_parent_omission_under_conflict\"\n",
        "            )\n",
        "\n",
        "            mechanism_signal = None\n",
        "\n",
        "\n",
        "        auto_clear = False\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # B. Required-nullable expects explicit null\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        == \"return_null\"\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            entity_found\n",
        "            and\n",
        "            field_present\n",
        "            and\n",
        "            actual_value is None\n",
        "        ):\n",
        "\n",
        "            outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = True\n",
        "\n",
        "\n",
        "        elif not entity_found:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_entity_missing_when_null_expected\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        elif not field_present:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_field_omitted_when_null_expected\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outcome = (\n",
        "                \"non_null_when_null_expected\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        mechanism_signal = None\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # C. Optional field expects omission\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        == \"omit_target_field\"\n",
        "    ):\n",
        "\n",
        "        if not field_present:\n",
        "\n",
        "            outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = True\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outcome = (\n",
        "                \"non_omission_requires_manual_review\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        mechanism_signal = None\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # D. Semantically richer absent case\n",
        "    #\n",
        "    # Literal expected_action == \"null\"\n",
        "    #\n",
        "    # We require an explicit target-field null for automatic\n",
        "    # finalization. Parent/entity omission remains reviewable\n",
        "    # because it is a different representational behavior.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        == \"null\"\n",
        "    ):\n",
        "\n",
        "        if (\n",
        "            entity_found\n",
        "            and\n",
        "            field_present\n",
        "            and\n",
        "            actual_value is None\n",
        "        ):\n",
        "\n",
        "            outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = True\n",
        "\n",
        "\n",
        "        elif not entity_found:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_entity_missing_under_null_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        elif not field_present:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_field_omitted_under_null_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outcome = (\n",
        "                \"non_null_under_null_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        mechanism_signal = None\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # E. Supported/richer populated value\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    elif (\n",
        "        expected_action\n",
        "        in {\n",
        "            \"populate_supported_value\",\n",
        "            \"populate_richer_value\",\n",
        "        }\n",
        "    ):\n",
        "\n",
        "        if exact_value_match:\n",
        "\n",
        "            outcome = (\n",
        "                \"matches_frozen_expectation\"\n",
        "            )\n",
        "\n",
        "            auto_clear = True\n",
        "\n",
        "\n",
        "        elif not entity_found:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_entity_missing_requires_review\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        elif not field_present:\n",
        "\n",
        "            outcome = (\n",
        "                \"target_field_missing_requires_review\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        else:\n",
        "\n",
        "            outcome = (\n",
        "                \"non_exact_value_requires_manual_review\"\n",
        "            )\n",
        "\n",
        "            auto_clear = False\n",
        "\n",
        "\n",
        "        mechanism_signal = None\n",
        "\n",
        "\n",
        "    else:\n",
        "\n",
        "        outcome = (\n",
        "            \"unhandled_expectation\"\n",
        "        )\n",
        "\n",
        "        mechanism_signal = None\n",
        "        auto_clear = False\n",
        "\n",
        "\n",
        "    mechanical_records.append(\n",
        "        {\n",
        "\n",
        "            \"expected_value_parsed\":\n",
        "                expected_value,\n",
        "\n",
        "            \"exact_value_match\":\n",
        "                exact_value_match,\n",
        "\n",
        "            \"mechanical_outcome\":\n",
        "                outcome,\n",
        "\n",
        "            \"mechanism_signal\":\n",
        "                mechanism_signal,\n",
        "\n",
        "            \"auto_clear\":\n",
        "                auto_clear,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "mechanical_df = pd.DataFrame(\n",
        "    mechanical_records\n",
        ")\n",
        "\n",
        "\n",
        "review_df = pd.concat(\n",
        "\n",
        "    [\n",
        "        review_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "\n",
        "        mechanical_df.reset_index(\n",
        "            drop=True\n",
        "        ),\n",
        "    ],\n",
        "\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Initialize adjudication columns\n",
        "# ============================================================\n",
        "\n",
        "review_df[\n",
        "    \"final_semantic_correct\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_error_category\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_mechanism\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"manual_adjudication_note\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"adjudication_status\"\n",
        "] = (\n",
        "    \"pending_manual_review\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Auto-finalize ONLY mechanically clear matches\n",
        "# ============================================================\n",
        "\n",
        "clear_mask = (\n",
        "    review_df[\n",
        "        \"auto_clear\"\n",
        "    ]\n",
        "    == True\n",
        ")\n",
        "\n",
        "\n",
        "review_df.loc[\n",
        "    clear_mask,\n",
        "    \"final_semantic_correct\"\n",
        "] = True\n",
        "\n",
        "\n",
        "review_df.loc[\n",
        "    clear_mask,\n",
        "    \"manual_adjudication_note\"\n",
        "] = (\n",
        "    \"Mechanically clear match to the \"\n",
        "    \"pre-generation frozen semantic expectation.\"\n",
        ")\n",
        "\n",
        "\n",
        "review_df.loc[\n",
        "    clear_mask,\n",
        "    \"adjudication_status\"\n",
        "] = (\n",
        "    \"auto_finalized_exact_match\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Restore the 8 already-finalized smoke adjudications\n",
        "# ============================================================\n",
        "\n",
        "smoke_lookup = (\n",
        "    smoke_final_df\n",
        "    .set_index(\n",
        "        \"experiment_id\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "def normalize_bool(value):\n",
        "\n",
        "    if isinstance(\n",
        "        value,\n",
        "        bool\n",
        "    ):\n",
        "        return value\n",
        "\n",
        "\n",
        "    text = str(value).strip().lower()\n",
        "\n",
        "\n",
        "    if text == \"true\":\n",
        "        return True\n",
        "\n",
        "    if text == \"false\":\n",
        "        return False\n",
        "\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"Cannot interpret as Boolean: {value}\"\n",
        "    )\n",
        "\n",
        "\n",
        "for experiment_id in (\n",
        "    smoke_lookup.index\n",
        "):\n",
        "\n",
        "    mask = (\n",
        "        review_df[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "        == experiment_id\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        mask.sum()\n",
        "        == 1\n",
        "    )\n",
        "\n",
        "\n",
        "    smoke_row = (\n",
        "        smoke_lookup.loc[\n",
        "            experiment_id\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    final_correct = normalize_bool(\n",
        "        smoke_row[\n",
        "            \"final_semantic_correct\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    error_category = (\n",
        "        smoke_row[\n",
        "            \"final_error_category\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    if pd.isna(\n",
        "        error_category\n",
        "    ):\n",
        "\n",
        "        error_category = None\n",
        "\n",
        "\n",
        "    mechanism = (\n",
        "        smoke_row[\n",
        "            \"final_mechanism\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    if pd.isna(\n",
        "        mechanism\n",
        "    ):\n",
        "\n",
        "        mechanism = None\n",
        "\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"final_semantic_correct\"\n",
        "    ] = final_correct\n",
        "\n",
