        "\n",
        "\n",
        "print(\n",
        "    \"✅ Gemini credential found:\",\n",
        "    key_source\n",
        ")\n",
        "\n",
        "\n",
        "client = genai.Client(\n",
        "    api_key=api_key\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Gemini client initialized.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Hash helpers\n",
        "# ============================================================\n",
        "\n",
        "def canonical_json(obj):\n",
        "\n",
        "    return json.dumps(\n",
        "        obj,\n",
        "        sort_keys=True,\n",
        "        separators=(\",\", \":\"),\n",
        "        ensure_ascii=False,\n",
        "    )\n",
        "\n",
        "\n",
        "def sha256_text(text):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        str(text).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def sha256_json(obj):\n",
        "\n",
        "    return hashlib.sha256(\n",
        "        canonical_json(\n",
        "            obj\n",
        "        ).encode(\n",
        "            \"utf-8\"\n",
        "        )\n",
        "    ).hexdigest()\n",
        "\n",
        "\n",
        "def load_json_file(path):\n",
        "\n",
        "    with open(\n",
        "        path,\n",
        "        \"r\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        return json.load(f)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Independent validation using ORIGINAL scientific schema\n",
        "# ============================================================\n",
        "\n",
        "def validate_scientific_schema(\n",
        "    parsed_json,\n",
        "    scientific_schema,\n",
        "):\n",
        "\n",
        "    if parsed_json is None:\n",
        "\n",
        "        return (\n",
        "            False,\n",
        "            [\"JSON parsing failed\"]\n",
        "        )\n",
        "\n",
        "\n",
        "    validator = (\n",
        "        Draft202012Validator(\n",
        "            scientific_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    errors = sorted(\n",
        "        validator.iter_errors(\n",
        "            parsed_json\n",
        "        ),\n",
        "        key=lambda e: list(\n",
        "            e.absolute_path\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    messages = []\n",
        "\n",
        "\n",
        "    for error in errors:\n",
        "\n",
        "        if len(\n",
        "            error.absolute_path\n",
        "        ) == 0:\n",
        "\n",
        "            location = \"$\"\n",
        "\n",
        "        else:\n",
        "\n",
        "            location = (\n",
        "                \"$.\"\n",
        "                + \".\".join(\n",
        "                    str(x)\n",
        "                    for x\n",
        "                    in error.absolute_path\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "        messages.append(\n",
        "            f\"{location}: \"\n",
        "            f\"{error.message}\"\n",
        "        )\n",
        "\n",
        "\n",
        "    return (\n",
        "        len(errors) == 0,\n",
        "        messages,\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Transient API failure handling\n",
        "#\n",
        "# Frozen protocol:\n",
        "# maximum 3 attempts\n",
        "# retries ONLY transport/API-transient failures\n",
        "# ============================================================\n",
        "\n",
        "TRANSIENT_CODES = {\n",
        "    408,\n",
        "    429,\n",
        "    500,\n",
        "    502,\n",
        "    503,\n",
        "    504,\n",
        "}\n",
        "\n",
        "\n",
        "def get_error_code(exc):\n",
        "\n",
        "    for attr in [\n",
        "        \"status_code\",\n",
        "        \"code\",\n",
        "    ]:\n",
        "\n",
        "        value = getattr(\n",
        "            exc,\n",
        "            attr,\n",
        "            None\n",
        "        )\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            if callable(value):\n",
        "                value = value()\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            if value is not None:\n",
        "                return int(value)\n",
        "\n",
        "        except Exception:\n",
        "            pass\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "\n",
        "    for code in TRANSIENT_CODES:\n",
        "\n",
        "        if str(code) in text:\n",
        "            return code\n",
        "\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def is_transient_error(exc):\n",
        "\n",
        "    if exc is None:\n",
        "        return False\n",
        "\n",
        "\n",
        "    code = get_error_code(\n",
        "        exc\n",
        "    )\n",
        "\n",
        "\n",
        "    if code in TRANSIENT_CODES:\n",
        "        return True\n",
        "\n",
        "\n",
        "    text = str(exc).lower()\n",
        "\n",
        "\n",
        "    transient_terms = [\n",
        "        \"timeout\",\n",
        "        \"timed out\",\n",
        "        \"temporarily unavailable\",\n",
        "        \"connection reset\",\n",
        "        \"connection aborted\",\n",
        "        \"service unavailable\",\n",
        "        \"rate limit\",\n",
        "        \"resource exhausted\",\n",
        "    ]\n",
        "\n",
        "\n",
        "    return any(\n",
        "        term in text\n",
        "        for term in transient_terms\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Atomic checkpoint writer\n",
        "# ============================================================\n",
        "\n",
        "def save_checkpoint(\n",
        "    checkpoint_obj\n",
        "):\n",
        "\n",
        "    temp_path = (\n",
        "        STUDY2A_CHECKPOINT_DIR\n",
        "        / \"study2a_generation_checkpoint_v1_1.tmp.json\"\n",
        "    )\n",
        "\n",
        "\n",
        "    with open(\n",
        "        temp_path,\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        json.dump(\n",
        "            checkpoint_obj,\n",
        "            f,\n",
        "            indent=2,\n",
        "            ensure_ascii=False,\n",
        "            default=str,\n",
        "        )\n",
        "\n",
        "\n",
        "    os.replace(\n",
        "        temp_path,\n",
        "        CHECKPOINT_PATH\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Checkpoint integrity\n",
        "#\n",
        "# There should be only ONE active result per experiment.\n",
        "#\n",
        "# If a previous run ended with transport_failure,\n",
        "# we allow that experiment to be attempted again.\n",
        "# ============================================================\n",
        "\n",
        "checkpoint.setdefault(\n",
        "    \"transport_failure_history\",\n",
        "    []\n",
        ")\n",
        "\n",
        "\n",
        "active_results = (\n",
        "    checkpoint.get(\n",
        "        \"results\",\n",
        "        []\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# Detect accidental duplicate completed results\n",
        "completed_rows = [\n",
        "\n",
        "    result\n",
        "\n",
        "    for result\n",
        "    in active_results\n",
        "\n",
        "    if result.get(\n",
        "        \"generation_status\"\n",
        "    )\n",
        "    == \"completed\"\n",
        "]\n",
        "\n",
        "\n",
        "completed_ids_list = [\n",
        "\n",
        "    result[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        "\n",
        "    for result\n",
        "    in completed_rows\n",
        "]\n",
        "\n",
        "\n",
        "assert (\n",
        "    len(completed_ids_list)\n",
        "    ==\n",
        "    len(\n",
        "        set(\n",
        "            completed_ids_list\n",
        "        )\n",
        "    )\n",
        "), (\n",
        "    \"Duplicate completed experiment IDs \"\n",
        "    \"exist in checkpoint.\"\n",
        ")\n",
        "\n",
        "\n",
        "completed_ids = set(\n",
        "    completed_ids_list\n",
        ")\n",
        "\n",
        "\n",
        "permanent_failure_ids = {\n",
        "\n",
        "    result[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        "\n",
        "    for result\n",
        "    in active_results\n",
        "\n",
        "    if result.get(\n",
        "        \"generation_status\"\n",
        "    )\n",
        "    == \"permanent_api_failure\"\n",
        "}\n",
        "\n",
        "\n",
        "finished_ids = (\n",
        "    completed_ids\n",
        "    | permanent_failure_ids\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nAlready completed:\",\n",
        "    len(\n",
        "        completed_ids\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Permanent API failures already recorded:\",\n",
        "    len(\n",
        "        permanent_failure_ids\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# First 8 must already exist from smoke test\n",
        "smoke_completed = [\n",
        "\n",
        "    experiment_id\n",
        "\n",
        "    for experiment_id\n",
        "    in manifest_df[\n",
        "        manifest_df[\n",
        "            \"run_order\"\n",
        "        ].between(\n",
        "            1,\n",
        "            8\n",
        "        )\n",
        "    ][\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        "\n",
        "    if experiment_id\n",
        "    in completed_ids\n",
        "]\n",
        "\n",
        "\n",
        "assert len(\n",
        "    smoke_completed\n",
        ") == 8\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Original smoke-test 8 responses preserved.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Move old retriable transport failures to history\n",
        "#\n",
        "# This prevents duplicate active result rows when resuming.\n",
        "# ============================================================\n",
        "\n",
        "clean_active_results = []\n",
        "\n",
        "\n",
        "for result in (\n",
        "    checkpoint[\n",
        "        \"results\"\n",
        "    ]\n",
        "):\n",
        "\n",
        "    if (\n",
        "        result.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"transport_failure\"\n",
        "    ):\n",
        "\n",
        "        checkpoint[\n",
        "            \"transport_failure_history\"\n",
        "        ].append(\n",
        "            result\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        clean_active_results.append(\n",
        "            result\n",
        "        )\n",
        "\n",
        "\n",
        "checkpoint[\n",
        "    \"results\"\n",
        "] = (\n",
        "    clean_active_results\n",
        ")\n",
        "\n",
        "\n",
        "save_checkpoint(\n",
        "    checkpoint\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Select ONLY run orders 9–192\n",
        "# ============================================================\n",
        "\n",
        "remaining_df = (\n",
        "    manifest_df[\n",
        "        manifest_df[\n",
        "            \"run_order\"\n",
        "        ].between(\n",
        "            9,\n",
        "            192\n",
        "        )\n",
        "    ]\n",
        "    .sort_values(\n",
        "        \"run_order\"\n",
        "    )\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    remaining_df\n",
        ") == 184\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nFrozen remaining slots:\",\n",
        "    len(\n",
        "        remaining_df\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Function to run ONE frozen experiment\n",
        "# ============================================================\n",
        "\n",
        "def run_one_experiment(\n",
        "    row\n",
        "):\n",
        "\n",
        "    experiment_id = (\n",
        "        row[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    run_order = int(\n",
        "        row[\n",
        "            \"run_order\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Load ORIGINAL scientific schema\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    scientific_schema = (\n",
        "        load_json_file(\n",
        "            row[\n",
        "                \"scientific_schema_file\"\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    scientific_hash = (\n",
        "        sha256_json(\n",
        "            scientific_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        scientific_hash\n",
        "        == row[\n",
        "            \"scientific_schema_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"Scientific schema hash mismatch \"\n",
        "        f\"for {experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Load Gemini-facing API schema\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    api_schema = (\n",
        "        load_json_file(\n",
        "            row[\n",
        "                \"api_schema_file\"\n",
        "            ]\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    api_hash = (\n",
        "        sha256_json(\n",
        "            api_schema\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        api_hash\n",
        "        == row[\n",
        "            \"api_schema_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"API schema hash mismatch \"\n",
        "        f\"for {experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Verify prompt\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    prompt = (\n",
        "        row[\n",
        "            \"full_prompt\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    assert (\n",
        "        sha256_text(\n",
        "            prompt\n",
        "        )\n",
        "        == row[\n",
        "            \"full_prompt_sha256\"\n",
        "        ]\n",
        "    ), (\n",
        "        f\"Prompt hash mismatch \"\n",
        "        f\"for {experiment_id}\"\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Gemini generation\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    max_attempts = 3\n",
        "\n",
        "    final_exception = None\n",
        "\n",
        "    last_attempt = 0\n",
        "\n",
        "    transient_errors_this_run = []\n",
        "\n",
        "\n",
        "    for attempt in range(\n",
        "        1,\n",
        "        max_attempts + 1\n",
        "    ):\n",
        "\n",
        "        last_attempt = attempt\n",
        "\n",
        "\n",
        "        try:\n",
        "\n",
        "            response = (\n",
        "                client.models.generate_content(\n",
        "\n",
        "                    model=MODEL,\n",
        "\n",
        "                    contents=prompt,\n",
        "\n",
        "                    config=\n",
        "                        types.GenerateContentConfig(\n",
        "\n",
        "                            temperature=0.0,\n",
        "\n",
        "                            candidate_count=1,\n",
        "\n",
        "                            max_output_tokens=4096,\n",
        "\n",
        "                            response_mime_type=\n",
        "                                \"application/json\",\n",
        "\n",
        "                            response_json_schema=\n",
        "                                api_schema,\n",
        "                        ),\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "            raw_text = (\n",
        "                response.text\n",
        "                if response.text\n",
        "                is not None\n",
        "                else \"\"\n",
        "            )\n",
        "\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # Parse returned JSON\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            parsed_json = None\n",
        "\n",
        "            json_valid = False\n",
        "\n",
        "            json_error = None\n",
        "\n",
        "\n",
        "            try:\n",
        "\n",
        "                parsed_json = (\n",
        "                    json.loads(\n",
        "                        raw_text\n",
        "                    )\n",
        "                )\n",
        "\n",
        "                json_valid = True\n",
        "\n",
        "\n",
        "            except Exception as exc:\n",
        "\n",
        "                json_error = (\n",
        "                    f\"{type(exc).__name__}: \"\n",
        "                    f\"{exc}\"\n",
        "                )\n",
        "\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # Validate ORIGINAL scientific schema\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            if json_valid:\n",
        "\n",
        "                (\n",
        "                    scientific_schema_valid,\n",
        "                    scientific_schema_errors,\n",
        "                ) = (\n",
        "                    validate_scientific_schema(\n",
        "                        parsed_json,\n",
        "                        scientific_schema,\n",
        "                    )\n",
        "                )\n",
        "\n",
        "            else:\n",
        "\n",
        "                scientific_schema_valid = (\n",
        "                    False\n",
        "                )\n",
        "\n",
        "                scientific_schema_errors = [\n",
        "                    json_error\n",
        "                ]\n",
        "\n",
        "\n",
        "            # ------------------------------------------------\n",
        "            # IMPORTANT:\n",
        "            #\n",
        "            # A successful model response is NEVER retried\n",
        "            # because of:\n",
        "            #\n",
        "            # - semantic quality\n",
        "            # - JSON validity\n",
        "            # - scientific-schema validity\n",
        "            #\n",
        "            # Those are experimental outcomes.\n",
        "            # ------------------------------------------------\n",
        "\n",
        "            return {\n",
        "\n",
        "                \"run_order\":\n",
        "                    run_order,\n",
        "\n",
        "                \"experiment_id\":\n",
        "                    experiment_id,\n",
        "\n",
        "                \"scenario_id\":\n",
        "                    row[\n",
        "                        \"scenario_id\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_path\":\n",
        "                    row[\n",
        "                        \"schema_path\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"evidence_strength\":\n",
        "                    row[\n",
        "                        \"evidence_strength\"\n",
        "                    ],\n",
        "\n",
        "                \"model\":\n",
        "                    MODEL,\n",
        "\n",
        "                \"temperature\":\n",
        "                    0.0,\n",
        "\n",
        "                \"google_genai_version\":\n",
        "                    GOOGLE_GENAI_VERSION,\n",
        "\n",
        "                \"protocol_version\":\n",
        "                    protocol[\n",
        "                        \"protocol_version\"\n",
        "                    ],\n",
        "\n",
        "                \"generation_protocol_sha256\":\n",
        "                    PROTOCOL_SHA256,\n",
        "\n",
        "                \"attempt_count\":\n",
        "                    attempt,\n",
        "\n",
        "                \"transient_errors_before_success\":\n",
        "                    transient_errors_this_run,\n",
        "\n",
        "                \"generation_status\":\n",
        "                    \"completed\",\n",
        "\n",
        "                \"scenario_sha256\":\n",
        "                    row[\n",
        "                        \"scenario_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"full_prompt_sha256\":\n",
        "                    row[\n",
        "                        \"full_prompt_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"scientific_schema_sha256\":\n",
        "                    row[\n",
        "                        \"scientific_schema_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"api_schema_sha256\":\n",
        "                    row[\n",
        "                        \"api_schema_sha256\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_transport\":\n",
        "                    \"response_json_schema\",\n",
        "\n",
        "                \"raw_response\":\n",
        "                    raw_text,\n",
        "\n",
        "                \"raw_response_sha256\":\n",
        "                    sha256_text(\n",
        "                        raw_text\n",
        "                    ),\n",
        "\n",
        "                \"json_valid\":\n",
        "                    json_valid,\n",
        "\n",
        "                \"parsed_json\":\n",
        "                    parsed_json,\n",
        "\n",
        "                \"scientific_schema_valid\":\n",
        "                    scientific_schema_valid,\n",
        "\n",
        "                \"scientific_schema_error_count\":\n",
        "                    len(\n",
        "                        scientific_schema_errors\n",
        "                    ),\n",
        "\n",
        "                \"scientific_schema_errors\":\n",
        "                    scientific_schema_errors,\n",
        "\n",
        "                \"generation_error\":\n",
        "                    None,\n",
        "            }\n",
        "\n",
        "\n",
        "        except Exception as exc:\n",
        "\n",
        "            final_exception = exc\n",
        "\n",
        "\n",
        "            transient = (\n",
        "                is_transient_error(\n",
        "                    exc\n",
        "                )\n",
        "            )\n",
        "\n",
        "\n",
        "            error_text = (\n",
        "                f\"{type(exc).__name__}: \"\n",
        "                f\"{exc}\"\n",
        "            )\n",
        "\n",
        "\n",
        "            print(\n",
        "                f\"    attempt {attempt}: \"\n",
        "                f\"{error_text}\"\n",
        "            )\n",
        "\n",
        "\n",
        "            if transient:\n",
        "\n",
        "                transient_errors_this_run.append(\n",
        "                    {\n",
        "                        \"attempt\":\n",
        "                            attempt,\n",
        "\n",
        "                        \"error\":\n",
        "                            error_text,\n",
        "                    }\n",
        "                )\n",
        "\n",
        "\n",
        "            # Permanent errors are not retried\n",
        "            if not transient:\n",
        "\n",
        "                break\n",
        "\n",
        "\n",
        "            # Retry transient error only if attempts remain\n",
        "            if attempt < max_attempts:\n",
        "\n",
        "                time.sleep(\n",
        "                    2 ** (\n",
        "                        attempt - 1\n",
        "                    )\n",
        "                )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Failed API/transport call\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    status = (\n",
        "        \"transport_failure\"\n",
        "        if is_transient_error(\n",
        "            final_exception\n",
        "        )\n",
        "        else\n",
        "        \"permanent_api_failure\"\n",
        "    )\n",
        "\n",
        "\n",
        "    return {\n",
        "\n",
        "        \"run_order\":\n",
        "            run_order,\n",
        "\n",
        "        \"experiment_id\":\n",
        "            experiment_id,\n",
        "\n",
        "        \"scenario_id\":\n",
        "            row[\n",
        "                \"scenario_id\"\n",
        "            ],\n",
        "\n",
        "        \"schema_path\":\n",
        "            row[\n",
        "                \"schema_path\"\n",
        "            ],\n",
        "\n",
        "        \"schema_variant\":\n",
        "            row[\n",
        "                \"schema_variant\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            row[\n",
        "                \"evidence_strength\"\n",
        "            ],\n",
        "\n",
        "        \"model\":\n",
        "            MODEL,\n",
        "\n",
        "        \"temperature\":\n",
        "            0.0,\n",
        "\n",
        "        \"google_genai_version\":\n",
        "            GOOGLE_GENAI_VERSION,\n",
        "\n",
        "        \"protocol_version\":\n",
        "            protocol[\n",
        "                \"protocol_version\"\n",
        "            ],\n",
        "\n",
        "        \"generation_protocol_sha256\":\n",
        "            PROTOCOL_SHA256,\n",
        "\n",
        "        \"attempt_count\":\n",
        "            last_attempt,\n",
        "\n",
        "        \"transient_errors_before_success\":\n",
        "            transient_errors_this_run,\n",
        "\n",
        "        \"generation_status\":\n",
        "            status,\n",
        "\n",
        "        \"scenario_sha256\":\n",
        "            row[\n",
        "                \"scenario_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"full_prompt_sha256\":\n",
        "            row[\n",
        "                \"full_prompt_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"scientific_schema_sha256\":\n",
        "            row[\n",
        "                \"scientific_schema_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"api_schema_sha256\":\n",
        "            row[\n",
        "                \"api_schema_sha256\"\n",
        "            ],\n",
        "\n",
        "        \"schema_transport\":\n",
        "            \"response_json_schema\",\n",
        "\n",
        "        \"raw_response\":\n",
        "            None,\n",
        "\n",
        "        \"raw_response_sha256\":\n",
        "            None,\n",
        "\n",
        "        \"json_valid\":\n",
        "            None,\n",
        "\n",
        "        \"parsed_json\":\n",
        "            None,\n",
        "\n",
        "        \"scientific_schema_valid\":\n",
        "            None,\n",
        "\n",
        "        \"scientific_schema_error_count\":\n",
        "            None,\n",
        "\n",
        "        \"scientific_schema_errors\":\n",
        "            None,\n",
        "\n",
        "        \"generation_error\":\n",
        "            (\n",
        "                f\"{type(final_exception).__name__}: \"\n",
        "                f\"{final_exception}\"\n",
        "            ),\n",
        "    }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Progress helper\n",
        "# ============================================================\n",
        "\n",
        "def refresh_checkpoint_counts():\n",
        "\n",
        "    results = (\n",
        "        checkpoint[\n",
        "            \"results\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    checkpoint[\n",
        "        \"completed_generations\"\n",
        "    ] = sum(\n",
        "        r.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"completed\"\n",
        "\n",
        "        for r in results\n",
        "    )\n",
        "\n",
        "\n",
        "    checkpoint[\n",
        "        \"failed_transport_generations\"\n",
        "    ] = sum(\n",
        "        r.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"transport_failure\"\n",
        "\n",
        "        for r in results\n",
        "    )\n",
        "\n",
        "\n",
        "    checkpoint[\n",
        "        \"permanent_api_failures\"\n",
        "    ] = sum(\n",
        "        r.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"permanent_api_failure\"\n",
        "\n",
        "        for r in results\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 14. Run orders 9–192\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"BEGINNING FROZEN RUN ORDERS 9–192\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "newly_processed = 0\n",
        "\n",
        "\n",
        "for _, row in (\n",
        "    remaining_df.iterrows()\n",
        "):\n",
        "\n",
        "    experiment_id = (\n",
        "        row[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    run_order = int(\n",
        "        row[\n",
        "            \"run_order\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Skip experiments already completed/permanent failure\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    current_finished_ids = {\n",
        "\n",
        "        result[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "\n",
        "        for result\n",
        "        in checkpoint[\n",
        "            \"results\"\n",
        "        ]\n",
        "\n",
        "        if result.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        in {\n",
        "            \"completed\",\n",
        "            \"permanent_api_failure\",\n",
        "        }\n",
        "    }\n",
        "\n",
        "\n",
        "    if experiment_id in (\n",
        "        current_finished_ids\n",
        "    ):\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Generate\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    print(\n",
        "        f\"\\n[{run_order}/192] \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"  Field:\",\n",
        "        row[\n",
        "            \"schema_path\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"  Variant:\",\n",
        "        row[\n",
        "            \"schema_variant\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"  Evidence:\",\n",
        "        row[\n",
        "            \"evidence_strength\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    result = run_one_experiment(\n",
        "        row\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # If this experiment had a previous transient failure,\n",
        "    # preserve it in history and replace active result.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    previous_same_id = [\n",
        "\n",
        "        r\n",
        "        for r in checkpoint[\n",
        "            \"results\"\n",
        "        ]\n",
        "\n",
        "        if (\n",
        "            r.get(\n",
        "                \"experiment_id\"\n",
        "            )\n",
        "            == experiment_id\n",
        "        )\n",
        "    ]\n",
        "\n",
        "\n",
        "    for previous in (\n",
        "        previous_same_id\n",
        "    ):\n",
        "\n",
        "        checkpoint[\n",
        "            \"results\"\n",
        "        ].remove(\n",
        "            previous\n",
        "        )\n",
        "\n",
        "        checkpoint[\n",
        "            \"transport_failure_history\"\n",
        "        ].append(\n",
        "            previous\n",
        "        )\n",
        "\n",
        "\n",
        "    checkpoint[\n",
        "        \"results\"\n",
        "    ].append(\n",
        "        result\n",
        "    )\n",
        "\n",
        "\n",
        "    refresh_checkpoint_counts()\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # CHECKPOINT AFTER EVERY EXPERIMENT\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    save_checkpoint(\n",
        "        checkpoint\n",
        "    )\n",
        "\n",
        "\n",
        "    newly_processed += 1\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"  Status:\",\n",
        "        result[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    if (\n",
        "        result[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "        == \"completed\"\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            \"  JSON valid:\",\n",
        "            result[\n",
        "                \"json_valid\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Scientific schema valid:\",\n",
        "            result[\n",
        "                \"scientific_schema_valid\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Schema errors:\",\n",
        "            result[\n",
        "                \"scientific_schema_error_count\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \"  Error:\",\n",
        "            result[\n",
        "                \"generation_error\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Compact progress every 10 NEW experiments\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    if (\n",
        "        newly_processed % 10\n",
        "        == 0\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            \"\\n\"\n",
        "            + \"=\" * 55\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"PROGRESS\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Completed:\",\n",
        "            checkpoint[\n",
        "                \"completed_generations\"\n",
        "            ],\n",
        "            \"/192\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Transport failures:\",\n",
        "            checkpoint[\n",
        "                \"failed_transport_generations\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"Permanent API failures:\",\n",
        "            checkpoint[\n",
        "                \"permanent_api_failures\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"=\" * 55\n",
        "        )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. Reload final checkpoint from disk\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    CHECKPOINT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    final_checkpoint = (\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "final_results_df = pd.DataFrame(\n",
        "    final_checkpoint[\n",
        "        \"results\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "if len(\n",
        "    final_results_df\n",
        ") > 0:\n",
        "\n",
        "    final_results_df = (\n",
        "        final_results_df\n",
        "        .sort_values(\n",
        "            \"run_order\"\n",
        "        )\n",
        "        .reset_index(\n",
        "            drop=True\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 16. Integrity checks\n",
        "# ============================================================\n",
        "\n",
        "# No active duplicate experiment IDs\n",
        "assert (\n",
        "    final_results_df[\n",
        "        \"experiment_id\"\n",
        "    ].duplicated().sum()\n",
        "    == 0\n",
        ")\n",
        "\n",
        "\n",
        "completed_count = int(\n",
        "    (\n",
        "        final_results_df[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "        == \"completed\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "transport_failure_count = int(\n",
        "    (\n",
        "        final_results_df[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "        == \"transport_failure\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "permanent_failure_count = int(\n",
        "    (\n",
        "        final_results_df[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "        == \"permanent_api_failure\"\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "json_valid_count = int(\n",
        "    (\n",
        "        final_results_df[\n",
        "            \"json_valid\"\n",
        "        ]\n",
        "        == True\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "scientific_valid_count = int(\n",
        "    (\n",
        "        final_results_df[\n",
        "            \"scientific_schema_valid\"\n",
        "        ]\n",
        "        == True\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 17. Coverage check\n",
        "# ============================================================\n",
        "\n",
        "expected_ids = set(\n",
        "    manifest_df[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "observed_ids = set(\n",
        "    final_results_df[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "missing_ids = sorted(\n",
        "    expected_ids\n",
        "    - observed_ids\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"FULL GENERATION STATUS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nActive checkpoint rows:\",\n",
        "    len(\n",
        "        final_results_df\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Completed model responses:\",\n",
        "    completed_count,\n",
        "    \"/192\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"JSON-valid responses:\",\n",
        "    json_valid_count,\n",
        "    \"/192\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Scientific-schema-valid responses:\",\n",
        "    scientific_valid_count,\n",
        "    \"/192\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Transport failures:\",\n",
        "    transport_failure_count\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Permanent API failures:\",\n",
        "    permanent_failure_count\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Missing experiment IDs:\",\n",
        "    len(\n",
        "        missing_ids\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "if missing_ids:\n",
        "\n",
        "    print(\n",
        "        \"\\nMissing IDs:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        missing_ids\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 18. Schema validity by variant\n",
        "# ============================================================\n",
        "\n",
        "completed_df = (\n",
        "    final_results_df[\n",
        "        final_results_df[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "        == \"completed\"\n",
        "    ]\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "validity_summary = (\n",
        "    completed_df\n",
        "    .groupby(\n",
        "        \"schema_variant\"\n",
        "    )\n",
        "    .agg(\n",
        "        completed=(\n",
        "            \"experiment_id\",\n",
        "            \"size\"\n",
        "        ),\n",
        "\n",
        "        json_valid=(\n",
        "            \"json_valid\",\n",
        "            \"sum\"\n",
        "        ),\n",
        "\n",
        "        scientific_schema_valid=(\n",
        "            \"scientific_schema_valid\",\n",
        "            \"sum\"\n",
        "        ),\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"STRUCTURAL VALIDITY BY SCHEMA VARIANT\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    validity_summary\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 19. Save full raw generation results\n",
        "# ============================================================\n",
        "\n",
        "FULL_RESULTS_CSV = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_generation_results_192_v1_1.csv\"\n",
        ")\n",
        "\n",
        "FULL_RESULTS_JSON = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_generation_results_192_v1_1.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# CSV-safe version\n",
        "csv_results_df = (\n",
        "    final_results_df.copy()\n",
        ")\n",
        "\n",
        "\n",
        "for column in [\n",
        "    \"parsed_json\",\n",
        "    \"scientific_schema_errors\",\n",
        "    \"transient_errors_before_success\",\n",
        "]:\n",
        "\n",
        "    if column in (\n",
        "        csv_results_df.columns\n",
        "    ):\n",
        "\n",
        "        csv_results_df[\n",
        "            column\n",
        "        ] = (\n",
        "            csv_results_df[\n",
        "                column\n",
        "            ]\n",
        "            .apply(\n",
        "                lambda x:\n",
        "                    json.dumps(\n",
        "                        x,\n",
        "                        ensure_ascii=False,\n",
        "                        sort_keys=True,\n",
        "                    )\n",
        "                    if isinstance(\n",
        "                        x,\n",
        "                        (\n",
        "                            dict,\n",
        "                            list,\n",
        "                        )\n",
        "                    )\n",
        "                    else x\n",
        "            )\n",
        "        )\n",
        "\n",
        "\n",
        "csv_results_df.to_csv(\n",
        "    FULL_RESULTS_CSV,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
        "    FULL_RESULTS_JSON,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        final_results_df\n",
        "        .where(\n",
        "            pd.notnull(\n",
        "                final_results_df\n",
        "            ),\n",
        "            None\n",
        "        )\n",
        "        .to_dict(\n",
        "            orient=\"records\"\n",
        "        ),\n",
        "        f,\n",
        "        indent=2,\n",
        "        ensure_ascii=False,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 20. Save generation-status summary\n",
        "# ============================================================\n",
        "\n",
        "GENERATION_SUMMARY_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_generation_status_summary_v1_1.json\"\n",
        ")\n",
        "\n",
        "\n",
        "generation_summary = {\n",
        "\n",
        "    \"protocol_version\":\n",
        "        protocol[\n",
        "            \"protocol_version\"\n",
        "        ],\n",
        "\n",
        "    \"generation_protocol_sha256\":\n",
        "        PROTOCOL_SHA256,\n",
        "\n",
        "    \"planned_generations\":\n",
        "        192,\n",
        "\n",
        "    \"active_checkpoint_rows\":\n",
        "        len(\n",
        "            final_results_df\n",
        "        ),\n",
        "\n",
        "    \"completed_model_responses\":\n",
        "        completed_count,\n",
        "\n",
        "    \"json_valid_responses\":\n",
        "        json_valid_count,\n",
        "\n",
        "    \"scientific_schema_valid_responses\":\n",
        "        scientific_valid_count,\n",
        "\n",
        "    \"transport_failures\":\n",
        "        transport_failure_count,\n",
        "\n",
        "    \"permanent_api_failures\":\n",
        "        permanent_failure_count,\n",
