        "        run_order_lookup\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    generation_manifest_df[\n",
        "        \"run_order\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    generation_manifest_df[\n",
        "        \"run_order\"\n",
        "    ].min()\n",
        "    == 1\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    generation_manifest_df[\n",
        "        \"run_order\"\n",
