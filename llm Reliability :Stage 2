        "    )\n",
        "\n",
        "\n",
        "STUDY2A_RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "STUDY2A_DATA_DIR = (\n",
        "    STUDY2A_DIR / \"data\"\n",
        ")\n",
        "\n",
        "\n",
        "PRE_REVIEW_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_smoke_semantic_review_pre_adjudication_8.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "review_df = pd.read_csv(\n",
        "    PRE_REVIEW_PATH\n",
        ")\n",
        "\n",
        "\n",
        "assert len(review_df) == 8\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Loaded 8 pre-adjudication smoke cases.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Verify experiment identities before adjudicating\n",
        "# ============================================================\n",
        "\n",
        "expected_experiments = {\n",
        "    \"EXP173\",\n",
        "    \"EXP033\",\n",
        "    \"EXP072\",\n",
        "    \"EXP006\",\n",
        "    \"EXP042\",\n",
        "    \"EXP137\",\n",
        "    \"EXP097\",\n",
        "    \"EXP160\",\n",
        "}\n",
        "\n",
        "\n",
        "assert (\n",
        "    set(\n",
        "        review_df[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "    )\n",
        "    == expected_experiments\n",
        ")\n",
        "\n",
        "\n",
        "# Critical cases\n",
        "checks = {\n",
        "\n",
        "    \"EXP006\": {\n",
        "        \"schema_path\":\n",
        "            \"medications[].action[]<item>\",\n",
        "        \"schema_variant\":\n",
        "            \"forced_required\",\n",
        "        \"evidence_strength\":\n",
        "            \"ambiguous\",\n",
        "    },\n",
        "\n",
        "    \"EXP042\": {\n",
        "        \"schema_path\":\n",
        "            \"medications[].action[]<item>\",\n",
        "        \"schema_variant\":\n",
        "            \"semantically_richer\",\n",
        "        \"evidence_strength\":\n",
        "            \"ambiguous\",\n",
        "    },\n",
        "\n",
        "    \"EXP137\": {\n",
        "        \"schema_path\":\n",
        "            \"follow_up.condition\",\n",
        "        \"schema_variant\":\n",
        "            \"semantically_richer\",\n",
        "        \"evidence_strength\":\n",
        "            \"ambiguous\",\n",
        "    },\n",
        "\n",
        "    \"EXP097\": {\n",
        "        \"schema_path\":\n",
        "            \"follow_up.condition\",\n",
        "        \"schema_variant\":\n",
        "            \"forced_required\",\n",
        "        \"evidence_strength\":\n",
        "            \"explicit\",\n",
        "    },\n",
        "\n",
        "    \"EXP173\": {\n",
        "        \"schema_path\":\n",
        "            \"symptoms[].severity\",\n",
        "        \"schema_variant\":\n",
        "            \"optional\",\n",
        "        \"evidence_strength\":\n",
        "            \"ambiguous\",\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "for experiment_id, expected in checks.items():\n",
        "\n",
        "    row = review_df[\n",
        "        review_df[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "        == experiment_id\n",
        "    ].iloc[0]\n",
        "\n",
        "\n",
        "    for key, value in (\n",
        "        expected.items()\n",
        "    ):\n",
        "\n",
        "        assert (\n",
        "            row[key] == value\n",
        "        ), (\n",
        "            f\"{experiment_id}: \"\n",
        "            f\"{key} mismatch\"\n",
        "        )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Smoke-test experiment identities verified.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Adjudication rubric\n",
        "#\n",
        "# IMPORTANT:\n",
        "#\n",
        "# expected_action is a frozen MECHANICAL benchmark.\n",
        "#\n",
        "# It is NOT by itself the definition of semantic correctness.\n",
        "#\n",
        "# A non-exact output can still be semantically faithful\n",
        "# when it preserves the source meaning without inventing facts.\n",
        "#\n",
        "# We do NOT modify the frozen gold.\n",
        "# ============================================================\n",
        "\n",
        "ADJUDICATION_RULES = {\n",
        "\n",
        "    \"semantic_correctness\":\n",
        "        (\n",
        "            \"Judge whether the target-field output preserves \"\n",
        "            \"the meaning supported by the source without \"\n",
        "            \"adding unsupported semantic commitments.\"\n",
        "        ),\n",
        "\n",
        "    \"mechanical_vs_semantic\":\n",
        "        (\n",
        "            \"Failure to exactly match expected_action or \"\n",
        "            \"expected_value is not automatically a semantic \"\n",
        "            \"error when the model output is a faithful \"\n",
        "            \"paraphrase or equally supported representation.\"\n",
        "        ),\n",
        "\n",
        "    \"unsupported_commitment\":\n",
        "        (\n",
        "            \"A non-null categorical/action value with no \"\n",
        "            \"source support is a semantic error.\"\n",
        "        ),\n",
        "\n",
        "    \"ambiguity\":\n",
        "        (\n",
        "            \"When evidence is genuinely underspecified, \"\n",
        "            \"multiple faithful representations may be \"\n",
        "            \"acceptable unless the model asserts an \"\n",
        "            \"unsupported stronger state.\"\n",
        "        ),\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Final adjudication decisions\n",
        "#\n",
        "# Only the five manually reviewed cases are hard-coded here.\n",
        "#\n",
        "# The 3 mechanically clear cases are handled separately below.\n",
        "# ============================================================\n",
        "\n",
        "MANUAL_DECISIONS = {\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # EXP173\n",
        "    #\n",
        "    # Source:\n",
        "    # \"somewhere between mild and moderate\"\n",
        "    #\n",
        "    # Output:\n",
        "    # \"mild to moderate\"\n",
        "    #\n",
        "    # Although frozen optional expectation was omission,\n",
        "    # severity is a free-text string. The output faithfully\n",
        "    # preserves the ambiguity rather than inventing a single\n",
        "    # stronger severity category.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP173\": {\n",
        "\n",
        "        \"final_semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"final_error_category\":\n",
        "            None,\n",
        "\n",
        "        \"final_mechanism\":\n",
        "            None,\n",
        "\n",
        "        \"manual_adjudication_note\":\n",
        "            (\n",
        "                \"Semantically acceptable. The source says \"\n",
        "                \"'somewhere between mild and moderate' and \"\n",
        "                \"the model returned 'mild to moderate'. \"\n",
        "                \"Although the frozen mechanical expectation \"\n",
        "                \"for the optional variant was omission, the \"\n",
        "                \"free-text severity field can faithfully \"\n",
        "                \"preserve this ambiguity. This is therefore \"\n",
        "                \"not counted as a semantic error.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # EXP006\n",
        "    #\n",
        "    # Source:\n",
        "    # Aspirin listed in chart; discuss next visit.\n",
        "    #\n",
        "    # Output:\n",
        "    # action = [\"continue\"]\n",
        "    #\n",
        "    # No clinician continuation instruction exists.\n",
        "    # Forced schema required a non-null action.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP006\": {\n",
        "\n",
        "        \"final_semantic_correct\":\n",
        "            False,\n",
        "\n",
        "        \"final_error_category\":\n",
        "            \"unsupported_inference\",\n",
        "\n",
        "        \"final_mechanism\":\n",
        "            \"schema_commitment_pressure\",\n",
        "\n",
        "        \"manual_adjudication_note\":\n",
        "            (\n",
        "                \"Semantic error. The transcript only states \"\n",
        "                \"that Aspirin remains listed in the chart and \"\n",
        "                \"may be discussed later. It does not instruct \"\n",
        "                \"the patient to continue Aspirin. The \"\n",
        "                \"forced-required schema provided no valid \"\n",
        "                \"abstention state and the model committed to \"\n",
        "                \"'continue', supporting an instance-level \"\n",
        "                \"schema-commitment-pressure mechanism.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # EXP042\n",
        "    #\n",
        "    # Same source as EXP006.\n",
        "    #\n",
        "    # Richer output correctly gave no medication action,\n",
        "    # but labelled evidence_status = historical_only.\n",
        "    #\n",
        "    # \"listed in chart\" does NOT establish historical-only.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP042\": {\n",
        "\n",
        "        \"final_semantic_correct\":\n",
        "            False,\n",
        "\n",
        "        \"final_error_category\":\n",
        "            \"status_certainty_error\",\n",
        "\n",
        "        \"final_mechanism\":\n",
        "            \"weak_or_ambiguous_source_evidence\",\n",
        "\n",
        "        \"manual_adjudication_note\":\n",
        "            (\n",
        "                \"Partial success but still a target-field \"\n",
        "                \"semantic error. The model correctly avoided \"\n",
        "                \"inventing a medication action, but classified \"\n",
        "                \"the evidence as 'historical_only'. The source \"\n",
        "                \"only says Aspirin is still listed in the chart \"\n",
        "                \"and does not establish that it is historical \"\n",
        "                \"only. The richer schema had an 'ambiguous' \"\n",
        "                \"state available, so the categorical evidence \"\n",
        "                \"status is overcommitted.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # EXP137\n",
        "    #\n",
        "    # Source:\n",
        "    # \"depending on how things go\"\n",
        "    #\n",
        "    # Gold category = uncertain\n",
        "    # Output category = other\n",
        "    # Exact trigger text preserved.\n",
        "    #\n",
        "    # We treat this as semantically acceptable because the\n",
        "    # source is genuinely underspecified and the exact text\n",
        "    # remains intact.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP137\": {\n",
        "\n",
        "        \"final_semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"final_error_category\":\n",
        "            None,\n",
        "\n",
        "        \"final_mechanism\":\n",
        "            None,\n",
        "\n",
        "        \"manual_adjudication_note\":\n",
        "            (\n",
        "                \"Semantically acceptable non-exact encoding. \"\n",
        "                \"The model preserved the exact trigger text \"\n",
        "                \"'depending on how things go'. The categorical \"\n",
        "                \"choice 'other' differs from the frozen \"\n",
        "                \"'uncertain' label, but the source itself is \"\n",
        "                \"underspecified and the output does not add a \"\n",
        "                \"false specific trigger.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # EXP097\n",
        "    #\n",
        "    # Source:\n",
        "    # Return sooner if fever develops.\n",
        "    #\n",
        "    # condition = \"fever\"\n",
        "    # timing_text = \"sooner\"\n",
        "    # full instruction also preserved elsewhere.\n",
        "    #\n",
        "    # This is a faithful decomposition, not semantic loss.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP097\": {\n",
        "\n",
        "        \"final_semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"final_error_category\":\n",
        "            None,\n",
        "\n",
        "        \"final_mechanism\":\n",
        "            None,\n",
        "\n",
        "        \"manual_adjudication_note\":\n",
        "            (\n",
        "                \"Semantically acceptable compression. \"\n",
        "                \"The target condition 'fever' preserves the \"\n",
        "                \"trigger concept, while 'sooner' is preserved \"\n",
        "                \"in follow_up.timing_text and the full \"\n",
        "                \"conditional instruction is also retained in \"\n",
        "                \"patient_instructions. The difference from \"\n",
        "                \"'if fever develops' is representational rather \"\n",
        "                \"than a target-field semantic error.\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "assert len(\n",
        "    MANUAL_DECISIONS\n",
        ") == 5\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Initialize final columns cleanly\n",
        "# ============================================================\n",
        "\n",
        "review_df[\n",
        "    \"final_semantic_correct\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_error_category\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"final_mechanism\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"manual_adjudication_note\"\n",
        "] = None\n",
        "\n",
        "review_df[\n",
        "    \"adjudication_status\"\n",
        "] = None\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Mechanically clear cases\n",
        "#\n",
        "# Cell 15 identified 3 exact/mechanically clear cases:\n",
        "#\n",
        "# EXP033\n",
        "# EXP072\n",
        "# EXP160\n",
        "# ============================================================\n",
        "\n",
        "CLEAR_IDS = {\n",
        "    \"EXP033\",\n",
        "    \"EXP072\",\n",
        "    \"EXP160\",\n",
        "}\n",
        "\n",
        "\n",
        "for experiment_id in CLEAR_IDS:\n",
        "\n",
        "    mask = (\n",
        "        review_df[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "        == experiment_id\n",
        "    )\n",
        "\n",
        "    assert mask.sum() == 1\n",
        "\n",
        "\n",
        "    row = review_df[\n",
        "        mask\n",
        "    ].iloc[0]\n",
        "\n",
        "\n",
        "    assert (\n",
        "        row[\n",
        "            \"mechanical_outcome\"\n",
        "        ]\n",
        "        == \"matches_frozen_expectation\"\n",
        "    )\n",
        "\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"final_semantic_correct\"\n",
        "    ] = True\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"final_error_category\"\n",
        "    ] = None\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"final_mechanism\"\n",
        "    ] = None\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"manual_adjudication_note\"\n",
        "    ] = (\n",
        "        \"Mechanically clear match to the \"\n",
        "        \"pre-generation frozen semantic expectation.\"\n",
        "    )\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"adjudication_status\"\n",
        "    ] = \"finalized\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Apply manual decisions\n",
        "# ============================================================\n",
        "\n",
        "for (\n",
        "    experiment_id,\n",
        "    decision\n",
        ") in MANUAL_DECISIONS.items():\n",
        "\n",
        "    mask = (\n",
        "        review_df[\n",
        "            \"experiment_id\"\n",
        "        ]\n",
        "        == experiment_id\n",
        "    )\n",
        "\n",
        "\n",
        "    assert mask.sum() == 1\n",
        "\n",
        "\n",
        "    for (\n",
        "        column,\n",
        "        value\n",
        "    ) in decision.items():\n",
        "\n",
        "        review_df.loc[\n",
        "            mask,\n",
        "            column\n",
        "        ] = value\n",
        "\n",
        "\n",
        "    review_df.loc[\n",
        "        mask,\n",
        "        \"adjudication_status\"\n",
        "    ] = \"finalized\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Validate all 8 are finalized\n",
        "# ============================================================\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"adjudication_status\"\n",
        "    ]\n",
        "    .eq(\n",
        "        \"finalized\"\n",
        "    )\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"final_semantic_correct\"\n",
        "    ]\n",
        "    .notna()\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    len(\n",
        "        review_df\n",
        "    )\n",
        "    == 8\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ All 8 smoke-test cases finalized.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Convert correctness to proper Boolean\n",
        "# ============================================================\n",
        "\n",
        "review_df[\n",
        "    \"final_semantic_correct\"\n",
        "] = (\n",
        "    review_df[\n",
        "        \"final_semantic_correct\"\n",
        "    ]\n",
        "    .astype(bool)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Final results table\n",
        "# ============================================================\n",
        "\n",
        "final_table = (\n",
        "    review_df[\n",
        "        [\n",
        "            \"run_order\",\n",
        "            \"experiment_id\",\n",
        "            \"scenario_id\",\n",
        "            \"schema_path\",\n",
        "            \"schema_variant\",\n",
        "            \"evidence_strength\",\n",
        "            \"expected_action\",\n",
        "            \"actual_target_value_json\",\n",
        "            \"final_semantic_correct\",\n",
        "            \"final_error_category\",\n",
        "            \"final_mechanism\",\n",
        "        ]\n",
        "    ]\n",
        "    .sort_values(\n",
        "        \"run_order\"\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"FINAL SMOKE-TEST ADJUDICATION\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    final_table\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Summary\n",
        "# ============================================================\n",
        "\n",
        "correct_count = int(\n",
        "    review_df[\n",
        "        \"final_semantic_correct\"\n",
        "    ].sum()\n",
        ")\n",
        "\n",
        "\n",
        "error_count = (\n",
        "    len(review_df)\n",
        "    - correct_count\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nSemantically correct:\",\n",
        "    correct_count,\n",
        "    \"/8\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Semantic errors:\",\n",
        "    error_count,\n",
        "    \"/8\"\n",
        ")\n",
        "\n",
        "\n",
        "error_summary = (\n",
        "    review_df[\n",
        "        review_df[\n",
        "            \"final_semantic_correct\"\n",
        "        ]\n",
        "        == False\n",
        "    ]\n",
        "    .groupby(\n",
        "        [\n",
        "            \"final_error_category\",\n",
        "            \"final_mechanism\",\n",
        "        ],\n",
        "        dropna=False,\n",
        "    )\n",
        "    .size()\n",
        "    .reset_index(\n",
        "        name=\"n\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SMOKE-TEST ERROR SUMMARY\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    error_summary\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Smoke-test gate\n",
        "#\n",
        "# This does NOT claim scientific success.\n",
        "#\n",
        "# It only says the generation/evaluation pipeline is\n",
        "# functioning well enough to continue the frozen experiment.\n",
        "# ============================================================\n",
        "\n",
        "SMOKE_PIPELINE_GATE = {\n",
        "\n",
        "    \"completed_model_responses\":\n",
        "        8,\n",
        "\n",
        "    \"json_valid\":\n",
        "        8,\n",
        "\n",
        "    \"scientific_schema_valid\":\n",
        "        8,\n",
        "\n",
        "    \"semantic_adjudications_complete\":\n",
        "        8,\n",
        "\n",
        "    \"semantic_correct\":\n",
        "        correct_count,\n",
        "\n",
        "    \"semantic_errors\":\n",
        "        error_count,\n",
        "\n",
        "    \"transport_working\":\n",
        "        True,\n",
        "\n",
        "    \"schema_transport_working\":\n",
        "        True,\n",
        "\n",
        "    \"evaluation_pipeline_working\":\n",
        "        True,\n",
        "\n",
        "    \"protocol_bug_detected\":\n",
        "        False,\n",
        "\n",
        "    \"approved_to_continue_frozen_generation_protocol\":\n",
        "        True,\n",
        "\n",
        "    \"note\":\n",
        "        (\n",
        "            \"Approval means only that the frozen generation \"\n",
        "            \"and evaluation pipeline is functioning. It is \"\n",
        "            \"not a conclusion about the Study 2A hypotheses.\"\n",
        "        ),\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Save adjudicated results\n",
        "# ============================================================\n",
        "\n",
        "FINAL_REVIEW_CSV = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_smoke_semantic_review_final_8.csv\"\n",
