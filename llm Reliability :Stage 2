        "    ] == 1\n",
        ").all()\n",
        "\n",
        "assert (\n",
        "    fairness_check[\n",
        "        \"prompt_hashes\"\n",
        "    ] == 1\n",
        ").all()\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\n✅ Same transcript + same prompt verified \"\n",
        "    \"across all four schema variants.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 14. Verify randomized order is balanced rather than grouped\n",
        "# ============================================================\n",
        "\n",
        "run_preview_df = (\n",
        "    generation_manifest_df\n",
        "    .sort_values(\n",
        "        \"run_order\"\n",
        "    )[\n",
        "        [\n",
        "            \"run_order\",\n",
        "            \"experiment_id\",\n",
