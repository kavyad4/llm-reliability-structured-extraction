        "# ------------------------------------------------------------\n",
        "SEARCH_TERMS = [\n",
        "    \"transcript\",\n",
        "    \"dialogue\",\n",
        "    \"conversation\",\n",
        "    \"reference\",\n",
        "    \"reference_note\",\n",
        "    \"source\",\n",
        "    \"evidence\",\n",
        "    \"note\",\n",
        "    \"notes\",\n",
        "]\n",
        "\n",
        "def find_interesting_keys(obj, path=\"root\", results=None):\n",
        "    if results is None:\n",
        "        results = []\n",
        "\n",
        "    if isinstance(obj, dict):\n",
        "        for key, value in obj.items():\n",
        "\n",
        "            current_path = f\"{path}.{key}\"\n",
        "            key_lower = str(key).lower()\n",
        "\n",
        "            if any(term in key_lower for term in SEARCH_TERMS):\n",
        "                results.append(\n",
        "                    {\n",
        "                        \"path\": current_path,\n",
        "                        \"key\": key,\n",
        "                        \"value_type\": type(value).__name__,\n",
        "                        \"preview\": (\n",
        "                            str(value)[:250].replace(\"\\n\", \" \")\n",
        "                            if not isinstance(value, (dict, list))\n",
        "                            else f\"<{type(value).__name__}>\"\n",
        "                        ),\n",
        "                    }\n",
        "                )\n",
        "\n",
        "            find_interesting_keys(\n",
        "                value,\n",
        "                current_path,\n",
        "                results\n",
        "            )\n",
        "\n",
        "    elif isinstance(obj, list):\n",
        "        for i, value in enumerate(obj):\n",
        "            find_interesting_keys(\n",
        "                value,\n",
        "                f\"{path}[{i}]\",\n",
        "                results\n",
        "            )\n",
        "\n",
        "    return results\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Search every Study 1 JSON artifact for transcript-like\n",
        "#    information.\n",
        "# ------------------------------------------------------------\n",
        "json_source_search = []\n",
        "\n",
        "for path in sorted(STUDY1_DIR.glob(\"*.json\")):\n",
        "\n",
        "    try:\n",
        "        with open(path, \"r\", encoding=\"utf-8\") as f:\n",
        "            obj = json.load(f)\n",
        "\n",
        "        found = find_interesting_keys(obj)\n",
