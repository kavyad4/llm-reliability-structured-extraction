        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# CELL 20\n",
        "# Build paired scenario-level review packet\n",
        "#\n",
        "# Purpose:\n",
        "# Review remaining semantic cases in paired form:\n",
        "#\n",
        "#   same source scenario\n",
        "#       × forced_required\n",
        "#       × required_nullable\n",
        "#       × optional\n",
        "#       × semantically_richer\n",
        "#\n",
        "# This preserves the controlled-experiment structure and\n",
        "# prevents adjudicating each output without seeing its\n",
        "# paired schema variants.\n",
        "#\n",
        "# NO Gemini calls.\n",
        "# NO adjudication changes.\n",
        "# NO frozen-gold changes.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — PAIRED SCENARIO ADJUDICATION PACKET\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "FULL_REVIEW_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_after_high_confidence_pass.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load Cell-19 results\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    FULL_REVIEW_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "pending_mask = (\n",
        "    review_df[\n",
        "        \"adjudication_status\"\n",
        "    ]\n",
        "    == \"pending_manual_review\"\n",
        ")\n",
        "\n",
        "\n",
        "pending_df = (\n",
        "    review_df[\n",
        "        pending_mask\n",
        "    ]\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "assert len(pending_df) == 61\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Full review loaded:\",\n",
        "    len(review_df),\n",
        "    \"experiments\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Remaining pending cases:\",\n",
        "    len(pending_df)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Identify scenarios containing ≥1 pending experiment\n",
        "# ============================================================\n",
        "\n",
        "pending_scenario_ids = sorted(\n",
        "    pending_df[\n",
        "        \"scenario_id\"\n",
        "    ].unique()\n",
        ")\n",
        "\n",
        "\n",
        "scenario_count = len(\n",
        "    pending_scenario_ids\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Unique source scenarios requiring review:\",\n",
        "    scenario_count\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Pull ALL FOUR variants for each pending scenario\n",
        "#\n",
        "# Important:\n",
        "# even if one variant was already finalized, include it\n",
        "# so adjudication remains paired and contextual.\n",
        "# ============================================================\n",
        "\n",
        "paired_df = (\n",
        "    review_df[\n",
        "        review_df[\n",
        "            \"scenario_id\"\n",
        "        ].isin(\n",
        "            pending_scenario_ids\n",
        "        )\n",
        "    ]\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "# Each scenario must have exactly four controlled variants.\n",
        "scenario_sizes = (\n",
        "    paired_df\n",
        "    .groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "    .size()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    scenario_sizes\n",
        "    == 4\n",
        ").all()\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ All pending scenarios have their \"\n",
        "    \"four paired schema variants available.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Variant ordering\n",
        "# ============================================================\n",
        "\n",
        "VARIANT_ORDER = {\n",
        "    \"forced_required\": 1,\n",
        "    \"required_nullable\": 2,\n",
        "    \"optional\": 3,\n",
        "    \"semantically_richer\": 4,\n",
        "}\n",
        "\n",
        "\n",
        "paired_df[\n",
        "    \"variant_order\"\n",
        "] = (\n",
        "    paired_df[\n",
        "        \"schema_variant\"\n",
        "    ].map(\n",
        "        VARIANT_ORDER\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    paired_df[\n",
        "        \"variant_order\"\n",
        "    ].notna()\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "paired_df = (\n",
        "    paired_df\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"scenario_number\",\n",
        "            \"variant_order\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Verify source/gold consistency within scenario\n",
        "#\n",
        "# Across four variants:\n",
        "# - source text should be identical\n",
        "# - evidence strength should be identical\n",
        "# - target entity should be identical\n",
        "#\n",
        "# Expected action/value CAN differ by schema variant.\n",
        "# ============================================================\n",
        "\n",
        "scenario_integrity_rows = []\n",
        "\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "):\n",
        "\n",
        "    scenario_integrity_rows.append(\n",
        "        {\n",
        "            \"scenario_id\":\n",
        "                scenario_id,\n",
        "\n",
        "            \"n_variants\":\n",
        "                len(group),\n",
        "\n",
        "            \"source_text_versions\":\n",
        "                group[\n",
        "                    \"scenario_text\"\n",
        "                ].nunique(\n",
        "                    dropna=False\n",
        "                ),\n",
        "\n",
        "            \"evidence_strength_versions\":\n",
        "                group[\n",
        "                    \"evidence_strength\"\n",
        "                ].nunique(\n",
        "                    dropna=False\n",
        "                ),\n",
        "\n",
        "            \"schema_path_versions\":\n",
        "                group[\n",
        "                    \"schema_path\"\n",
        "                ].nunique(\n",
        "                    dropna=False\n",
        "                ),\n",
        "\n",
        "            \"target_entity_versions\":\n",
        "                group[\n",
        "                    \"target_entity\"\n",
        "                ].astype(str)\n",
        "                .nunique(\n",
        "                    dropna=False\n",
        "                ),\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "integrity_df = pd.DataFrame(\n",
        "    scenario_integrity_rows\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    integrity_df[\n",
        "        \"n_variants\"\n",
        "    ]\n",
        "    .eq(4)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    integrity_df[\n",
        "        \"source_text_versions\"\n",
        "    ]\n",
        "    .eq(1)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    integrity_df[\n",
        "        \"evidence_strength_versions\"\n",
        "    ]\n",
        "    .eq(1)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    integrity_df[\n",
        "        \"schema_path_versions\"\n",
        "    ]\n",
        "    .eq(1)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    integrity_df[\n",
        "        \"target_entity_versions\"\n",
        "    ]\n",
        "    .eq(1)\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Source text is identical across paired variants.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Evidence condition is identical across paired variants.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Target field/entity is consistent within every scenario.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Scenario-level summary\n",
        "# ============================================================\n",
        "\n",
        "scenario_summary_rows = []\n",
        "\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\",\n",
        "        sort=False,\n",
        "    )\n",
        "):\n",
        "\n",
        "    first = (\n",
        "        group.iloc[0]\n",
        "    )\n",
        "\n",
        "\n",
        "    pending_group = (\n",
        "        group[\n",
        "            group[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "            == \"pending_manual_review\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    finalized_group = (\n",
        "        group[\n",
        "            group[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "            != \"pending_manual_review\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    scenario_summary_rows.append(\n",
        "        {\n",
        "            \"scenario_id\":\n",
        "                scenario_id,\n",
        "\n",
        "            \"scenario_number\":\n",
        "                first[\n",
        "                    \"scenario_number\"\n",
        "                ],\n",
        "\n",
        "            \"schema_path\":\n",
        "                first[\n",
        "                    \"schema_path\"\n",
        "                ],\n",
        "\n",
        "            \"evidence_strength\":\n",
        "                first[\n",
        "                    \"evidence_strength\"\n",
        "                ],\n",
        "\n",
        "            \"target_entity\":\n",
        "                first[\n",
        "                    \"target_entity\"\n",
        "                ],\n",
        "\n",
        "            \"pending_variants\":\n",
        "                len(\n",
        "                    pending_group\n",
        "                ),\n",
        "\n",
        "            \"already_finalized_variants\":\n",
        "                len(\n",
        "                    finalized_group\n",
        "                ),\n",
        "\n",
        "            \"scenario_text\":\n",
        "                first[\n",
        "                    \"scenario_text\"\n",
        "                ],\n",
        "\n",
        "            \"gold_reason\":\n",
        "                first[\n",
        "                    \"gold_reason\"\n",
        "                ],\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "scenario_summary_df = (\n",
        "    pd.DataFrame(\n",
        "        scenario_summary_rows\n",
        "    )\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"scenario_number\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SCENARIOS REQUIRING SEMANTIC REVIEW\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "display(\n",
        "    scenario_summary_df[\n",
        "        [\n",
        "            \"scenario_id\",\n",
        "            \"scenario_number\",\n",
        "            \"schema_path\",\n",
        "            \"evidence_strength\",\n",
        "            \"pending_variants\",\n",
        "            \"already_finalized_variants\",\n",
        "        ]\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Summary by field/evidence\n",
        "# ============================================================\n",
        "\n",
        "scenario_breakdown = (\n",
        "    scenario_summary_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"evidence_strength\",\n",
        "        ]\n",
        "    )\n",
        "    .size()\n",
        "    .reset_index(\n",
        "        name=\"scenarios_n\"\n",
        "    )\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"evidence_strength\",\n",
        "        ]\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"PENDING SCENARIOS BY FIELD × EVIDENCE\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    scenario_breakdown\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Build machine-readable paired packet\n",
        "# ============================================================\n",
        "\n",
        "packet_records = []\n",
        "\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\",\n",
        "        sort=False,\n",
        "    )\n",
        "):\n",
        "\n",
        "    group = (\n",
        "        group\n",
        "        .sort_values(\n",
        "            \"variant_order\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    first = group.iloc[0]\n",
        "\n",
        "\n",
        "    variants = []\n",
        "\n",
        "\n",
        "    for _, row in (\n",
        "        group.iterrows()\n",
        "    ):\n",
        "\n",
        "        variants.append(\n",
        "            {\n",
        "                \"experiment_id\":\n",
        "                    row[\n",
        "                        \"experiment_id\"\n",
        "                    ],\n",
        "\n",
        "                \"run_order\":\n",
        "                    int(\n",
        "                        row[\n",
        "                            \"run_order\"\n",
        "                        ]\n",
        "                    ),\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_action\":\n",
        "                    row[\n",
        "                        \"expected_action\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_value_json\":\n",
        "                    row[\n",
        "                        \"expected_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"actual_target_value_json\":\n",
        "                    row[\n",
        "                        \"actual_target_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"target_snapshot_json\":\n",
        "                    row[\n",
        "                        \"target_snapshot_json\"\n",
        "                    ],\n",
        "\n",
        "                \"mechanical_outcome\":\n",
        "                    row[\n",
        "                        \"mechanical_outcome\"\n",
        "                    ],\n",
        "\n",
        "                \"mechanism_signal\":\n",
        "                    row.get(\n",
        "                        \"mechanism_signal\"\n",
        "                    ),\n",
        "\n",
        "                \"adjudication_status\":\n",
        "                    row[\n",
        "                        \"adjudication_status\"\n",
        "                    ],\n",
        "\n",
        "                \"final_semantic_correct\":\n",
        "                    row.get(\n",
        "                        \"final_semantic_correct\"\n",
        "                    ),\n",
        "\n",
        "                \"final_error_category\":\n",
        "                    row.get(\n",
        "                        \"final_error_category\"\n",
        "                    ),\n",
        "\n",
        "                \"final_mechanism\":\n",
        "                    row.get(\n",
        "                        \"final_mechanism\"\n",
        "                    ),\n",
        "\n",
        "                \"adjudication_rule_id\":\n",
        "                    row.get(\n",
        "                        \"adjudication_rule_id\"\n",
        "                    ),\n",
        "\n",
        "                \"adjudication_note\":\n",
        "                    row.get(\n",
        "                        \"manual_adjudication_note\"\n",
        "                    ),\n",
        "            }\n",
        "        )\n",
        "\n",
        "\n",
        "    packet_records.append(\n",
        "        {\n",
        "            \"scenario_id\":\n",
        "                scenario_id,\n",
        "\n",
        "            \"scenario_number\":\n",
        "                first[\n",
        "                    \"scenario_number\"\n",
        "                ],\n",
        "\n",
        "            \"schema_path\":\n",
        "                first[\n",
        "                    \"schema_path\"\n",
        "                ],\n",
        "\n",
        "            \"evidence_strength\":\n",
        "                first[\n",
        "                    \"evidence_strength\"\n",
        "                ],\n",
        "\n",
        "            \"target_entity\":\n",
        "                first[\n",
        "                    \"target_entity\"\n",
        "                ],\n",
        "\n",
        "            \"scenario_text\":\n",
        "                first[\n",
        "                    \"scenario_text\"\n",
        "                ],\n",
        "\n",
        "            \"evidence_summary\":\n",
        "                first[\n",
        "                    \"evidence_summary\"\n",
        "                ],\n",
        "\n",
        "            \"gold_reason\":\n",
        "                first[\n",
        "                    \"gold_reason\"\n",
        "                ],\n",
        "\n",
        "            \"pending_variant_count\":\n",
        "                int(\n",
        "                    (\n",
        "                        group[\n",
        "                            \"adjudication_status\"\n",
        "                        ]\n",
        "                        == \"pending_manual_review\"\n",
        "                    ).sum()\n",
        "                ),\n",
        "\n",
        "            \"variants\":\n",
        "                variants,\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Save full paired packet\n",
        "# ============================================================\n",
        "\n",
        "PAIRED_PACKET_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_paired_semantic_adjudication_packet.json\"\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
        "    PAIRED_PACKET_PATH,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        packet_records,\n",
        "        f,\n",
        "        indent=2,\n",
        "        ensure_ascii=False,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "\n",
        "SCENARIO_SUMMARY_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_pending_scenario_summary.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "scenario_summary_df.to_csv(\n",
        "    SCENARIO_SUMMARY_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Create FIELD-SPECIFIC packets\n",
        "# ============================================================\n",
        "\n",
        "field_files = {}\n",
        "\n",
        "\n",
        "for schema_path in sorted(\n",
        "    paired_df[\n",
        "        \"schema_path\"\n",
        "    ].unique()\n",
        "):\n",
        "\n",
        "    safe_name = (\n",
        "        schema_path\n",
        "        .replace(\"[]\", \"\")\n",
        "        .replace(\"<item>\", \"item\")\n",
        "        .replace(\".\", \"_\")\n",
        "        .replace(\"[\", \"\")\n",
        "        .replace(\"]\", \"\")\n",
        "        .replace(\"/\", \"_\")\n",
        "    )\n",
        "\n",
        "\n",
        "    field_packet = [\n",
        "\n",
        "        record\n",
        "\n",
        "        for record\n",
        "        in packet_records\n",
        "\n",
        "        if record[\n",
        "            \"schema_path\"\n",
        "        ]\n",
        "        == schema_path\n",
        "    ]\n",
        "\n",
        "\n",
        "    field_path = (\n",
        "        RESULTS_DIR\n",
        "        / (\n",
        "            \"study2a_paired_review_\"\n",
        "            + safe_name\n",
        "            + \".json\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    with open(\n",
        "        field_path,\n",
        "        \"w\",\n",
        "        encoding=\"utf-8\"\n",
        "    ) as f:\n",
        "\n",
        "        json.dump(\n",
        "            field_packet,\n",
        "            f,\n",
        "            indent=2,\n",
        "            ensure_ascii=False,\n",
        "            default=str,\n",
        "        )\n",
        "\n",
        "\n",
        "    field_files[\n",
        "        schema_path\n",
        "    ] = str(\n",
        "        field_path\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 12. Print FIRST review batch\n",
        "#\n",
        "# Start with medication action because this field directly\n",
        "# tests schema-commitment pressure observed in Study 1.\n",
        "#\n",
        "# Print all pending medication scenarios, but paired across\n",
        "# all four schema variants.\n",
        "# ============================================================\n",
        "\n",
        "MEDICATION_FIELD = (\n",
        "    \"medications[].action[]<item>\"\n",
        ")\n",
        "\n",
        "\n",
        "medication_records = [\n",
        "\n",
        "    record\n",
        "\n",
        "    for record\n",
        "    in packet_records\n",
        "\n",
        "    if record[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "    == MEDICATION_FIELD\n",
        "]\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"FIRST REVIEW BATCH — MEDICATION ACTION\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "for record in (\n",
        "    medication_records\n",
        "):\n",
        "\n",
        "    print(\n",
        "        \"\\n\"\n",
        "        + \"#\" * 110\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"SCENARIO:\",\n",
        "        record[\n",
        "            \"scenario_id\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"EVIDENCE:\",\n",
        "        record[\n",
        "            \"evidence_strength\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"TARGET ENTITY:\",\n",
        "        record[\n",
        "            \"target_entity\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nSOURCE:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        record[\n",
        "            \"scenario_text\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nFROZEN GOLD REASON:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        record[\n",
        "            \"gold_reason\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \"\\nPAIRED VARIANTS:\"\n",
        "    )\n",
        "\n",
        "\n",
        "    for variant in (\n",
        "        record[\n",
        "            \"variants\"\n",
        "        ]\n",
        "    ):\n",
        "\n",
        "        print(\n",
        "            \"\\n  ---\",\n",
        "            variant[\n",
        "                \"schema_variant\"\n",
        "            ],\n",
        "            \"---\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Experiment:\",\n",
        "            variant[\n",
        "                \"experiment_id\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Expected action:\",\n",
        "            variant[\n",
        "                \"expected_action\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Expected value:\",\n",
        "            variant[\n",
        "                \"expected_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Actual value:\",\n",
        "            variant[\n",
        "                \"actual_target_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Mechanical outcome:\",\n",
        "            variant[\n",
        "                \"mechanical_outcome\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Current status:\",\n",
        "            variant[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        if (\n",
        "            variant[\n",
        "                \"adjudication_status\"\n",
        "            ]\n",
        "            != \"pending_manual_review\"\n",
        "        ):\n",
        "\n",
        "            print(\n",
        "                \"  Existing semantic correct:\",\n",
        "                variant[\n",
        "                    \"final_semantic_correct\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"  Existing error category:\",\n",
        "                variant[\n",
        "                    \"final_error_category\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"  Existing mechanism:\",\n",
        "                variant[\n",
        "                    \"final_mechanism\"\n",
        "                ]\n",
        "            )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 13. Final counts\n",
        "# ============================================================\n",
        "\n",
        "med_pending = int(\n",
        "    (\n",
        "        pending_df[\n",
        "            \"schema_path\"\n",
        "        ]\n",
        "        == MEDICATION_FIELD\n",
        "    ).sum()\n",
        ")\n",
        "\n",
        "\n",
        "med_scenarios = len(\n",
        "    medication_records\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"CELL 20 COMPLETE\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nTotal pending experiments:\",\n",
        "    len(\n",
        "        pending_df\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Unique pending source scenarios:\",\n",
        "    scenario_count\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\nMedication pending experiments:\",\n",
        "    med_pending\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Medication source scenarios requiring review:\",\n",
        "    med_scenarios\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nFull paired packet:\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    PAIRED_PACKET_PATH\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nScenario summary:\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    SCENARIO_SUMMARY_PATH\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nField-specific packets:\"\n",
        ")\n",
        "\n",
        "\n",
        "for field, path in (\n",
        "    field_files.items()\n",
        "):\n",
        "\n",
        "    print(\n",
        "        f\"  {field}:\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"    {path}\"\n",
        "    )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\n✅ No adjudication decisions were changed.\"\n",
        ")\n",
