        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — PAIRED FOLLOW-UP CONDITION REVIEW\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "INPUT_PATH = (\n",
        "    RESULTS_DIR\n",
        "    / \"study2a_full_semantic_review_after_severity_adjudication.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load current canonical review\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    INPUT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    review_df = pd.DataFrame(\n",
        "        json.load(f)\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(review_df) == 192\n",
        "\n",
        "\n",
        "FOLLOWUP_FIELD = (\n",
        "    \"follow_up.condition\"\n",
        ")\n",
        "\n",
        "\n",
        "followup_df = review_df[\n",
        "    review_df[\n",
        "        \"schema_path\"\n",
        "    ]\n",
        "    == FOLLOWUP_FIELD\n",
        "].copy()\n",
        "\n",
        "\n",
        "pending_followup_df = followup_df[\n",
        "    followup_df[\n",
        "        \"adjudication_status\"\n",
        "    ]\n",
        "    == \"pending_manual_review\"\n",
        "].copy()\n",
        "\n",
        "\n",
        "assert len(\n",
        "    pending_followup_df\n",
        ") == 15\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Pending follow-up cases:\",\n",
        "    len(\n",
        "        pending_followup_df\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Identify scenarios containing pending follow-up cases\n",
        "# ============================================================\n",
        "\n",
        "pending_scenarios = sorted(\n",
        "    pending_followup_df[\n",
        "        \"scenario_id\"\n",
        "    ].unique()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Pending follow-up scenarios:\",\n",
        "    len(\n",
        "        pending_scenarios\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Recover all four variants for every scenario\n",
        "# ============================================================\n",
        "\n",
        "paired_df = followup_df[\n",
        "    followup_df[\n",
        "        \"scenario_id\"\n",
        "    ].isin(\n",
        "        pending_scenarios\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "scenario_sizes = (\n",
        "    paired_df\n",
        "    .groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "    .size()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    scenario_sizes\n",
        "    == 4\n",
        ").all()\n",
        "\n",
        "\n",
        "VARIANT_ORDER = {\n",
        "    \"forced_required\": 1,\n",
        "    \"required_nullable\": 2,\n",
        "    \"optional\": 3,\n",
        "    \"semantically_richer\": 4,\n",
        "}\n",
        "\n",
        "\n",
        "paired_df[\n",
        "    \"_variant_order\"\n",
        "] = (\n",
        "    paired_df[\n",
        "        \"schema_variant\"\n",
        "    ].map(\n",
        "        VARIANT_ORDER\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    paired_df[\n",
        "        \"_variant_order\"\n",
        "    ].notna()\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "paired_df = (\n",
        "    paired_df\n",
        "    .sort_values(\n",
        "        [\n",
        "            \"scenario_number\",\n",
        "            \"_variant_order\",\n",
        "        ]\n",
        "    )\n",
        "    .reset_index(\n",
        "        drop=True\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Four paired variants recovered \"\n",
        "    \"for every pending follow-up scenario.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Verify source consistency within scenario\n",
        "# ============================================================\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\"\n",
        "    )\n",
        "):\n",
        "\n",
        "    assert (\n",
        "        group[\n",
        "            \"scenario_text\"\n",
        "        ].nunique(\n",
        "            dropna=False\n",
        "        )\n",
        "        == 1\n",
        "    )\n",
        "\n",
        "    assert (\n",
        "        group[\n",
        "            \"evidence_strength\"\n",
        "        ].nunique(\n",
        "            dropna=False\n",
        "        )\n",
        "        == 1\n",
        "    )\n",
        "\n",
        "    assert (\n",
        "        group[\n",
        "            \"schema_path\"\n",
        "        ].nunique(\n",
        "            dropna=False\n",
        "        )\n",
        "        == 1\n",
        "    )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Source/evidence consistency verified \"\n",
        "    \"within every paired scenario.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Build packet\n",
        "# ============================================================\n",
        "\n",
        "packet = []\n",
        "\n",
        "\n",
        "for scenario_id, group in (\n",
        "    paired_df.groupby(\n",
        "        \"scenario_id\",\n",
        "        sort=False,\n",
        "    )\n",
        "):\n",
        "\n",
        "    group = (\n",
        "        group\n",
        "        .sort_values(\n",
        "            \"_variant_order\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "    first = (\n",
        "        group.iloc[0]\n",
        "    )\n",
        "\n",
        "\n",
        "    record = {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            scenario_id,\n",
        "\n",
        "        \"scenario_number\":\n",
        "            first[\n",
        "                \"scenario_number\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            first[\n",
        "                \"evidence_strength\"\n",
        "            ],\n",
        "\n",
        "        \"scenario_text\":\n",
        "            first[\n",
        "                \"scenario_text\"\n",
        "            ],\n",
        "\n",
        "        \"evidence_summary\":\n",
        "            first[\n",
        "                \"evidence_summary\"\n",
        "            ],\n",
        "\n",
        "        \"gold_reason\":\n",
        "            first[\n",
        "                \"gold_reason\"\n",
        "            ],\n",
        "\n",
        "        \"variants\":\n",
        "            [],\n",
        "    }\n",
        "\n",
        "\n",
        "    for _, row in (\n",
        "        group.iterrows()\n",
        "    ):\n",
        "\n",
        "        record[\n",
        "            \"variants\"\n",
        "        ].append(\n",
        "            {\n",
        "                \"experiment_id\":\n",
        "                    row[\n",
        "                        \"experiment_id\"\n",
        "                    ],\n",
        "\n",
        "                \"schema_variant\":\n",
        "                    row[\n",
        "                        \"schema_variant\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_action\":\n",
        "                    row[\n",
        "                        \"expected_action\"\n",
        "                    ],\n",
        "\n",
        "                \"expected_value_json\":\n",
        "                    row[\n",
        "                        \"expected_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"actual_target_value_json\":\n",
        "                    row[\n",
        "                        \"actual_target_value_json\"\n",
        "                    ],\n",
        "\n",
        "                \"target_snapshot_json\":\n",
        "                    row[\n",
        "                        \"target_snapshot_json\"\n",
        "                    ],\n",
        "\n",
        "                \"mechanical_outcome\":\n",
        "                    row[\n",
        "                        \"mechanical_outcome\"\n",
        "                    ],\n",
        "\n",
        "                \"adjudication_status\":\n",
        "                    row[\n",
        "                        \"adjudication_status\"\n",
        "                    ],\n",
        "\n",
        "                \"final_semantic_correct\":\n",
        "                    row.get(\n",
        "                        \"final_semantic_correct\"\n",
        "                    ),\n",
        "\n",
        "                \"final_error_category\":\n",
        "                    row.get(\n",
        "                        \"final_error_category\"\n",
        "                    ),\n",
        "\n",
        "                \"final_mechanism\":\n",
        "                    row.get(\n",
        "                        \"final_mechanism\"\n",
        "                    ),\n",
        "\n",
        "                \"adjudication_rule_id\":\n",
        "                    row.get(\n",
        "                        \"adjudication_rule_id\"\n",
        "                    ),\n",
        "\n",
        "                \"adjudication_note\":\n",
        "                    row.get(\n",
        "                        \"manual_adjudication_note\"\n",
        "                    ),\n",
        "            }\n",
        "        )\n",
        "\n",
        "\n",
        "    packet.append(\n",
        "        record\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Print full paired review\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
