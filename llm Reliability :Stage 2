      "source": [
        "# ============================================================\n",
        "# STUDY 2A — Error Localization and Mechanism Analysis\n",
        "# Cell 10: Lock controlled-experiment fields + factorial design\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import pandas as pd\n",
        "import json\n",
        "from datetime import datetime\n",
        "\n",
        "print(\"=\" * 105)\n",
        "print(\"STUDY 2A — CONTROLLED EXPERIMENT DESIGN\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Recovery-safe loading\n",
        "# ------------------------------------------------------------\n",
        "FINAL_LOCALIZATION_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_error_localization_final_v1.csv\"\n",
        ")\n",
        "\n",
        "FIELD_RISK_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_field_risk_analysis.csv\"\n",
        ")\n",
        "\n",
        "\n",
        "if \"final_loc_df\" not in globals():\n",
        "    final_loc_df = pd.read_csv(\n",
        "        FINAL_LOCALIZATION_PATH\n",
        "    )\n",
        "\n",
        "if \"field_risk_df\" not in globals():\n",
        "    field_risk_df = pd.read_csv(\n",
        "        FIELD_RISK_PATH\n",
        "    )\n",
        "\n",
        "\n",
        "assert len(final_loc_df) == 79\n",
        "\n",
        "print(\"✅ Final localization dataset loaded.\")\n",
        "print(\"✅ Field-risk analysis loaded.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. SELECT FOUR FIELDS\n",
        "#\n",
        "# IMPORTANT:\n",
        "# We are NOT simply choosing the four largest counts.\n",
        "#\n",
        "# We want mechanistic coverage:\n",
        "#\n",
        "# 1. medications[].action[]<item>\n",
        "#       strongest schema-commitment signal\n",
        "#\n",
        "# 2. symptoms[].status\n",
        "#       status/certainty commitment\n",
        "#\n",
        "# 3. follow_up.condition\n",
        "#       conditional-information representation\n",
        "#\n",
        "# 4. symptoms[].severity\n",
        "#       likely schema-expressivity problem\n",
        "# ============================================================\n",
        "\n",
        "SELECTED_FIELDS = [\n",
        "\n",
        "    \"medications[].action[]<item>\",\n",
        "\n",
        "    \"symptoms[].status\",\n",
        "\n",
        "    \"follow_up.condition\",\n",
        "\n",
        "    \"symptoms[].severity\",\n",
        "]\n",
        "\n",
        "\n",
        "for field in SELECTED_FIELDS:\n",
        "\n",
        "    assert (\n",
        "        field\n",
        "        in set(\n",
        "            final_loc_df[\n",
        "                \"schema_path\"\n",
        "            ].dropna()\n",
        "        )\n",
        "    ), f\"Field missing: {field}\"\n",
        "\n",
        "\n",
        "print(\"\\nSelected controlled-experiment fields:\")\n",
        "\n",
        "for field in SELECTED_FIELDS:\n",
        "    print(\" •\", field)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. COMPUTE OBSERVED STUDY 1 EVIDENCE\n",
        "# ============================================================\n",
        "\n",
        "selection_rows = []\n",
        "\n",
        "\n",
        "FIELD_HYPOTHESES = {\n",
        "\n",
        "    \"medications[].action[]<item>\": {\n",
        "\n",
        "        \"primary_hypothesis\":\n",
        "            \"schema_commitment_pressure\",\n",
        "\n",
        "        \"study1_signal\":\n",
        "            (\n",
        "                \"Medication action errors emerged only \"\n",
        "                \"under schema-constrained generation and \"\n",
        "                \"were unsupported inferences.\"\n",
        "            ),\n",
        "\n",
        "        \"research_question\":\n",
        "            (\n",
        "                \"Does forcing the model to populate a \"\n",
        "                \"medication action cause it to invent \"\n",
        "                \"continue/stop/start decisions when the \"\n",
        "                \"transcript merely mentions medication use?\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].status\": {\n",
        "\n",
        "        \"primary_hypothesis\":\n",
        "            \"schema_commitment_pressure\",\n",
        "\n",
        "        \"study1_signal\":\n",
        "            (\n",
        "                \"Schema-constrained outputs produced \"\n",
        "                \"status/certainty errors such as interpreting \"\n",
        "                \"improvement as resolved.\"\n",
        "            ),\n",
        "\n",
        "        \"research_question\":\n",
        "            (\n",
        "                \"Does a restricted status representation \"\n",
        "                \"push ambiguous symptom states into overly \"\n",
        "                \"definite categories such as resolved?\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"follow_up.condition\": {\n",
        "\n",
        "        \"primary_hypothesis\":\n",
        "            \"insufficient_schema_expressivity\",\n",
        "\n",
        "        \"study1_signal\":\n",
        "            (\n",
        "                \"The constrained condition field showed \"\n",
        "                \"mapping, omission, and partial-extraction \"\n",
        "                \"failures involving conditional follow-up.\"\n",
        "            ),\n",
        "\n",
        "        \"research_question\":\n",
        "            (\n",
        "                \"Is a single free-text condition field \"\n",
        "                \"insufficient for representing conditional \"\n",
        "                \"follow-up logic such as worsening symptoms, \"\n",
        "                \"failed treatment, or pending test results?\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].severity\": {\n",
        "\n",
        "        \"primary_hypothesis\":\n",
        "            \"insufficient_schema_expressivity\",\n",
        "\n",
        "        \"study1_signal\":\n",
        "            (\n",
        "                \"Several localized errors involved trigger, \"\n",
        "                \"distribution, functional impact, or other \"\n",
        "                \"symptom context being forced toward the \"\n",
        "                \"nearest available symptom field.\"\n",
        "            ),\n",
        "\n",
        "        \"research_question\":\n",
        "            (\n",
        "                \"Does the lack of dedicated trigger/context/\"\n",
        "                \"distribution fields cause clinically relevant \"\n",
        "                \"information to be lost or compressed into \"\n",
        "                \"severity?\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "for schema_path in SELECTED_FIELDS:\n",
        "\n",
        "    subset = final_loc_df[\n",
        "        final_loc_df[\"schema_path\"]\n",
        "        == schema_path\n",
        "    ]\n",
        "\n",
        "\n",
        "    baseline_errors = int(\n",
        "        (\n",
        "            subset[\"condition\"]\n",
        "            == \"baseline\"\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    constrained_errors = int(\n",
        "        (\n",
        "            subset[\"condition\"]\n",
        "            == \"schema_constrained\"\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    constrained_unsupported = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"unsupported_inference\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    constrained_status = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"status_certainty_error\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    constrained_partial = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"partial_extraction\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    constrained_omission = int(\n",
        "        (\n",
        "            (\n",
        "                subset[\"condition\"]\n",
        "                == \"schema_constrained\"\n",
        "            )\n",
        "            &\n",
        "            (\n",
        "                subset[\"error_category\"]\n",
        "                == \"omission\"\n",
        "            )\n",
        "        ).sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    fit_issue_errors = int(\n",
        "        subset[\"path_fit\"]\n",
        "        .isin(\n",
        "            [\n",
        "                \"approximate\",\n",
        "                \"composite\",\n",
        "                \"schema_gap\",\n",
        "            ]\n",
        "        )\n",
        "        .sum()\n",
        "    )\n",
        "\n",
        "\n",
        "    hypothesis = FIELD_HYPOTHESES[\n",
        "        schema_path\n",
        "    ]\n",
        "\n",
        "\n",
        "    selection_rows.append(\n",
        "        {\n",
        "            \"schema_path\":\n",
        "                schema_path,\n",
        "\n",
        "            \"baseline_errors\":\n",
        "                baseline_errors,\n",
        "\n",
        "            \"schema_constrained_errors\":\n",
        "                constrained_errors,\n",
        "\n",
        "            \"difference\":\n",
        "                constrained_errors\n",
        "                - baseline_errors,\n",
        "\n",
        "            \"constrained_unsupported_inference\":\n",
        "                constrained_unsupported,\n",
        "\n",
        "            \"constrained_status_certainty\":\n",
        "                constrained_status,\n",
        "\n",
        "            \"constrained_partial_extraction\":\n",
        "                constrained_partial,\n",
        "\n",
        "            \"constrained_omission\":\n",
        "                constrained_omission,\n",
        "\n",
        "            \"schema_fit_issue_errors\":\n",
        "                fit_issue_errors,\n",
        "\n",
        "            \"primary_hypothesis\":\n",
        "                hypothesis[\n",
        "                    \"primary_hypothesis\"\n",
        "                ],\n",
        "\n",
        "            \"study1_signal\":\n",
        "                hypothesis[\n",
        "                    \"study1_signal\"\n",
        "                ],\n",
        "\n",
        "            \"research_question\":\n",
        "                hypothesis[\n",
        "                    \"research_question\"\n",
        "                ],\n",
        "        }\n",
        "    )\n",
        "\n",
        "\n",
        "selected_field_df = pd.DataFrame(\n",
        "    selection_rows\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"SELECTED FIELD EVIDENCE\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(selected_field_df)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. DEFINE SCHEMA VARIANTS\n",
        "#\n",
        "# These definitions will be applied consistently.\n",
        "#\n",
        "# Variant A:\n",
        "# forced_required\n",
        "#\n",
        "# Variant B:\n",
        "# required_nullable\n",
        "#\n",
        "# Variant C:\n",
        "# optional\n",
        "#\n",
        "# Variant D:\n",
        "# semantically_richer\n",
        "# ============================================================\n",
        "\n",
        "SCHEMA_VARIANTS = {\n",
        "\n",
        "    \"forced_required\": {\n",
        "\n",
        "        \"description\":\n",
        "            (\n",
        "                \"Target field must be present and must \"\n",
        "                \"contain a non-null semantic commitment.\"\n",
        "            ),\n",
        "\n",
        "        \"causal_role\":\n",
        "            (\n",
        "                \"Tests maximum schema commitment pressure.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"required_nullable\": {\n",
        "\n",
        "        \"description\":\n",
        "            (\n",
        "                \"Target field must be present, but null \"\n",
        "                \"is permitted when evidence is insufficient.\"\n",
        "            ),\n",
        "\n",
        "        \"causal_role\":\n",
        "            (\n",
        "                \"Tests whether an explicit escape state \"\n",
        "                \"reduces unsupported commitments.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"optional\": {\n",
        "\n",
        "        \"description\":\n",
        "            (\n",
        "                \"Target field may be omitted entirely when \"\n",
        "                \"the transcript does not support a value.\"\n",
        "            ),\n",
        "\n",
        "        \"causal_role\":\n",
        "            (\n",
        "                \"Tests whether removing forced field \"\n",
        "                \"completion reduces semantic error.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"semantically_richer\": {\n",
        "\n",
        "        \"description\":\n",
        "            (\n",
        "                \"Target representation is expanded to \"\n",
        "                \"capture distinctions that the frozen \"\n",
        "                \"schema cannot represent cleanly.\"\n",
        "            ),\n",
        "\n",
        "        \"causal_role\":\n",
        "            (\n",
        "                \"Tests insufficient schema expressivity.\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. DEFINE FIELD-SPECIFIC RICHER REPRESENTATIONS\n",
        "# ============================================================\n",
        "\n",
        "RICHER_FIELD_DESIGNS = {\n",
        "\n",
        "    \"medications[].action[]<item>\": {\n",
        "\n",
        "        \"design\":\n",
        "            (\n",
        "                \"Preserve medication action, but separately \"\n",
        "                \"represent whether an action was explicitly \"\n",
        "                \"stated by the clinician.\"\n",
        "            ),\n",
        "\n",
        "        \"added_semantics\": [\n",
        "            \"action\",\n",
        "            \"action_evidence_status\",\n",
        "        ],\n",
        "\n",
        "        \"allowed_evidence_status\": [\n",
        "            \"explicit_clinician_instruction\",\n",
        "            \"patient_report_only\",\n",
        "            \"historical_only\",\n",
        "            \"ambiguous\",\n",
        "            \"absent\",\n",
        "        ],\n",
        "\n",
        "        \"intended_effect\":\n",
        "            (\n",
        "                \"Prevent current medication use from being \"\n",
        "                \"silently converted into a continue action.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].status\": {\n",
        "\n",
        "        \"design\":\n",
        "            (\n",
        "                \"Expand symptom state beyond the frozen \"\n",
        "                \"present/denied/resolved categories.\"\n",
        "            ),\n",
        "\n",
        "        \"richer_status_values\": [\n",
        "            \"present\",\n",
        "            \"denied\",\n",
        "            \"improving\",\n",
        "            \"resolved\",\n",
        "            \"historical\",\n",
        "            \"uncertain\",\n",
        "        ],\n",
        "\n",
        "        \"intended_effect\":\n",
        "            (\n",
        "                \"Allow improvement or uncertainty without \"\n",
        "                \"forcing a resolved label.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"follow_up.condition\": {\n",
        "\n",
        "        \"design\":\n",
        "            (\n",
        "                \"Represent conditional follow-up using \"\n",
        "                \"structured trigger type plus trigger text.\"\n",
        "            ),\n",
        "\n",
        "        \"added_semantics\": [\n",
        "            \"trigger_type\",\n",
        "            \"trigger_text\",\n",
        "        ],\n",
        "\n",
        "        \"trigger_types\": [\n",
        "            \"routine\",\n",
        "            \"if_worsening\",\n",
        "            \"if_no_improvement\",\n",
        "            \"if_test_result\",\n",
        "            \"if_treatment_failure\",\n",
        "            \"other\",\n",
        "            \"uncertain\",\n",
        "        ],\n",
        "\n",
        "        \"intended_effect\":\n",
        "            (\n",
        "                \"Preserve conditional logic instead of \"\n",
        "                \"compressing it into one vague condition.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"symptoms[].severity\": {\n",
        "\n",
        "        \"design\":\n",
        "            (\n",
        "                \"Separate symptom intensity from other \"\n",
        "                \"clinically relevant symptom context.\"\n",
        "            ),\n",
        "\n",
        "        \"added_semantics\": [\n",
        "            \"severity\",\n",
        "            \"trigger\",\n",
        "            \"distribution\",\n",
        "            \"functional_impact\",\n",
        "            \"context\",\n",
        "        ],\n",
        "\n",
        "        \"intended_effect\":\n",
        "            (\n",
        "                \"Avoid forcing trigger/distribution/context \"\n",
        "                \"information into severity or dropping it.\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. DEFINE EVIDENCE-STRENGTH CONDITIONS\n",
        "# ============================================================\n",
        "\n",
        "EVIDENCE_CONDITIONS = {\n",
        "\n",
        "    \"explicit\": {\n",
        "\n",
        "        \"definition\":\n",
        "            (\n",
        "                \"Transcript directly and unambiguously \"\n",
        "                \"states the target semantic value.\"\n",
        "            ),\n",
        "\n",
        "        \"expected_behavior\":\n",
        "            (\n",
        "                \"Model should populate the correct value.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"ambiguous\": {\n",
        "\n",
        "        \"definition\":\n",
        "            (\n",
        "                \"Transcript contains relevant evidence but \"\n",
        "                \"does not uniquely support one target value.\"\n",
        "            ),\n",
        "\n",
        "        \"expected_behavior\":\n",
        "            (\n",
        "                \"Model should preserve uncertainty rather \"\n",
        "                \"than invent a stronger interpretation.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"absent\": {\n",
        "\n",
        "        \"definition\":\n",
        "            (\n",
        "                \"Transcript contains no evidence supporting \"\n",
        "                \"a target value.\"\n",
        "            ),\n",
        "\n",
        "        \"expected_behavior\":\n",
        "            (\n",
        "                \"Model should return null or omit the field \"\n",
        "                \"when the schema permits it and should not \"\n",
        "                \"invent information.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    \"contradictory\": {\n",
        "\n",
        "        \"definition\":\n",
        "            (\n",
        "                \"Transcript contains competing or explicitly \"\n",
        "                \"corrected evidence relevant to the field.\"\n",
        "            ),\n",
        "\n",
        "        \"expected_behavior\":\n",
        "            (\n",
        "                \"Model should use the final/strongest supported \"\n",
        "                \"evidence without combining incompatible claims.\"\n",
        "            ),\n",
        "    },\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. DEFINE MECHANISM OUTCOMES\n",
        "# ============================================================\n",
        "\n",
        "MECHANISM_LABELS = {\n",
        "\n",
        "    \"schema_commitment_pressure\":\n",
        "        (\n",
        "            \"Model makes an unsupported semantic commitment \"\n",
        "            \"because the schema strongly pressures field \"\n",
        "            \"completion.\"\n",
        "        ),\n",
        "\n",
        "    \"insufficient_schema_expressivity\":\n",
        "        (\n",
        "            \"Source meaning cannot be represented cleanly \"\n",
        "            \"with the available field structure or values.\"\n",
        "        ),\n",
        "\n",
        "    \"weak_or_ambiguous_source_evidence\":\n",
        "        (\n",
        "            \"The source itself does not clearly determine \"\n",
        "            \"one correct semantic interpretation.\"\n",
        "        ),\n",
        "\n",
        "    \"ordinary_extraction_failure\":\n",
        "        (\n",
        "            \"Source evidence is adequate and schema is \"\n",
        "            \"adequate, but the model still extracts, maps, \"\n",
        "            \"or omits the information incorrectly.\"\n",
        "        ),\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. BUILD FACTORIAL EXPERIMENT MATRIX\n",
        "#\n",
        "# 4 fields\n",
        "# × 4 schema variants\n",
        "# × 4 evidence strengths\n",
        "# × 3 independently written scenarios\n",
        "#\n",
        "# = 192 planned generations\n",
        "#\n",
        "# IMPORTANT:\n",
        "# These are distinct scenarios, NOT repeated identical prompts.\n",
        "# ============================================================\n",
        "\n",
        "N_SCENARIOS_PER_CELL = 3\n",
        "\n",
        "experiment_rows = []\n",
        "\n",
        "experiment_id = 0\n",
        "\n",
        "\n",
        "for schema_path in SELECTED_FIELDS:\n",
        "\n",
        "    for schema_variant in SCHEMA_VARIANTS:\n",
        "\n",
        "        for evidence_strength in EVIDENCE_CONDITIONS:\n",
        "\n",
        "            for scenario_number in range(\n",
        "                1,\n",
        "                N_SCENARIOS_PER_CELL + 1\n",
        "            ):\n",
        "\n",
        "                experiment_id += 1\n",
        "\n",
        "                experiment_rows.append(\n",
        "                    {\n",
        "                        \"experiment_id\":\n",
        "                            f\"EXP{experiment_id:03d}\",\n",
        "\n",
        "                        \"schema_path\":\n",
        "                            schema_path,\n",
        "\n",
        "                        \"schema_variant\":\n",
        "                            schema_variant,\n",
        "\n",
        "                        \"evidence_strength\":\n",
        "                            evidence_strength,\n",
        "\n",
        "                        \"scenario_number\":\n",
        "                            scenario_number,\n",
        "\n",
        "                        \"primary_hypothesis\":\n",
        "                            FIELD_HYPOTHESES[\n",
        "                                schema_path\n",
        "                            ][\n",
        "                                \"primary_hypothesis\"\n",
        "                            ],\n",
        "\n",
        "                        # Filled in later\n",
        "                        \"scenario_text\":\n",
        "                            None,\n",
        "\n",
        "                        \"expected_semantics\":\n",
        "                            None,\n",
        "\n",
        "                        \"generated_output\":\n",
        "                            None,\n",
        "\n",
        "                        \"output_sha256\":\n",
        "                            None,\n",
        "\n",
        "                        \"semantic_error\":\n",
        "                            None,\n",
        "\n",
        "                        \"error_category\":\n",
        "                            None,\n",
        "\n",
        "                        \"mechanism\":\n",
        "                            None,\n",
        "\n",
        "                        \"adjudication_notes\":\n",
        "                            None,\n",
        "\n",
        "                        \"generation_status\":\n",
        "                            \"not_run\",\n",
        "                    }\n",
        "                )\n",
        "\n",
        "\n",
        "experiment_design_df = pd.DataFrame(\n",
        "    experiment_rows\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. VALIDATE FACTORIAL BALANCE\n",
        "# ============================================================\n",
        "\n",
        "expected_total = (\n",
        "    len(SELECTED_FIELDS)\n",
        "    * len(SCHEMA_VARIANTS)\n",
        "    * len(EVIDENCE_CONDITIONS)\n",
        "    * N_SCENARIOS_PER_CELL\n",
        ")\n",
        "\n",
        "assert expected_total == 192\n",
        "\n",
        "assert len(experiment_design_df) == 192\n",
        "\n",
        "\n",
        "balance_check = (\n",
        "    experiment_design_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"schema_variant\",\n",
        "            \"evidence_strength\",\n",
        "        ]\n",
        "    )\n",
        "    .size()\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    balance_check == N_SCENARIOS_PER_CELL\n",
        ").all()\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"FACTORIAL DESIGN\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "print(\n",
        "    \"Fields:\",\n",
        "    len(SELECTED_FIELDS)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Schema variants:\",\n",
        "    len(SCHEMA_VARIANTS)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Evidence conditions:\",\n",
        "    len(EVIDENCE_CONDITIONS)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Independent scenarios per condition:\",\n",
        "    N_SCENARIOS_PER_CELL\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Total planned generations:\",\n",
        "    len(experiment_design_df)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"\\n✅ Experiment is balanced.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Compact design summary\n",
        "# ============================================================\n",
        "\n",
        "design_summary = (\n",
        "    experiment_design_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"schema_path\",\n",
        "            \"schema_variant\",\n",
        "            \"evidence_strength\",\n",
        "        ]\n",
        "    )\n",
        "    .size()\n",
        "    .reset_index(\n",
        "        name=\"n_scenarios\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 105)\n",
        "print(\"DESIGN MATRIX PREVIEW\")\n",
        "print(\"=\" * 105)\n",
        "\n",
        "display(\n",
        "    design_summary.head(32)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. SAVE EXPERIMENT DESIGN IMMEDIATELY\n",
        "# ============================================================\n",
        "\n",
        "EXPERIMENT_DESIGN_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_controlled_experiment_design.csv\"\n",
        ")\n",
        "\n",
        "experiment_design_df.to_csv(\n",
        "    EXPERIMENT_DESIGN_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "SELECTED_FIELDS_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_selected_experiment_fields.csv\"\n",
        ")\n",
        "\n",
        "selected_field_df.to_csv(\n",
        "    SELECTED_FIELDS_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "EXPERIMENT_MANIFEST_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_controlled_experiment_manifest.json\"\n",
