        "    ]\n",
        "    is True\n",
        ")\n",
        "\n",
        "\n",
        "MODEL = protocol[\"model\"]\n",
        "\n",
        "PROTOCOL_SHA256 = (\n",
        "    protocol[\n",
        "        \"generation_protocol_sha256\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
