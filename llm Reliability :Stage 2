        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Recovery-safe paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "STUDY2A_DATA_DIR = (\n",
        "    STUDY2A_DIR / \"data\"\n",
        ")\n",
        "\n",
        "STUDY2A_RESULTS_DIR = (\n",
        "    STUDY2A_DIR / \"results\"\n",
        ")\n",
        "\n",
        "STUDY2A_CHECKPOINT_DIR = (\n",
        "    STUDY2A_DIR / \"checkpoints\"\n",
        ")\n",
        "\n",
        "\n",
        "PROTOCOL_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_generation_protocol_frozen_v1_1.json\"\n",
        ")\n",
        "\n",
        "MANIFEST_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_generation_manifest_frozen_v1_1.csv\"\n",
        ")\n",
        "\n",
        "CHECKPOINT_PATH = (\n",
        "    STUDY2A_CHECKPOINT_DIR\n",
        "    / \"study2a_generation_checkpoint_v1_1.json\"\n",
        ")\n",
        "\n",
        "SMOKE_GATE_PATH = (\n",
        "    STUDY2A_RESULTS_DIR\n",
        "    / \"study2a_smoke_pipeline_gate.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load protocol, manifest, checkpoint, smoke gate\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    PROTOCOL_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "    protocol = json.load(f)\n",
        "\n",
        "\n",
        "manifest_df = pd.read_csv(\n",
        "    MANIFEST_PATH\n",
        ")\n",
        "\n",
        "\n",
        "with open(\n",
        "    CHECKPOINT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "    checkpoint = json.load(f)\n",
        "\n",
        "\n",
        "with open(\n",
        "    SMOKE_GATE_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "    smoke_gate = json.load(f)\n",
        "\n",
        "\n",
        "assert len(manifest_df) == 192\n",
