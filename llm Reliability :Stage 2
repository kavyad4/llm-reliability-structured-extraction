        "# ============================================================\n",
        "\n",
        "api_key = None\n",
        "key_source = None\n",
        "\n",
        "\n",
        "# First check environment\n",
        "for env_name in [\n",
        "    \"GEMINI_API_KEY\",\n",
        "    \"GOOGLE_API_KEY\",\n",
        "]:\n",
        "\n",
        "    value = os.environ.get(\n",
        "        env_name\n",
        "    )\n",
        "\n",
        "    if value:\n",
        "\n",
        "        api_key = value\n",
        "        key_source = (\n",
        "            f\"environment:{env_name}\"\n",
        "        )\n",
        "        break\n",
        "\n",
        "\n",
        "# Then try Colab userdata\n",
        "if api_key is None:\n",
        "\n",
        "    try:\n",
        "\n",
        "        from google.colab import userdata\n",
        "\n",
        "        for secret_name in [\n",
        "            \"GEMINI_API_KEY\",\n",
        "            \"GOOGLE_API_KEY\",\n",
        "        ]:\n",
        "\n",
        "            try:\n",
        "\n",
        "                value = userdata.get(\n",
        "                    secret_name\n",
        "                )\n",
        "\n",
        "                if value:\n",
        "\n",
        "                    api_key = value\n",
        "                    key_source = (\n",
        "                        f\"colab_secret:{secret_name}\"\n",
        "                    )\n",
        "                    break\n",
        "\n",
        "            except Exception:\n",
        "                pass\n",
        "\n",
        "    except Exception:\n",
        "        pass\n",
        "\n",
        "\n",
        "if api_key is None:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"\\nNo Gemini API key was found.\\n\\n\"\n",
        "        \"Add the same API key you used for Study 1 \"\n",
        "        \"to Colab Secrets as GEMINI_API_KEY or \"\n",
        "        \"GOOGLE_API_KEY, then rerun ONLY this cell.\\n\\n\"\n",
        "        \"Do not paste the key into the notebook code.\"\n",
        "    )\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Gemini credential found:\",\n",
        "    key_source\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Initialize Gemini client\n",
        "# ============================================================\n",
        "\n",
        "client = genai.Client(\n",
        "    api_key=api_key\n",
