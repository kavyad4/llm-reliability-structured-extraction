        "\n",
        "print(\n",
        "    \"✅ All 16 validated schema variants loaded.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Freeze exact extraction prompt\n",
        "#\n",
        "# IMPORTANT:\n",
        "# This prompt is IDENTICAL for all 192 generations.\n",
        "#\n",
        "# It does NOT tell the model:\n",
        "# - evidence-strength label\n",
        "# - expected answer\n",
        "# - mechanism hypothesis\n",
        "# - whether the field is forced/optional/richer\n",
        "#\n",
        "# The schema itself is supplied separately.\n",
        "# ============================================================\n",
        "\n",
        "GENERATION_PROMPT_TEMPLATE = \"\"\"You are a structured clinical information extraction system.\n",
        "\n",
        "Extract information from the transcript into the supplied JSON schema.\n",
        "\n",
        "Rules:\n",
        "1. Use only information supported by the transcript.\n",
        "2. Do not invent facts, diagnoses, medication actions, symptom states, follow-up conditions, or clinical findings.\n",
        "3. Do not convert a medication mention or a patient's current medication use into a clinician-directed start, continue, stop, increase, or decrease action unless that action is supported by the transcript.\n",
        "4. Preserve uncertainty when the transcript is ambiguous.\n",
        "5. When a speaker explicitly corrects an earlier statement, use the corrected/final statement.\n",
        "6. If information is not supported, use the schema's available abstention behavior (for example null or omission) when the schema permits it.\n",
        "7. Do not add explanations outside the JSON response.\n",
        "8. Return only data that conforms to the supplied JSON schema.\n",
        "\n",
        "TRANSCRIPT:\n",
        "{scenario_text}\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "PROMPT_TEMPLATE_SHA256 = (\n",
        "    stable_hash_text(\n",
        "        GENERATION_PROMPT_TEMPLATE\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nPrompt-template SHA256:\"\n",
        ")\n",
        "print(\n",
        "    PROMPT_TEMPLATE_SHA256\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 8. Freeze generation configuration\n",
        "#\n",
        "# Temperature = 0.0 to minimize unnecessary stochasticity.\n",
        "#\n",
        "# The three scenarios per factorial cell are independent\n",
        "# SOURCE scenarios, not stochastic repeats of one prompt.\n",
        "# ============================================================\n",
        "\n",
        "GENERATION_CONFIG = {\n",
        "\n",
        "    \"model\":\n",
        "        STUDY2A_MODEL,\n",
        "\n",
        "    \"temperature\":\n",
        "        0.0,\n",
        "\n",
        "    \"candidate_count\":\n",
        "        1,\n",
        "\n",
        "    \"max_output_tokens\":\n",
        "        4096,\n",
        "\n",
        "    \"response_mime_type\":\n",
        "        \"application/json\",\n",
        "\n",
        "    \"response_schema\":\n",
        "        \"experiment-specific validated JSON schema\",\n",
        "\n",
        "    \"prompt_template_sha256\":\n",
        "        PROMPT_TEMPLATE_SHA256,\n",
        "\n",
        "    \"scenario_replicate_type\":\n",
        "        \"independent_source_scenarios\",\n",
        "\n",
        "    \"scenarios_per_factor_cell\":\n",
        "        3,\n",
        "}\n",
        "\n",
        "\n",
        "GENERATION_CONFIG_SHA256 = (\n",
        "    stable_hash_json(\n",
        "        GENERATION_CONFIG\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nGeneration-config SHA256:\"\n",
        ")\n",
        "print(\n",
        "    GENERATION_CONFIG_SHA256\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 9. Freeze generation rules\n",
        "# ============================================================\n",
        "\n",
        "GENERATION_RULES = {\n",
        "\n",
        "    \"one_call_per_experiment_slot\":\n",
        "        True,\n",
        "\n",
        "    \"planned_generation_count\":\n",
        "        192,\n",
        "\n",
        "    \"semantic_retry_allowed\":\n",
        "        False,\n",
        "\n",
        "    \"schema_failure_retry_allowed\":\n",
        "        False,\n",
        "\n",
        "    \"retry_only_for_transport_or_api_failure\":\n",
        "        True,\n",
        "\n",
        "    \"maximum_transport_attempts\":\n",
        "        3,\n",
        "\n",
        "    \"raw_response_saved\":\n",
        "        True,\n",
        "\n",
        "    \"raw_response_sha256_saved\":\n",
        "        True,\n",
        "\n",
        "    \"parsed_json_saved\":\n",
        "        True,\n",
        "\n",
        "    \"schema_validation_saved\":\n",
        "        True,\n",
        "\n",
        "    \"generation_error_saved\":\n",
        "        True,\n",
        "\n",
        "    \"checkpoint_after_each_attempt\":\n",
        "        True,\n",
        "\n",
        "    \"gold_labels_hidden_from_generation_prompt\":\n",
        "        True,\n",
        "\n",
        "    \"evidence_strength_hidden_from_generation_prompt\":\n",
        "        True,\n",
        "\n",
        "    \"mechanism_hypothesis_hidden_from_generation_prompt\":\n",
        "        True,\n",
        "\n",
        "    \"api_key_saved_to_results\":\n",
        "        False,\n",
        "\n",
        "    \"study1_files_modified\":\n",
        "        False,\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Freeze randomized run order\n",
        "#\n",
        "# This helps avoid always running:\n",
        "# forced-required first,\n",
        "# then nullable,\n",
        "# then optional,\n",
        "# etc.\n",
        "#\n",
        "# Fixed seed makes ordering reproducible.\n",
        "# ============================================================\n",
        "\n",
        "RUN_ORDER_RANDOM_SEED = 20261001\n",
        "\n",
        "\n",
        "experiment_ids = (\n",
        "    frozen_experiment_df[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        "    .tolist()\n",
        ")\n",
        "\n",
        "\n",
        "rng = random.Random(\n",
        "    RUN_ORDER_RANDOM_SEED\n",
        ")\n",
        "\n",
        "\n",
        "randomized_ids = (\n",
        "    experiment_ids.copy()\n",
        ")\n",
        "\n",
        "\n",
        "rng.shuffle(\n",
        "    randomized_ids\n",
        ")\n",
        "\n",
        "\n",
        "run_order_lookup = {\n",
        "\n",
        "    experiment_id:\n",
        "        run_order\n",
        "\n",
        "    for run_order, experiment_id\n",
        "    in enumerate(\n",
        "        randomized_ids,\n",
        "        start=1,\n",
        "    )\n",
        "}\n",
        "\n",
        "\n",
        "generation_manifest_df = (\n",
        "    frozen_experiment_df\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "generation_manifest_df[\n",
        "    \"run_order\"\n",
        "] = (\n",
        "    generation_manifest_df[\n",
        "        \"experiment_id\"\n",
