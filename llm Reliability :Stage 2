        "# ============================================================\n",
        "# 10. Derive expected behavior for each schema variant\n",
        "#\n",
        "# IMPORTANT:\n",
        "#\n",
        "# We distinguish:\n",
        "#\n",
        "# - semantic truth\n",
        "# - schema compliance\n",
        "#\n",
        "# For forced-required + absent/ambiguous evidence,\n",
        "# there may literally be NO semantically justified\n",
        "# non-null value.\n",
        "#\n",
        "# That is part of the experiment.\n",
        "# ============================================================\n",
        "\n",
        "def expected_for_variant(\n",
        "    row,\n",
        "    variant,\n",
        "):\n",
        "\n",
        "    base_value = (\n",
        "        row[\"gold_base_value\"]\n",
        "    )\n",
        "\n",
        "    richer_value = (\n",
        "        row[\"gold_richer_value\"]\n",
        "    )\n",
        "\n",
        "    evidence = (\n",
        "        row[\"evidence_strength\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Semantically richer\n",
        "    # --------------------------------------------------------\n",
        "    if variant == \"semantically_richer\":\n",
        "\n",
        "        return {\n",
        "            \"expected_action\":\n",
        "                (\n",
        "                    \"populate_richer_value\"\n",
        "                    if richer_value is not None\n",
        "                    else \"null\"\n",
        "                ),\n",
        "\n",
        "            \"expected_value\":\n",
        "                richer_value,\n",
        "\n",
        "            \"schema_semantic_conflict\":\n",
        "                False,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Original representation has a uniquely supported value\n",
        "    # --------------------------------------------------------\n",
        "    if base_value is not None:\n",
        "\n",
        "        return {\n",
        "            \"expected_action\":\n",
        "                \"populate_supported_value\",\n",
        "\n",
        "            \"expected_value\":\n",
        "                base_value,\n",
        "\n",
        "            \"schema_semantic_conflict\":\n",
        "                False,\n",
        "        }\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # No uniquely supported base value\n",
        "    # --------------------------------------------------------\n",
        "    if variant == \"required_nullable\":\n",
        "\n",
        "        return {\n",
        "            \"expected_action\":\n",
        "                \"return_null\",\n",
        "\n",
        "            \"expected_value\":\n",
        "                None,\n",
        "\n",
        "            \"schema_semantic_conflict\":\n",
        "                False,\n",
        "        }\n",
        "\n",
        "\n",
        "    if variant == \"optional\":\n",
        "\n",
        "        return {\n",
        "            \"expected_action\":\n",
        "                \"omit_target_field\",\n",
        "\n",
        "            \"expected_value\":\n",
        "                None,\n",
        "\n",
        "            \"schema_semantic_conflict\":\n",
        "                False,\n",
        "        }\n",
        "\n",
        "\n",
        "    if variant == \"forced_required\":\n",
        "\n",
        "        return {\n",
        "            \"expected_action\":\n",
        "                \"no_semantically_valid_non_null_value\",\n",
        "\n",
        "            \"expected_value\":\n",
        "                None,\n",
        "\n",
        "            \"schema_semantic_conflict\":\n",
        "                True,\n",
        "        }\n",
        "\n",
        "\n",
        "    raise ValueError(\n",
        "        f\"Unknown variant: {variant}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 11. Match 48 scenarios into all 192 experiment slots\n",
        "# ============================================================\n",
        "\n",
        "scenario_lookup = {}\n",
        "\n",
        "for _, row in scenario_df.iterrows():\n",
        "\n",
        "    key = (\n",
        "        row[\"schema_path\"],\n",
        "        row[\"evidence_strength\"],\n",
        "        int(\n",
        "            row[\"scenario_number\"]\n",
        "        ),\n",
        "    )\n",
        "\n",
        "    scenario_lookup[key] = row.to_dict()\n",
        "\n",
        "\n",
        "frozen_experiment_rows = []\n",
