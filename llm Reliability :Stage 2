        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Expected value:\",\n",
        "            variant[\n",
        "                \"expected_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Actual value:\",\n",
        "            variant[\n",
        "                \"actual_target_value_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \"  Target snapshot:\",\n",
        "            variant[\n",
        "                \"target_snapshot_json\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
