        "                \"'annual visit' into the conditional-trigger \"\n",
        "                \"field.\"\n",
        "            ),\n",
        "    },\n",
        "\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Richer SCN033\n",
        "    #\n",
        "    # trigger_type='routine' resolves the semantics correctly.\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"EXP141\": {\n",
        "\n",
        "        \"scenario_id\":\n",
        "            \"SCN033\",\n",
        "\n",
        "        \"semantic_correct\":\n",
        "            True,\n",
        "\n",
        "        \"error_category\":\n",
        "            None,\n",
        "\n",
        "        \"note\":\n",
