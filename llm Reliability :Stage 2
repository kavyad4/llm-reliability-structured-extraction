      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# STUDY 2A — CELL 18S\n",
        "# Recover canonical frozen gold from JSON\n",
        "#\n",
        "# Problem discovered:\n",
        "# pandas.read_csv() interpreted the literal string \"null\"\n",
        "# in expected_action as NaN.\n",
        "#\n",
        "# We DO NOT change the frozen gold.\n",
        "# We reload the canonical frozen JSON, which preserves \"null\".\n",
        "#\n",
        "# NO Gemini calls.\n",
        "# ============================================================\n",
        "\n",
        "import json\n",
        "import pandas as pd\n",
        "from pathlib import Path\n",
        "\n",
        "print(\"=\" * 110)\n",
        "print(\"STUDY 2A — RECOVERING CANONICAL FROZEN GOLD FROM JSON\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. Paths\n",
        "# ============================================================\n",
        "\n",
        "STUDY2A_DIR = Path(\n",
        "    \"/content/drive/MyDrive/LLM_Reliability_Study2A\"\n",
        ")\n",
        "\n",
        "DATA_DIR = STUDY2A_DIR / \"data\"\n",
        "RESULTS_DIR = STUDY2A_DIR / \"results\"\n",
        "CHECKPOINT_DIR = STUDY2A_DIR / \"checkpoints\"\n",
        "\n",
        "\n",
        "FROZEN_JSON_PATH = (\n",
        "    DATA_DIR\n",
        "    / \"study2a_controlled_experiment_frozen.json\"\n",
        ")\n",
        "\n",
        "CHECKPOINT_PATH = (\n",
        "    CHECKPOINT_DIR\n",
        "    / \"study2a_generation_checkpoint_v1_1.json\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 2. Load canonical frozen experiment from JSON\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    FROZEN_JSON_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    frozen_records = json.load(f)\n",
        "\n",
        "\n",
        "frozen_json_df = pd.DataFrame(\n",
        "    frozen_records\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    frozen_json_df\n",
        ") == 192\n",
        "\n",
        "\n",
        "assert (\n",
        "    frozen_json_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"✅ Canonical frozen JSON rows:\",\n",
        "    len(frozen_json_df)\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 3. Inspect the six previously 'missing' rows\n",
        "# ============================================================\n",
        "\n",
        "SUSPECT_IDS = [\n",
        "    \"EXP188\",\n",
        "    \"EXP092\",\n",
        "    \"EXP091\",\n",
        "    \"EXP189\",\n",
        "    \"EXP187\",\n",
        "    \"EXP093\",\n",
        "]\n",
        "\n",
        "\n",
        "suspect_df = (\n",
        "    frozen_json_df[\n",
        "        frozen_json_df[\n",
        "            \"experiment_id\"\n",
        "        ].isin(\n",
        "            SUSPECT_IDS\n",
        "        )\n",
        "    ][\n",
        "        [\n",
        "            \"experiment_id\",\n",
        "            \"scenario_id\",\n",
        "            \"schema_path\",\n",
        "            \"schema_variant\",\n",
        "            \"evidence_strength\",\n",
        "            \"expected_action\",\n",
        "            \"expected_value_json\",\n",
        "        ]\n",
        "    ]\n",
        "    .sort_values(\n",
        "        \"experiment_id\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SIX ROWS THAT CSV READ AS NaN\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    suspect_df\n",
        ")\n",
        "\n",
        "\n",
        "# Every one should literally contain the STRING \"null\"\n",
        "assert len(\n",
        "    suspect_df\n",
        ") == 6\n",
        "\n",
        "\n",
        "assert (\n",
        "    suspect_df[\n",
        "        \"expected_action\"\n",
        "    ]\n",
        "    .eq(\"null\")\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    '\\n✅ All six expected_action values are the literal string \"null\".'\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ The previous NaNs came from pandas CSV parsing, not missing gold data.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 4. Verify ALL 192 expected actions exist in canonical JSON\n",
        "# ============================================================\n",
        "\n",
        "missing_expected = (\n",
        "    frozen_json_df[\n",
        "        \"expected_action\"\n",
        "    ].isna()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\nActual missing expected_action values in frozen JSON:\",\n",
        "    int(\n",
        "        missing_expected.sum()\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    missing_expected.sum()\n",
        "    == 0\n",
        ")\n",
        "\n",
        "\n",
        "expected_action_counts = (\n",
        "    frozen_json_df[\n",
        "        \"expected_action\"\n",
        "    ]\n",
        "    .value_counts(\n",
        "        dropna=False\n",
        "    )\n",
        "    .rename_axis(\n",
        "        \"expected_action\"\n",
        "    )\n",
        "    .reset_index(\n",
        "        name=\"n\"\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"FROZEN EXPECTED-ACTION COUNTS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "display(\n",
        "    expected_action_counts\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 5. Load all completed generation results\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    CHECKPOINT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    checkpoint = json.load(f)\n",
        "\n",
        "\n",
        "results_df = pd.DataFrame(\n",
        "    checkpoint[\n",
        "        \"results\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    results_df\n",
        ") == 192\n",
        "\n",
        "\n",
        "assert (\n",
        "    results_df[\n",
        "        \"experiment_id\"\n",
        "    ].nunique()\n",
        "    == 192\n",
        ")\n",
        "\n",
        "\n",
        "assert (\n",
        "    results_df[\n",
        "        \"generation_status\"\n",
        "    ]\n",
        "    .eq(\"completed\")\n",
        "    .all()\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\n✅ 192 completed generation results loaded.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 6. Join using experiment_id ONLY\n",
        "# ============================================================\n",
        "\n",
        "gold_cols = [\n",
        "    \"experiment_id\",\n",
        "    \"scenario_id\",\n",
        "    \"schema_path\",\n",
        "    \"schema_variant\",\n",
        "    \"evidence_strength\",\n",
        "    \"scenario_number\",\n",
        "    \"target_entity\",\n",
        "    \"scenario_text\",\n",
        "    \"evidence_summary\",\n",
        "    \"gold_reason\",\n",
        "    \"expected_action\",\n",
        "    \"expected_value_json\",\n",
        "    \"schema_semantic_conflict\",\n",
        "]\n",
        "\n",
        "\n",
        "gold_df = (\n",
        "    frozen_json_df[\n",
        "        gold_cols\n",
        "    ]\n",
        "    .copy()\n",
        ")\n",
        "\n",
        "\n",
        "# Rename metadata for independent integrity check\n",
        "gold_df = gold_df.rename(\n",
        "    columns={\n",
        "        \"scenario_id\":\n",
        "            \"gold_scenario_id\",\n",
        "\n",
        "        \"schema_path\":\n",
        "            \"gold_schema_path\",\n",
        "\n",
        "        \"schema_variant\":\n",
        "            \"gold_schema_variant\",\n",
        "\n",
        "        \"evidence_strength\":\n",
        "            \"gold_evidence_strength\",\n",
        "    }\n",
        ")\n",
        "\n",
        "\n",
        "review_df = (\n",
        "    results_df.merge(\n",
        "        gold_df,\n",
        "        on=\"experiment_id\",\n",
        "        how=\"left\",\n",
        "        validate=\"one_to_one\",\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "assert len(\n",
        "    review_df\n",
        ") == 192\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 7. Verify metadata still matches 192/192\n",
        "# ============================================================\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"scenario_id\"\n",
        "    ].astype(str)\n",
        "    ==\n",
        "    review_df[\n",
        "        \"gold_scenario_id\"\n",
        "    ].astype(str)\n",
        ").all()\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"schema_path\"\n",
        "    ].astype(str)\n",
        "    ==\n",
        "    review_df[\n",
        "        \"gold_schema_path\"\n",
        "    ].astype(str)\n",
        ").all()\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"schema_variant\"\n",
        "    ].astype(str)\n",
        "    ==\n",
        "    review_df[\n",
        "        \"gold_schema_variant\"\n",
        "    ].astype(str)\n",
        ").all()\n",
        "\n",
        "\n",
        "assert (\n",
        "    review_df[\n",
        "        \"evidence_strength\"\n",
        "    ].astype(str)\n",
        "    ==\n",
        "    review_df[\n",
        "        \"gold_evidence_strength\"\n",
        "    ].astype(str)\n",
        ").all()\n",
        "\n",
