        "            # Gemini structured-output JSON Schema\n",
        "            # does not support uniqueItems.\n",
        "            # -----------------------------------------------\n",
        "            if key == \"uniqueItems\":\n",
        "                continue\n",
        "\n",
        "\n",
        "            # -----------------------------------------------\n",
        "            # Nullable enum:\n",
        "            #\n",
        "            # ORIGINAL:\n",
        "            # type = [\"string\", \"null\"]\n",
        "            # enum = [\"a\", \"b\", null]\n",
        "            #\n",
        "            # API COPY:\n",
        "            # type = [\"string\", \"null\"]\n",
        "            # enum = [\"a\", \"b\"]\n",
        "            #\n",
        "            # Nullability is retained by the type.\n",
