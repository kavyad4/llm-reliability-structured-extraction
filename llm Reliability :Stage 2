        "# STUDY 2A — CELL 8B\n",
        "# Fix pandas index-name mismatch + save final dataset\n",
        "# ============================================================\n",
        "\n",
        "import pandas as pd\n",
        "import json\n",
        "\n",
        "print(\"=\" * 100)\n",
        "print(\"CELL 8B — VALIDATE + SAVE FINAL LOCALIZATION\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Rebuild observed category totals\n",
        "# ------------------------------------------------------------\n",
        "observed = (\n",
        "    final_loc_df\n",
        "    .groupby(\n",
        "        [\n",
        "            \"condition\",\n",
        "            \"error_category\",\n",
        "        ]\n",
        "    )\n",
        "    .size()\n",
        "    .unstack(fill_value=0)\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Expected Study 1 totals\n",
        "# ------------------------------------------------------------\n",
        "expected = pd.DataFrame(\n",
        "    {\n",
        "        \"field_mis_mapping\": {\n",
        "            \"baseline\": 2,\n",
        "            \"schema_constrained\": 1,\n",
        "        },\n",
        "\n",
        "        \"omission\": {\n",
        "            \"baseline\": 26,\n",
        "            \"schema_constrained\": 15,\n",
        "        },\n",
        "\n",
        "        \"partial_extraction\": {\n",
        "            \"baseline\": 7,\n",
        "            \"schema_constrained\": 8,\n",
        "        },\n",
        "\n",
        "        \"status_certainty_error\": {\n",
        "            \"baseline\": 2,\n",
        "            \"schema_constrained\": 5,\n",
        "        },\n",
        "\n",
        "        \"unsupported_inference\": {\n",
        "            \"baseline\": 2,\n",
        "            \"schema_constrained\": 11,\n",
        "        },\n",
        "    }\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Align column order\n",
        "# ------------------------------------------------------------\n",
        "column_order = sorted(expected.columns)\n",
        "\n",
        "observed = observed[column_order]\n",
        "expected = expected[column_order]\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. FIX:\n",
        "# Make index metadata identical.\n",
        "#\n",
        "# The previous failure was ONLY because:\n",
        "# observed.index.name == \"condition\"\n",
        "# expected.index.name == None\n",
        "# ------------------------------------------------------------\n",
        "expected.index.name = observed.index.name\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. Validate values\n",
        "# ------------------------------------------------------------\n",
        "print(\"\\nObserved:\")\n",
        "display(observed)\n",
        "\n",
        "print(\"\\nExpected:\")\n",
        "display(expected)\n",
        "\n",
        "\n",
        "pd.testing.assert_frame_equal(\n",
        "    observed,\n",
        "    expected,\n",
        "    check_dtype=False,\n",
        "    check_names=True,\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"\\n✅ FINAL ROW-LEVEL CATEGORIES EXACTLY \"\n",
        "    \"REPRODUCE STUDY 1 TOTALS.\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. Additional safety checks\n",
        "# ------------------------------------------------------------\n",
        "assert len(final_loc_df) == 79\n",
        "\n",
        "assert (\n",
        "    final_loc_df[\"schema_path\"]\n",
        "    .notna()\n",
        "    .sum()\n",
        "    == 79\n",
        ")\n",
        "\n",
        "assert (\n",
        "    final_loc_df[\"error_category\"]\n",
        "    .notna()\n",
        "    .sum()\n",
        "    == 79\n",
        ")\n",
        "\n",
        "print(\"✅ 79/79 semantic errors present.\")\n",
        "print(\"✅ 79/79 primary fields localized.\")\n",
        "print(\"✅ 79/79 error categories present.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. Path-fit summary\n",
        "# ------------------------------------------------------------\n",
        "path_fit_summary = (\n",
        "    final_loc_df[\"path_fit\"]\n",
        "    .value_counts(dropna=False)\n",
        "    .rename_axis(\"path_fit\")\n",
        "    .reset_index(name=\"error_count\")\n",
        ")\n",
        "\n",
        "print(\"\\nPATH FIT SUMMARY:\")\n",
        "display(path_fit_summary)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. Mark final version\n",
        "# ------------------------------------------------------------\n",
        "final_loc_df[\n",
        "    \"localization_status\"\n",
        "] = \"field_localized\"\n",
        "\n",
        "final_loc_df[\n",
        "    \"localization_version\"\n",
        "] = \"study2a_v1\"\n",
        "\n",
        "final_loc_df[\n",
        "    \"localization_basis\"\n",
        "] = (\n",
        "    \"Study 1 adjudication note + \"\n",
        "    \"frozen-schema field localization\"\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. SAVE FINAL DATASET TO DRIVE\n",
        "# ------------------------------------------------------------\n",
        "FINAL_LOCALIZATION_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_error_localization_final_v1.csv\"\n",
        ")\n",
        "\n",
        "final_loc_df.to_csv(\n",
        "    FINAL_LOCALIZATION_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "FINAL_LOCALIZATION_JSON_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_error_localization_final_v1.json\"\n",
        ")\n",
        "\n",
        "with open(\n",
        "    FINAL_LOCALIZATION_JSON_PATH,\n",
        "    \"w\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        final_loc_df\n",
        "        .where(\n",
        "            pd.notnull(final_loc_df),\n",
        "            None\n",
        "        )\n",
        "        .to_dict(orient=\"records\"),\n",
        "        f,\n",
        "        indent=2,\n",
        "        ensure_ascii=False,\n",
        "        default=str,\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. Save schema-expressivity candidates\n",
        "# ------------------------------------------------------------\n",
        "schema_limit_candidates = final_loc_df[\n",
        "    final_loc_df[\n",
        "        \"path_fit\"\n",
        "    ].isin(\n",
        "        [\n",
        "            \"approximate\",\n",
        "            \"composite\",\n",
        "            \"schema_gap\",\n",
        "        ]\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "SCHEMA_LIMIT_PATH = (\n",
        "    STUDY2A_DATA_DIR\n",
        "    / \"study2a_schema_expressivity_candidates.csv\"\n",
        ")\n",
        "\n",
        "schema_limit_candidates.to_csv(\n",
        "    SCHEMA_LIMIT_PATH,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. Confirm files actually exist\n",
        "# ------------------------------------------------------------\n",
        "assert FINAL_LOCALIZATION_PATH.exists()\n",
        "assert FINAL_LOCALIZATION_JSON_PATH.exists()\n",
        "assert SCHEMA_LIMIT_PATH.exists()\n",
        "\n",
        "\n",
        "print(\"\\n\" + \"=\" * 100)\n",
        "print(\"CELL 8B COMPLETE\")\n",
        "print(\"=\" * 100)\n",
        "\n",
        "print(\n",
        "    \"\\nFinal localization CSV:\"\n",
        ")\n",
        "print(FINAL_LOCALIZATION_PATH)\n",
        "\n",
        "print(\n",
        "    \"\\nFinal localization JSON:\"\n",
        ")\n",
        "print(FINAL_LOCALIZATION_JSON_PATH)\n",
        "\n",
        "print(\n",
        "    \"\\nSchema-expressivity candidates:\"\n",
        ")\n",
        "print(SCHEMA_LIMIT_PATH)\n",
        "\n",
        "print(\n",
        "    \"\\n✅ FINAL STUDY 2A LOCALIZATION DATASET SAVED.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Runtime can disconnect now without losing Cell 8.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"✅ Study 1 remains untouched.\"\n",
        ")"
      ],
