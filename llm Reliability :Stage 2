        "# Save checkpoint AFTER EVERY experiment.\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"BEGINNING 8-GENERATION SMOKE TEST\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "for _, row in smoke_df.iterrows():\n",
        "\n",
        "    experiment_id = (\n",
        "        row[\"experiment_id\"]\n",
        "    )\n",
        "\n",
        "    run_order = int(\n",
        "        row[\"run_order\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    # Safe rerun behavior\n",
        "    if experiment_id in completed_ids:\n",
        "\n",
        "        print(\n",
        "            f\"\\n[{run_order}/192] \"\n",
        "            f\"{experiment_id} already checkpointed — SKIP\"\n",
        "        )\n",
        "\n",
        "        continue\n",
        "\n",
        "\n",
        "    print(\n",
        "        f\"\\n[{run_order}/192] \"\n",
        "        f\"{experiment_id}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \" Field:\",\n",
        "        row[\"schema_path\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \" Variant:\",\n",
        "        row[\"schema_variant\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \" Evidence:\",\n",
        "        row[\"evidence_strength\"]\n",
        "    )\n",
        "\n",
        "\n",
        "    result = run_one_experiment(\n",
        "        row\n",
        "    )\n",
        "\n",
        "\n",
        "    # Append once\n",
        "    checkpoint[\n",
        "        \"results\"\n",
        "    ].append(\n",
        "        result\n",
        "    )\n",
        "\n",
        "\n",
        "    # Recalculate counts\n",
        "    checkpoint[\n",
        "        \"completed_generations\"\n",
        "    ] = sum(\n",
        "        1\n",
        "        for r\n",
        "        in checkpoint[\n",
        "            \"results\"\n",
        "        ]\n",
        "        if r.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"completed\"\n",
        "    )\n",
        "\n",
        "\n",
        "    checkpoint[\n",
        "        \"failed_transport_generations\"\n",
        "    ] = sum(\n",
        "        1\n",
        "        for r\n",
        "        in checkpoint[\n",
        "            \"results\"\n",
        "        ]\n",
        "        if r.get(\n",
        "            \"generation_status\"\n",
        "        )\n",
        "        == \"transport_failure\"\n",
        "    )\n",
        "\n",
        "\n",
        "    save_checkpoint(\n",
        "        checkpoint\n",
        "    )\n",
        "\n",
        "\n",
        "    # Also update in-memory skip set\n",
        "    if result[\n",
        "        \"generation_status\"\n",
        "    ] in {\n",
        "        \"completed\",\n",
        "        \"permanent_api_failure\",\n",
        "    }:\n",
        "\n",
        "        completed_ids.add(\n",
        "            experiment_id\n",
        "        )\n",
        "\n",
        "\n",
        "    print(\n",
        "        \" Status:\",\n",
        "        result[\n",
        "            \"generation_status\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "\n",
        "    if result[\n",
        "        \"generation_status\"\n",
        "    ] == \"completed\":\n",
        "\n",
        "        print(\n",
        "            \" JSON valid:\",\n",
        "            result[\n",
        "                \"json_valid\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \" Schema valid:\",\n",
        "            result[\n",
        "                \"schema_valid\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            \" Schema errors:\",\n",
        "            result[\n",
        "                \"schema_error_count\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "    else:\n",
        "\n",
        "        print(\n",
        "            \" Error:\",\n",
        "            result[\n",
        "                \"generation_error\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 15. Reload checkpoint from disk\n",
        "# ============================================================\n",
        "\n",
        "with open(\n",
        "    GENERATION_CHECKPOINT_PATH,\n",
        "    \"r\",\n",
        "    encoding=\"utf-8\"\n",
        ") as f:\n",
        "\n",
        "    checkpoint_check = json.load(f)\n",
        "\n",
        "\n",
        "smoke_ids = set(\n",
        "    smoke_df[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "\n",
        "smoke_results = [\n",
        "\n",
        "    r\n",
        "    for r\n",
        "    in checkpoint_check[\n",
        "        \"results\"\n",
        "    ]\n",
        "\n",
        "    if r[\n",
        "        \"experiment_id\"\n",
        "    ]\n",
        "    in smoke_ids\n",
        "]\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 16. Build smoke-test summary\n",
        "# ============================================================\n",
        "\n",
        "smoke_results_df = pd.DataFrame(\n",
        "    smoke_results\n",
        ")\n",
        "\n",
        "\n",
        "if len(\n",
        "    smoke_results_df\n",
        ") > 0:\n",
        "\n",
        "    smoke_results_df = (\n",
        "        smoke_results_df\n",
        "        .sort_values(\n",
        "            \"run_order\"\n",
        "        )\n",
        "        .reset_index(\n",
        "            drop=True\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 110)\n",
        "print(\"SMOKE TEST RESULTS\")\n",
        "print(\"=\" * 110)\n",
        "\n",
        "\n",
        "display(\n",
        "    smoke_results_df[\n",
