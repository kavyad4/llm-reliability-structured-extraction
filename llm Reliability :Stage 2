        "\n",
        "\n",
        "# ============================================================\n",
        "# 10. Final error-category totals\n",
        "# ============================================================\n",
        "\n",
        "error_df = review_df[\n",
        "    review_df[\n",
        "        \"_correct_bool\"\n",
